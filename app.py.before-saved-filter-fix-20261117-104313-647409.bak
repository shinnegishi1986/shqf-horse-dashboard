# PRIZE_PERIODS_AND_INLINE_TOUCH_DETAILS_V1

def _mp_dates(year, month, period="Month"):
    from datetime import date

    year, month = int(year), int(month)

    # Validate the selected year/month.
    date(year, month, 1)

    if period == "Annual (calendar year)":
        return (
            date(year, 1, 1),
            date(year + 1, 1, 1),
        )

    spans = {
        "Month": 1,
        "3 months": 3,
        "6 months": 6,
    }

    if period not in spans:
        raise ValueError("Unknown comparison period.")

    index = year * 12 + month - 1

    first_year, first_month = divmod(
        index - spans[period] + 1,
        12,
    )

    next_year, next_month = divmod(
        index + 1,
        12,
    )

    return (
        date(first_year, first_month + 1, 1),
        date(next_year, next_month + 1, 1),
    )


def _mp_bounds(year, month, period="Month"):
    first, end = _mp_dates(
        year,
        month,
        period,
    )

    return first.isoformat(), end.isoformat()


# PRIZE_ANALYTICS_DARK_DESIGN_V1

def _mct_chart(chart_rows, stats, label, kind, year, month, *, period='Month'):
    import json
    from datetime import timedelta
    import streamlit.components.v1 as components
    first, end = _mp_dates(year, month, period)
    last = end - timedelta(days=1)
    entities = list(stats['entity_order'])
    if not entities:
        return
    payload = json.dumps({'rows': chart_rows, 'entities': entities, 'venues': list(stats['venue_order']), 'label': label, 'period': period, 'dates': f'{first.isoformat()} — {last.isoformat()}', 'total': stats['total'], 'valid': stats['valid'], 'missing': stats['missing'], 'invalid': stats['invalid'], 'invalid_dates': stats['invalid_dates']}, ensure_ascii=True, allow_nan=False)
    payload = payload.replace('<', '\\u003c').replace('>', '\\u003e').replace('&', '\\u0026')
    html = '<!doctype html>\n<html lang="en">\n<head>\n<meta charset="utf-8">\n<meta name="viewport" content="width=device-width,initial-scale=1">\n<meta name="color-scheme" content="dark">\n<style>\n:root{\n  color-scheme:dark;\n  --bg:#0b1120;--panel:#111b2e;--raised:#17243b;\n  --line:#27354d;--fg:#edf3ff;--muted:#9aacc7;\n  --accent:#8ba9ff;\n}\n*{box-sizing:border-box}\n[hidden]{display:none!important}\nhtml,body{\n  margin:0;background:var(--bg);color:var(--fg);\n  font-family:Inter,ui-sans-serif,system-ui,-apple-system,\n    BlinkMacSystemFont,"Segoe UI",sans-serif;\n  -webkit-text-size-adjust:100%;\n  font-variant-numeric:tabular-nums;\n}\nbody{\n  padding:18px 18px 28px;\n  -webkit-overflow-scrolling:touch;\n}\n.header{\n  display:flex;justify-content:space-between;\n  gap:12px;align-items:flex-start;margin-bottom:18px;\n}\n.eyebrow{\n  font-size:10px;letter-spacing:.16em;\n  font-weight:700;color:var(--accent);margin-bottom:6px;\n}\n.title{\n  font-size:22px;font-weight:650;letter-spacing:-.025em;\n}\n.subtitle{\n  font-size:12px;color:var(--muted);\n  margin-top:7px;line-height:1.5;\n}\nbutton,select{\n  font:inherit;color:inherit;\n  border:1px solid var(--line);\n  background:var(--panel);border-radius:9px;\n  min-height:44px;padding:8px 12px;\n  touch-action:manipulation;font-size:14px;\n}\nselect{font-size:16px}\nbutton{cursor:pointer}\nbutton:disabled{opacity:.35;cursor:default}\nbutton:hover:not(:disabled){\n  border-color:#55729e;background:var(--raised);\n}\nbutton:focus-visible,select:focus-visible{\n  outline:2px solid #a6baff;outline-offset:3px;\n}\n.metrics{\n  display:grid;grid-template-columns:repeat(4,minmax(0,1fr));\n  gap:10px;margin-bottom:20px;\n}\n.metric{\n  text-align:left;min-height:95px;padding:15px;\n  background:linear-gradient(145deg,#14213a,#101a2d);\n  border-radius:13px;\n}\n.metric-label{\n  display:block;font-size:11px;font-weight:500;\n  color:var(--muted);margin-bottom:11px;\n}\n.metric-value{\n  display:block;font-size:clamp(17px,2.4vw,25px);\n  font-weight:650;letter-spacing:-.03em;\n  overflow-wrap:anywhere;\n}\n.metric:first-child{border-color:#3a547e}\n.metric:first-child .metric-value{color:#bbccff}\n.chart-panel{\n  border:1px solid var(--line);border-radius:14px;\n  padding:14px;background:var(--panel);\n}\n.chart-heading{\n  display:flex;justify-content:space-between;\n  align-items:center;gap:12px;\n}\n.section-title{font-size:14px;font-weight:650}\n.micro{\n  font-size:11px;line-height:1.5;color:var(--muted);\n}\n.quality{\n  font-size:11px;color:#b8c7e3;\n  background:transparent;border:none;\n  min-height:36px;padding:4px 6px;\n}\n#legend{\n  display:flex;flex-wrap:wrap;\n  gap:8px 14px;margin:14px 0 8px;\n}\n.legend-item{\n  display:inline-flex;align-items:center;gap:6px;\n  color:#bdcbe0;font-size:11px;overflow-wrap:anywhere;\n}\n.swatch{\n  display:inline-block;width:8px;height:8px;\n  border-radius:3px;flex-shrink:0;\n}\n.toolbar{\n  display:flex;flex-wrap:wrap;align-items:center;\n  justify-content:space-between;gap:10px;\n  margin:12px 0 6px;padding-top:12px;\n  border-top:1px solid var(--line);\n}\n.navigation{\n  display:flex;align-items:center;gap:8px;\n}\n.navigation button{min-width:44px;padding:8px}\n.size-label{\n  display:flex;gap:8px;align-items:center;\n  color:var(--muted);font-size:11px;\n}\n.size-label select{min-width:70px}\n.footer{\n  margin-top:12px;border-top:1px solid var(--line);\n  padding-top:12px;\n}\n#axis{display:block;width:100%;height:28px}\n.bar-row{\n  padding:9px 0 11px;border-top:1px solid #1c2a40;\n}\n.row-head{\n  display:flex;align-items:center;\n  justify-content:space-between;gap:10px;\n}\n.name{\n  flex:1;display:flex;gap:10px;align-items:center;\n  text-align:left;min-width:0;border:none;\n  background:transparent;padding:0;min-height:44px;\n}\n.name:hover:not(:disabled){\n  background:transparent;border-color:transparent;\n}\n.rank{\n  font-size:11px;width:23px;\n  color:#7087a9;flex-shrink:0;\n}\n.entity-name{\n  font-size:13px;font-weight:550;overflow-wrap:anywhere;\n}\n.row-total{\n  text-align:right;font-size:13px;font-weight:650;\n  max-width:45%;overflow-wrap:anywhere;\n}\n.bar{\n  display:block;width:100%;height:34px;touch-action:pan-y;\n}\n.segment{cursor:pointer}\n.segment:focus{\n  outline:none;stroke:#e9f1ff;stroke-width:2;\n}\n#tip{\n  position:absolute;z-index:30;width:390px;\n  max-width:calc(100% - 24px);max-height:65vh;\n  overflow:auto;-webkit-overflow-scrolling:touch;\n  background:#19263d;color:#edf3ff;\n  border:1px solid #48638b;border-radius:13px;\n  padding:15px;box-shadow:0 16px 50px #0009;\n  font-size:12px;line-height:1.6;overflow-wrap:anywhere;\n}\n#tip strong{\n  display:block;font-size:14px;margin:0 52px 4px 0;\n}\n.close{\n  float:right;min-height:36px;\n  padding:4px 8px;font-size:11px;\n}\n.tip-rule{\n  border-top:1px solid #344864;margin:10px 0;\n}\n.tip-line{\n  display:flex;justify-content:space-between;\n  gap:15px;margin:3px 0;\n}\n.tip-line span:first-child{color:#aabbd6}\n.tip-line span:last-child{\n  text-align:right;font-weight:600;\n}\n.breakdown{\n  width:100%;border-collapse:collapse;\n  margin-top:9px;font-size:11px;\n}\n.breakdown th{\n  text-align:left;color:#aabbd6;font-weight:500;\n  padding:6px 4px;border-bottom:1px solid #344864;\n}\n.breakdown td{\n  padding:6px 4px;border-bottom:1px solid #293b55;\n}\n.breakdown th:not(:first-child),\n.breakdown td:not(:first-child){text-align:right}\n.note{\n  color:#aabbd6;font-size:11px;margin-top:10px;\n}\n@media(max-width:650px){\n  body{padding:12px}\n  .metrics{\n    grid-template-columns:repeat(2,minmax(0,1fr));gap:8px;\n  }\n  .metric{min-height:85px;padding:12px}\n  .title{font-size:19px}\n  .chart-panel{padding:10px}\n  .metric-value{font-size:21px}\n  .header{margin-bottom:14px}\n}\n@media(prefers-reduced-motion:reduce){\n  *{scroll-behavior:auto!important}\n}\n</style>\n</head>\n<body>\n<header class="header">\n  <div>\n    <div class="eyebrow">PRIZE ANALYTICS</div>\n    <div id="title" class="title"></div>\n    <div id="subtitle" class="subtitle"></div>\n  </div>\n  <button\n    id="about"\n    type="button"\n    aria-label="About these totals">\n    About totals\n  </button>\n</header>\n\n<div class="metrics">\n  <button type="button" class="metric" id="kpiTotal">\n    <span class="metric-label">Recorded prize</span>\n    <span class="metric-value" id="total"></span>\n  </button>\n  <button type="button" class="metric" id="kpiRecords">\n    <span class="metric-label">Valid-prize checklists</span>\n    <span class="metric-value" id="records"></span>\n  </button>\n  <button type="button" class="metric" id="kpiNames">\n    <span class="metric-label" id="namesLabel"></span>\n    <span class="metric-value" id="names"></span>\n  </button>\n  <button type="button" class="metric" id="kpiVenues">\n    <span class="metric-label">Venues</span>\n    <span class="metric-value" id="venues"></span>\n  </button>\n</div>\n\n<section class="chart-panel">\n  <div class="chart-heading">\n    <div>\n      <div class="section-title">Prize by venue</div>\n      <div class="micro">\n        Ranked by total prize. Tap a segment for details;\n        tap a name for every venue.\n      </div>\n    </div>\n    <button\n      id="quality"\n      class="quality"\n      type="button">\n    </button>\n  </div>\n\n  <div id="legend"></div>\n\n  <div class="toolbar">\n    <div class="navigation">\n      <button\n        id="previous"\n        type="button"\n        aria-label="Previous chart view">\n        Previous\n      </button>\n      <span id="page" class="micro"></span>\n      <button\n        id="next"\n        type="button"\n        aria-label="Next chart view">\n        Next\n      </button>\n    </div>\n    <label class="size-label" for="pageSize">\n      Bars per view\n      <select id="pageSize">\n        <option>8</option>\n        <option>12</option>\n        <option>20</option>\n        <option selected>50</option>\n        <option>100</option>\n      </select>\n    </label>\n  </div>\n\n  <svg id="axis" aria-label="Recorded prize scale"></svg>\n  <div id="rows"></div>\n\n  <div class="toolbar footer">\n    <span id="range" class="micro"></span>\n    <div class="navigation">\n      <button id="previousBottom" type="button">Previous</button>\n      <button id="nextBottom" type="button">Next</button>\n    </div>\n  </div>\n</section>\n\n<div\n  id="tip"\n  role="dialog"\n  aria-label="Prize details"\n  hidden>\n</div>\n\n<script>\n"use strict";\n\nconst data=__MPD_DATA__;\nconst byId=id=>document.getElementById(id);\nconst ns="http://www.w3.org/2000/svg";\nconst tip=byId("tip");\n\nconst colors=[\n  "#88a8ff","#55d4c4","#f0bb72","#bd9bff","#f08fa8",\n  "#70bbeb","#b6d87c","#de9be2","#ed9c72","#a1b8d4",\n  "#6798e8","#39b4a6","#d5a35d","#9874dd","#ce718d",\n  "#5499c5","#92b15e","#bb79bd","#c97e53","#7b95b5"\n];\n\nconst color=index=>index<colors.length\n  ?colors[index]\n  :"hsl("+((index*137.508)%360)+",65%,65%)";\n\nconst number=value=>new Intl.NumberFormat(\n  undefined,\n  {maximumFractionDigits:20}\n).format(value);\n\nconst money=value=>"JPY "+number(value);\nconst percent=value=>(value*100).toFixed(1)+"%";\n\nconst matrix=new Map();\nconst totals=new Map();\n\ndata.entities.forEach(name=>{\n  matrix.set(name,new Map());\n  totals.set(name,0);\n});\n\ndata.rows.forEach(row=>{\n  if(matrix.has(row.entity)){\n    matrix.get(row.entity).set(row.venue,row);\n    totals.set(row.entity,row.entity_total);\n  }\n});\n\nconst maximum=Math.max(\n  1,\n  data.entities.reduce(\n    (current,name)=>Math.max(\n      current,\n      totals.get(name)||0\n    ),\n    0\n  )\n);\n\nlet page=0;\nlet pageSize=50;\nlet entries=new Map();\nlet active=null;\nlet pinned=false;\nlet hideTimer=null;\n\nbyId("title").textContent=\n  data.label+" prize comparison";\n\nbyId("subtitle").textContent=\n  data.period+"  /  "+data.dates;\n\nbyId("total").textContent=money(data.total);\nbyId("records").textContent=number(data.valid);\n\nbyId("namesLabel").textContent=\n  "Selected "+\n  (\n    data.label==="Horse Owner"\n      ?"horse owners"\n      :data.label.toLowerCase()+"s"\n  );\n\nbyId("names").textContent=\n  number(data.entities.length);\n\nbyId("venues").textContent=\n  number(data.venues.length);\n\nconst excluded=\n  data.missing+data.invalid+data.invalid_dates;\n\nbyId("quality").textContent=excluded\n  ?number(excluded)+" excluded records"\n  :"Recorded data";\n\ndata.venues.forEach((name,index)=>{\n  const item=document.createElement("span");\n  const swatch=document.createElement("span");\n  const label=document.createElement("span");\n\n  item.className="legend-item";\n  swatch.className="swatch";\n  swatch.style.background=color(index);\n  label.textContent=name;\n\n  item.append(swatch,label);\n  byId("legend").appendChild(item);\n});\n\nfunction text(parent,tag,value,className){\n  const item=document.createElement(tag);\n  item.textContent=value;\n\n  if(className){\n    item.className=className;\n  }\n\n  parent.appendChild(item);\n  return item;\n}\n\nfunction line(key,value){\n  const row=document.createElement("div");\n  row.className="tip-line";\n\n  text(row,"span",key);\n  text(row,"span",value);\n  tip.appendChild(row);\n}\n\nfunction rule(){\n  const item=document.createElement("div");\n  item.className="tip-rule";\n  tip.appendChild(item);\n}\n\nfunction resetTip(){\n  tip.replaceChildren();\n\n  const close=text(\n    tip,\n    "button",\n    "Close",\n    "close"\n  );\n\n  close.type="button";\n  close.addEventListener("click",hide);\n}\n\nfunction highlight(){\n  entries.forEach((entry,entityIndex)=>{\n    entry.segments.forEach((rect,venueIndex)=>{\n      rect.setAttribute(\n        "stroke",\n        active&&\n        active.type==="bar"&&\n        active.ei===entityIndex&&\n        active.vi===venueIndex\n          ?"#edf3ff"\n          :"none"\n      );\n    });\n  });\n}\n\nfunction hide(){\n  clearTimeout(hideTimer);\n  tip.hidden=true;\n  active=null;\n  pinned=false;\n  document.body.style.paddingBottom="28px";\n  highlight();\n}\n\nfunction anchor(){\n  if(!active){\n    return null;\n  }\n\n  if(active.type==="bar"){\n    return (\n      entries.get(active.ei)||{}\n    ).svg;\n  }\n\n  return byId(active.id);\n}\n\nfunction place(scroll){\n  const item=anchor();\n\n  if(!item){\n    return;\n  }\n\n  tip.hidden=false;\n\n  const box=item.getBoundingClientRect();\n  const width=tip.offsetWidth;\n\n  tip.style.left=Math.max(\n    12,\n    Math.min(\n      box.left+window.scrollX,\n      window.innerWidth-width-12\n    )\n  )+"px";\n\n  // Bar details stay below the selected bar.\n  tip.style.top=(\n    box.bottom+window.scrollY+8\n  )+"px";\n\n  document.body.style.paddingBottom=(\n    tip.offsetHeight+30\n  )+"px";\n\n  if(scroll){\n    const rect=tip.getBoundingClientRect();\n\n    if(\n      rect.bottom>window.innerHeight||\n      rect.top<0\n    ){\n      tip.scrollIntoView({\n        block:"nearest",\n        behavior:window.matchMedia(\n          "(prefers-reduced-motion: reduce)"\n        ).matches\n          ?"auto"\n          :"smooth"\n      });\n    }\n  }\n}\n\nfunction about(id,pin){\n  clearTimeout(hideTimer);\n  active={type:"about",id:id};\n  pinned=pin;\n\n  resetTip();\n\n  text(\n    tip,\n    "strong",\n    "About the recorded totals"\n  );\n\n  text(tip,"div",data.dates,"micro");\n  rule();\n\n  line("Recorded prize",money(data.total));\n  line("Valid-prize checklists",number(data.valid));\n  line("Missing prize",number(data.missing));\n  line("Invalid prize",number(data.invalid));\n  line("Invalid race date",number(data.invalid_dates));\n\n  text(\n    tip,\n    "div",\n    "Uses your saved checklist prizes and race dates, "+\n    "across all finishing places. Review filters do not apply. "+\n    "Zero prizes are valid; missing, negative and non-finite "+\n    "prizes are excluded. These totals are not calculated "+\n    "jockey fees, trainer fees or ownership payout shares. "+\n    "Missing reference names are not selectable. "+\n    "A calendar-year period includes January–December; "+\n    "rolling periods end in the selected month.",\n    "note"\n  );\n\n  highlight();\n  place(pin);\n}\n\nfunction barDetails(entityIndex,venueIndex,pin){\n  clearTimeout(hideTimer);\n\n  const entry=entries.get(entityIndex);\n\n  if(!entry){\n    return;\n  }\n\n  const name=data.entities[entityIndex];\n  const total=totals.get(name)||0;\n\n  const row=venueIndex===null\n    ?null\n    :matrix.get(name).get(data.venues[venueIndex]);\n\n  active={\n    type:"bar",\n    ei:entityIndex,\n    vi:venueIndex\n  };\n\n  pinned=pin;\n  resetTip();\n\n  text(tip,"strong",name);\n  text(tip,"div",data.dates,"micro");\n  rule();\n\n  if(venueIndex!==null){\n    line("Venue",data.venues[venueIndex]);\n    line("Venue prize",money(row?row.prize:0));\n\n    line(\n      "Share of participant total",\n      percent(\n        total>0\n          ?(row?row.prize:0)/total\n          :0\n      )\n    );\n\n    line(\n      "Valid-prize checklists",\n      number(row?row.checklists:0)\n    );\n\n    rule();\n  }\n\n  line("Participant total",money(total));\n\n  line(\n    "Share of comparison total",\n    percent(\n      data.total>0\n        ?total/data.total\n        :0\n    )\n  );\n\n  if(venueIndex===null){\n    line(\n      "Valid-prize checklists",\n      number(\n        Array.from(\n          matrix.get(name).values()\n        ).reduce(\n          (sum,item)=>sum+item.checklists,\n          0\n        )\n      )\n    );\n\n    if(data.venues.length){\n      const table=document.createElement("table");\n      table.className="breakdown";\n\n      const head=document.createElement("tr");\n\n      ["Venue","Prize (JPY)","Records"].forEach(value=>{\n        text(head,"th",value);\n      });\n\n      table.appendChild(head);\n\n      data.venues.forEach(venue=>{\n        const record=matrix.get(name).get(venue);\n        const tableRow=document.createElement("tr");\n\n        text(tableRow,"td",venue);\n\n        text(\n          tableRow,\n          "td",\n          number(record?record.prize:0)\n        );\n\n        text(\n          tableRow,\n          "td",\n          number(record?record.checklists:0)\n        );\n\n        table.appendChild(tableRow);\n      });\n\n      tip.appendChild(table);\n\n    }else{\n      text(\n        tip,\n        "div",\n        "No valid prize values were recorded for this selection.",\n        "note"\n      );\n    }\n  }\n\n  highlight();\n  place(pin);\n}\n\nfunction laterHide(){\n  if(!pinned){\n    clearTimeout(hideTimer);\n    hideTimer=setTimeout(hide,180);\n  }\n}\n\nfunction svgElement(svg,tag,attributes,value){\n  const node=document.createElementNS(ns,tag);\n\n  Object.entries(attributes).forEach(([key,item])=>{\n    node.setAttribute(key,String(item));\n  });\n\n  if(value!==undefined){\n    node.textContent=value;\n  }\n\n  svg.appendChild(node);\n  return node;\n}\n\nfunction bindSegment(node,entityIndex,venueIndex){\n  node.setAttribute("tabindex","0");\n  node.setAttribute("role","button");\n  node.classList.add("segment");\n\n  node.setAttribute(\n    "aria-label",\n    data.entities[entityIndex]+", "+\n    (\n      venueIndex===null\n        ?"all venues"\n        :data.venues[venueIndex]\n    )+", show prize details"\n  );\n\n  node.addEventListener("click",()=>{\n    barDetails(entityIndex,venueIndex,true);\n  });\n\n  node.addEventListener("keydown",event=>{\n    if(\n      event.key==="Enter"||\n      event.key===" "\n    ){\n      event.preventDefault();\n      barDetails(entityIndex,venueIndex,true);\n    }\n  });\n\n  node.addEventListener("pointerenter",event=>{\n    if(\n      event.pointerType==="mouse"&&\n      !pinned\n    ){\n      barDetails(entityIndex,venueIndex,false);\n    }\n  });\n\n  node.addEventListener("pointerleave",laterHide);\n\n  node.addEventListener("focus",()=>{\n    if(!pinned){\n      barDetails(entityIndex,venueIndex,false);\n    }\n  });\n\n  node.addEventListener("blur",laterHide);\n}\n\nfunction paint(){\n  const axis=byId("axis");\n  const width=Math.max(\n    240,\n    axis.clientWidth||700\n  );\n\n  axis.replaceChildren();\n  axis.setAttribute(\n    "viewBox",\n    "0 0 "+width+" 28"\n  );\n\n  [0,maximum/2,maximum].forEach((value,index)=>{\n    svgElement(\n      axis,\n      "text",\n      {\n        x:(value/maximum)*width,\n        y:19,\n        fill:"#8398b8",\n        "font-size":10,\n        "text-anchor":index===0\n          ?"start"\n          :index===2\n            ?"end"\n            :"middle"\n      },\n      new Intl.NumberFormat(\n        undefined,\n        {\n          notation:"compact",\n          maximumFractionDigits:1\n        }\n      ).format(value)\n    );\n  });\n\n  entries.forEach((entry,entityIndex)=>{\n    entry.svg.replaceChildren();\n    entry.segments=new Map();\n\n    const width=Math.max(\n      240,\n      entry.svg.clientWidth||700\n    );\n\n    entry.svg.setAttribute(\n      "viewBox",\n      "0 0 "+width+" 34"\n    );\n\n    const hit=svgElement(\n      entry.svg,\n      "rect",\n      {\n        x:0,\n        y:0,\n        width:width,\n        height:34,\n        rx:5,\n        fill:"#0c1526"\n      }\n    );\n\n    bindSegment(\n      hit,\n      entityIndex,\n      null\n    );\n\n    let offset=0;\n    const name=data.entities[entityIndex];\n\n    data.venues.forEach((venue,venueIndex)=>{\n      const row=matrix.get(name).get(venue);\n      const value=row?row.prize:0;\n\n      if(value>0){\n        const rect=svgElement(\n          entry.svg,\n          "rect",\n          {\n            x:(offset/maximum)*width,\n            y:3,\n            width:(value/maximum)*width,\n            height:28,\n            fill:color(venueIndex),\n            stroke:"none",\n            "stroke-width":2\n          }\n        );\n\n        entry.segments.set(\n          venueIndex,\n          rect\n        );\n\n        bindSegment(\n          rect,\n          entityIndex,\n          venueIndex\n        );\n      }\n\n      offset+=value;\n    });\n  });\n\n  highlight();\n\n  if(active&&!tip.hidden){\n    place(false);\n  }\n}\n\nfunction render(){\n  byId("rows").replaceChildren();\n  entries=new Map();\n\n  const start=page*pageSize;\n\n  const end=Math.min(\n    data.entities.length,\n    start+pageSize\n  );\n\n  for(\n    let entityIndex=start;\n    entityIndex<end;\n    entityIndex++\n  ){\n    const row=document.createElement("section");\n    const head=document.createElement("div");\n    const name=document.createElement("button");\n    const total=document.createElement("span");\n    const svg=document.createElementNS(ns,"svg");\n\n    row.className="bar-row";\n    head.className="row-head";\n\n    name.type="button";\n    name.className="name";\n\n    text(\n      name,\n      "span",\n      String(entityIndex+1).padStart(2,"0"),\n      "rank"\n    );\n\n    text(\n      name,\n      "span",\n      data.entities[entityIndex],\n      "entity-name"\n    );\n\n    name.addEventListener("click",()=>{\n      barDetails(entityIndex,null,true);\n    });\n\n    total.className="row-total";\n    total.textContent=money(\n      totals.get(data.entities[entityIndex])||0\n    );\n\n    head.append(name,total);\n\n    svg.classList.add("bar");\n    svg.setAttribute("role","group");\n\n    svg.setAttribute(\n      "aria-label",\n      data.entities[entityIndex]+" prize by venue"\n    );\n\n    row.append(head,svg);\n    byId("rows").appendChild(row);\n\n    entries.set(\n      entityIndex,\n      {\n        svg:svg,\n        segments:new Map()\n      }\n    );\n  }\n\n  const pages=Math.max(\n    1,\n    Math.ceil(data.entities.length/pageSize)\n  );\n\n  byId("page").textContent=\n    (page+1)+" / "+pages;\n\n  byId("range").textContent=\n    "Showing "+(start+1)+"–"+end+\n    " of "+data.entities.length+\n    "  ·  Same prize scale across views";\n\n  ["previous","previousBottom"].forEach(id=>{\n    byId(id).disabled=page===0;\n  });\n\n  ["next","nextBottom"].forEach(id=>{\n    byId(id).disabled=page>=pages-1;\n  });\n\n  paint();\n}\n\nfunction move(amount){\n  hide();\n\n  page=Math.max(\n    0,\n    Math.min(\n      Math.ceil(data.entities.length/pageSize)-1,\n      page+amount\n    )\n  );\n\n  render();\n  window.scrollTo({top:0});\n}\n\n["previous","previousBottom"].forEach(id=>{\n  byId(id).addEventListener("click",()=>{\n    move(-1);\n  });\n});\n\n["next","nextBottom"].forEach(id=>{\n  byId(id).addEventListener("click",()=>{\n    move(1);\n  });\n});\n\nbyId("pageSize").addEventListener("change",event=>{\n  hide();\n  pageSize=Number(event.target.value);\n  page=0;\n  render();\n});\n\n[\n  "about",\n  "quality",\n  "kpiTotal",\n  "kpiRecords",\n  "kpiNames",\n  "kpiVenues"\n].forEach(id=>{\n  const item=byId(id);\n\n  item.addEventListener("click",()=>{\n    about(id,true);\n  });\n\n  item.addEventListener("pointerenter",event=>{\n    if(\n      event.pointerType==="mouse"&&\n      !pinned\n    ){\n      about(id,false);\n    }\n  });\n\n  item.addEventListener(\n    "pointerleave",\n    laterHide\n  );\n});\n\ntip.addEventListener("pointerenter",()=>{\n  clearTimeout(hideTimer);\n});\n\ntip.addEventListener(\n  "pointerleave",\n  laterHide\n);\n\ndocument.addEventListener("pointerdown",event=>{\n  if(\n    !tip.hidden&&\n    !tip.contains(event.target)&&\n    !event.target.closest(\n      ".bar-row,.metric,#about,#quality"\n    )\n  ){\n    hide();\n  }\n});\n\ndocument.addEventListener("keydown",event=>{\n  if(event.key==="Escape"){\n    hide();\n  }\n});\n\nlet resizeTimer;\n\nwindow.addEventListener("resize",()=>{\n  clearTimeout(resizeTimer);\n  resizeTimer=setTimeout(paint,100);\n});\n\nrender();\n</script>\n</body>\n</html>'
    components.html(html.replace('__MPD_DATA__', payload, 1), height=880, scrolling=True)



def _rtn_require_native():
    import inspect

    try:
        supported = (
            "accept_new_options"
            in inspect.signature(st.selectbox).parameters
        )
    except (TypeError, ValueError):
        supported = False

    if not supported:
        st.error(
            "Race-name entry requires a Streamlit version "
            "supporting selectbox accept_new_options. "
            "Upgrade and restart: "
            "python -m pip install --upgrade streamlit"
        )
        st.stop()


def _rtn_input(owner_id, key, current_id=None):
    rows = get_user_race_names(owner_id)

    options = [None]

    for row in rows:
        name = str(row["race_name"]).strip()

        if name and name not in options:
            options.append(name)

    current = next(
        (
            str(row["race_name"]).strip()
            for row in rows
            if row["id"] == current_id
        ),
        None,
    )

    if current not in options:
        current = None

    selected = st.selectbox(
        "Race name",
        options,
        index=(
            None
            if key in st.session_state
            else options.index(current)
        ),
        format_func=lambda value: (
            "(Select or type a race name)"
            if value is None
            else value
        ),
        key=key,
        accept_new_options=True,
        placeholder=(
            "Select a saved race name or type a new one"
        ),
        help=(
            "Select a suggestion, or type a new name "
            "and press Enter. New race names are registered "
            "when the template is successfully saved."
        ),
    )

    if selected is None or not str(selected).strip():
        return None, ""

    name = str(selected).strip()

    exact = [
        row
        for row in rows
        if str(row["race_name"]).strip() == name
    ]

    matches = exact or [
        row
        for row in rows
        if str(row["race_name"]).strip().casefold()
        == name.casefold()
    ]

    if matches:
        row = next(
            (
                row
                for row in matches
                if row["id"] == current_id
            ),
            matches[0],
        )

        return row["id"], ""

    # Existing save/update functions register this new name
    # inside their database transaction.
    return None, name

def _mc_config(kind):
    options = {'jockey': ('jockey_id', 'jockey_name', 'Jockey', 'Jockeys', get_user_jockeys), 'owner': ('horse_owner_id', 'horse_owner_name', 'Horse Owner', 'Horse Owners', get_user_horse_owners), 'trainer': ('trainer_id', 'trainer_name', 'Trainer', 'Trainers', get_user_trainers)}
    if kind not in options:
        raise ValueError('Unknown monthly comparison type.')
    return options[kind]



def _mc_bounds(year, month):
    from datetime import date

    start = date(int(year), int(month), 1)

    if start.month == 12:
        end = date(start.year + 1, 1, 1)
    else:
        end = date(start.year, start.month + 1, 1)

    return start.isoformat(), end.isoformat()


def _mc_fetch(owner_id, kind, year, month, *, period='Month'):
    column = _mc_config(kind)[0]
    start, end = _mp_bounds(year, month, period)
    conn = get_db_connection()
    try:
        return [dict(row) for row in conn.execute(f'SELECT c.id,c.date_of_race,c.{column} AS entity_id,c.venue_id,v.venue_name,c.prize FROM checklists c LEFT JOIN venues v ON v.id=c.venue_id AND v.owner_id=c.owner_id WHERE c.owner_id=? AND c.date_of_race>=? AND c.date_of_race<?', (owner_id, start, end)).fetchall()]
    finally:
        conn.close()



def _mc_names(rows, column):
    from collections import Counter

    names = {
        row["id"]: str(row.get(column) or "(Unnamed)")
        for row in rows
    }

    counts = Counter(names.values())

    return {
        item_id: (
            name
            if counts[name] == 1
            else f"{name} (#{item_id})"
        )
        for item_id, name in names.items()
    }


def _mc_prepare(rows, names, selected, year, month, label, *, period='Month'):
    _mp_range_start, _mp_range_end = _mp_dates(year, month, period)
    import math
    from datetime import date
    from collections import Counter, defaultdict
    selected = list(dict.fromkeys((item_id for item_id in selected if item_id in names)))
    selected_set = set(selected)
    groups = defaultdict(list)
    venues = {}
    valid_counts = Counter()
    missing_counts = Counter()
    invalid_counts = Counter()
    invalid_dates = 0
    for row in rows:
        entity_id = row['entity_id']
        if entity_id not in selected_set:
            continue
        try:
            race_date = date.fromisoformat(str(row['date_of_race'])[:10])
        except (ValueError, TypeError):
            invalid_dates += 1
            continue
        if not _mp_range_start <= race_date < _mp_range_end:
            continue
        raw = row.get('prize')
        if raw is None or (isinstance(raw, str) and (not raw.strip())):
            missing_counts[entity_id] += 1
            continue
        try:
            prize = float(raw)
            if not math.isfinite(prize) or prize < 0:
                raise ValueError()
        except (ValueError, TypeError, OverflowError):
            invalid_counts[entity_id] += 1
            continue
        venue_id = row.get('venue_id')
        venues[venue_id] = str(row.get('venue_name') or ('(No venue recorded)' if venue_id is None else '(Unavailable venue)'))
        groups[entity_id, venue_id].append(prize)
        valid_counts[entity_id] += 1
    duplicates = Counter(venues.values())
    venue_names = {venue_id: name if duplicates[name] == 1 else f'{name} (#{venue_id})' for venue_id, name in venues.items()}
    venue_order = sorted(venues, key=lambda value: (venue_names[value].casefold(), str(value)))
    try:
        sums = {key: math.fsum(values) for key, values in groups.items()}
        totals = {entity_id: math.fsum((sums.get((entity_id, venue), 0.0) for venue in venue_order)) for entity_id in selected}
        total = math.fsum(totals.values())
    except OverflowError:
        raise ValueError('Prize totals overflowed. Check the recorded prize values.')
    if not all((math.isfinite(value) for value in list(sums.values()) + list(totals.values()) + [total])):
        raise ValueError('A prize total is not finite. Check the recorded prize values.')
    ordered = sorted(selected, key=lambda value: (-totals[value], names[value].casefold(), value))
    chart_rows = []
    table_rows = []
    for entity_id in ordered:
        record = {label + ' ID': entity_id, label: names[entity_id], 'Total Prize (JPY)': totals[entity_id], 'Checklists with valid prize': valid_counts[entity_id], 'Missing prize': missing_counts[entity_id], 'Invalid prize': invalid_counts[entity_id]}
        for rank, venue in enumerate(venue_order):
            prize = sums.get((entity_id, venue), 0.0)
            record['Venue: ' + venue_names[venue]] = prize
            chart_rows.append({'entity': names[entity_id], 'venue': venue_names[venue], 'prize': prize, 'entity_total': totals[entity_id], 'checklists': len(groups.get((entity_id, venue), [])), 'venue_order': rank})
        table_rows.append(record)
    return (chart_rows, table_rows, {'total': total, 'valid': sum(valid_counts.values()), 'missing': sum(missing_counts.values()), 'invalid': sum(invalid_counts.values()), 'invalid_dates': invalid_dates, 'venues': len(venues), 'entity_order': [names[item_id] for item_id in ordered], 'venue_order': [venue_names[venue] for venue in venue_order]})



def _mc_set_selected(key, values):
    st.session_state[key] = list(values)


def _mc_page(kind):
    import calendar
    import pandas as pd
    from datetime import datetime, timedelta, timezone
    owner_id = st.session_state.user_id
    column, name_column, label, plural, getter = _mc_config(kind)
    today = datetime.now(timezone(timedelta(hours=9))).date()
    prefix = f'mc_{kind}_{owner_id}'
    st.header(f'Prize Comparison by {label}')
    first, second = st.columns(2)
    with first:
        year = int(st.number_input('Year', min_value=1980, max_value=2100, value=today.year, step=1, key=prefix + '_year'))
    with second:
        month = st.selectbox('Month', list(range(1, 13)), index=today.month - 1, format_func=lambda value: f'{value:02d} — {calendar.month_name[value]}', key=prefix + '_month')
    from datetime import timedelta
    period = st.radio('Data period', ['Month', '3 months', '6 months', 'Annual (calendar year)'], horizontal=True, key=prefix + '_period')
    range_start, range_end = _mp_dates(year, month, period)
    range_last = range_end - timedelta(days=1)
    names = _mc_names(getter(owner_id), name_column)
    if not names:
        st.info(f'Register {plural.lower()} or save checklist references first.')
        return
    rows = _mc_fetch(owner_id, kind, year, month, period=period)
    options = sorted(names, key=lambda value: (names[value].casefold(), value))
    present = {row['entity_id'] for row in rows}
    initial = [item_id for item_id in options if item_id in present]
    selection_key = f'{prefix}_selected_{range_start.isoformat()}_{range_end.isoformat()}'
    if selection_key in st.session_state:
        st.session_state[selection_key] = [item_id for item_id in st.session_state[selection_key] if item_id in names]
    all_column, clear_column = st.columns(2)
    with all_column:
        st.button('Select all registered ' + plural.lower(), key=prefix + '_all', on_click=_mc_set_selected, args=(selection_key, options))
    with clear_column:
        st.button('Clear selection', key=prefix + '_clear', on_click=_mc_set_selected, args=(selection_key, []))
    selected = st.multiselect('Compare ' + plural.lower(), options, default=None if selection_key in st.session_state else initial, format_func=lambda value: names[value], key=selection_key, help="Defaults to registered participants appearing in the selected period's checklist records. Select all registered to include names with no records. An empty selection shows no comparison.")
    if not selected:
        st.info(f'Select one or more {plural.lower()} to compare.')
        return
    try:
        chart_rows, table_rows, stats = _mc_prepare(rows, names, selected, year, month, label, period=period)
    except ValueError as error:
        st.error(str(error))
        return
    _mct_chart(chart_rows, stats, label, kind, year, month, period=period)
    st.subheader(f'{period} — Prize Totals and Venue Breakdown')
    table = pd.DataFrame(table_rows)
    st.dataframe(table, hide_index=True, width='stretch')
    st.download_button('Download Comparison CSV', table.to_csv(index=False).encode('utf-8-sig'), file_name=f'prize_{kind}_{range_start.isoformat()}_to_{range_last.isoformat()}.csv', mime='text/csv', key=prefix + '_download')





def _crf_key(owner_id, entry_id, field):
    return f"crf_reference_{owner_id}_{entry_id}_{field}"


def _crf_require_native():
    import inspect

    try:
        supported = (
            "accept_new_options"
            in inspect.signature(st.selectbox).parameters
        )
    except (TypeError, ValueError):
        supported = False

    if not supported:
        st.error(
            "This editor requires a Streamlit version supporting "
            "selectbox accept_new_options. Upgrade Streamlit "
            "and restart: "
            "python -m pip install --upgrade streamlit"
        )
        st.stop()


def _crf_reference(
    label,
    owner_id,
    entry_id,
    field,
    labels,
    ids,
    current_id,
    return_id=False,
):
    options = [None]

    for item_id, name in zip(ids, labels):
        if item_id is not None:
            name = str(name).strip()

            if name and name not in options:
                options.append(name)

    current_name = next(
        (
            str(name).strip()
            for item_id, name in zip(ids, labels)
            if item_id == current_id
            and item_id is not None
        ),
        None,
    )

    if current_name not in options:
        current_name = None

    key = _crf_key(
        owner_id,
        entry_id,
        field,
    )

    selected = st.selectbox(
        label,
        options=options,
        index=(
            None
            if key in st.session_state
            else options.index(current_name)
        ),
        format_func=lambda value: (
            "(No selection)"
            if value is None
            else value
        ),
        key=key,
        accept_new_options=True,
        placeholder=(
            "Select an existing name or type a new name"
        ),
        help=(
            "Select a suggestion, or type a new name "
            "and press Enter. New names are registered "
            "only when Update Checklist succeeds."
        ),
    )

    if selected is None or not str(selected).strip():
        return (
            None if return_id else 0
        ), ""

    name = str(selected).strip()

    exact = [
        (index, item_id)
        for index, (item_id, label_value)
        in enumerate(zip(ids, labels))
        if item_id is not None
        and str(label_value).strip() == name
    ]

    matching = exact or [
        (index, item_id)
        for index, (item_id, label_value)
        in enumerate(zip(ids, labels))
        if item_id is not None
        and str(label_value).strip().casefold()
        == name.casefold()
    ]

    if matching:
        # Preserve the current ID when duplicate display names exist.
        index, item_id = next(
            (
                pair
                for pair in matching
                if pair[1] == current_id
            ),
            matching[0],
        )

        return (
            item_id if return_id else index
        ), ""

    # A new name is passed to the existing transactional resolver.
    # No reference record is created while rendering the widget.
    return (
        None if return_id else 0
    ), name


def _crf_class(owner_id, entry):
    ids, labels = _rf_class_options(owner_id)

    return _crf_reference(
        "Race Class",
        owner_id,
        entry["id"],
        "race_class_id",
        labels,
        ids,
        entry.get("race_class_id"),
        return_id=True,
    )


def _crf_from_template(owner_id, entry_id, values):
    # The existing template callback supplies indexes.
    # Convert those to names for the new string-valued selectors.
    for widget, field, getter, name_column in (
        (
            "edit_race_idx",
            "race_name_id",
            get_user_race_names,
            "race_name",
        ),
        (
            "edit_venue_idx",
            "venue_id",
            get_user_venues,
            "venue_name",
        ),
    ):
        if widget in values:
            names = [None] + [
                str(row[name_column]).strip()
                for row in getter(owner_id)
            ]

            index = values[widget]

            if (
                not isinstance(index, int)
                or not 0 <= index < len(names)
            ):
                raise ValueError(
                    "The template selection is unavailable. "
                    "Reload the template."
                )

            st.session_state[
                _crf_key(owner_id, entry_id, field)
            ] = names[index]

    class_id = st.session_state.get(
        f"rf_editor_class_{owner_id}_{entry_id}"
    )

    if class_id is None:
        class_name = None

    else:
        rows = _rf_rows(
            "SELECT race_class_name FROM race_classes "
            "WHERE owner_id=? AND id=?",
            (owner_id, class_id),
        )

        if not rows:
            raise ValueError(
                "The template's race class is unavailable."
            )

        class_name = rows[0]["race_class_name"]

    st.session_state[
        _crf_key(owner_id, entry_id, "race_class_id")
    ] = class_name

def _cru_tables():
    return {
        "horse_id": ("horses", "horse_name"),
        "horse_owner_id": ("horse_owners", "horse_owner_name"),
        "jockey_id": ("jockeys", "jockey_name"),
        "previous_jockey_id": ("jockeys", "jockey_name"),
        "trainer_id": ("trainers", "trainer_name"),
        "breeding_farm_id": ("breeding_farms", "breeding_farm_name"),
        "stallion_id": ("stallions", "stallion_name"),
        "broodmare_sire_id": ("stallions", "stallion_name"),
        "venue_id": ("venues", "venue_name"),
        "previous_venue_id": ("venues", "venue_name"),
        "race_name_id": ("race_names", "race_name"),
        "race_class_id": ("race_classes", "race_class_name"),
    }


def _cru_new_key(owner_id, entry_id, field):
    return f"cru_new_{owner_id}_{entry_id}_{field}"




def _cru_mark_clear(owner_id, entry_id):
    st.session_state[
        f"cru_clear_{owner_id}_{entry_id}"
    ] = True


def _cru_prepare(owner_id, entry_id, widget_keys):
    clear_key = f"cru_clear_{owner_id}_{entry_id}"

    if st.session_state.pop(clear_key, False):
        for field in _cru_tables():
            st.session_state.pop(
                _cru_new_key(owner_id, entry_id, field),
                None,
            )

        # Reset keyed reference selectors before they are rendered.
        # New reference items can change their option indexes.
        for key in widget_keys:
            st.session_state.pop(key, None)


def _cru_clear_for_template(owner_id, entry_id, values):
    _crf_from_template(owner_id, entry_id, values)



def _cru_resolve(
    cursor,
    owner_id,
    checklist_id,
    changes,
    current,
):
    if changes is None:
        return current

    if (
        not isinstance(changes, dict)
        or set(changes) - set(current)
    ):
        raise ValueError("Invalid new-reference fields.")

    if any(
        not isinstance(value, str)
        for value in changes.values()
    ):
        raise ValueError(
            "New reference names must be text."
        )

    if not any(
        value.strip()
        for value in changes.values()
    ):
        return current

    if not cursor.execute(
        "SELECT 1 FROM checklists "
        "WHERE owner_id=? AND id=?",
        (owner_id, checklist_id),
    ).fetchone():
        raise ValueError(
            "Checklist is unavailable for this account."
        )

    result = dict(current)
    cache = {}

    for field, value in changes.items():
        name = value.strip()

        if not name:
            continue

        if len(name) > 200:
            raise ValueError(
                "New reference names must be "
                "200 characters or fewer."
            )

        # Table/column names come only from this fixed whitelist.
        table, column = _cru_tables()[field]

        if table not in cache:
            rows = cursor.execute(
                f"SELECT id,{column} FROM {table} "
                "WHERE owner_id=? ORDER BY id",
                (owner_id,),
            ).fetchall()

            cache[table] = {}

            for row in rows:
                normalized = (
                    str(row[column]).strip().casefold()
                )

                cache[table].setdefault(
                    normalized,
                    row["id"],
                )

        normalized = name.casefold()
        item_id = cache[table].get(normalized)

        if item_id is None:
            cursor.execute(
                f"INSERT INTO {table}(owner_id,{column}) "
                "VALUES (?,?)",
                (owner_id, name),
            )

            item_id = cursor.lastrowid
            cache[table][normalized] = item_id

        result[field] = item_id

    return result

def _rbl_move(owner_id, amount, total_pages):
    key = f"rbl_page_{owner_id}"
    current = int(st.session_state.get(key, 1) or 1)

    st.session_state[key] = max(
        1,
        min(total_pages, current + amount),
    )


def _rbl_navigation(owner_id, page, total_pages, position):
    left, middle, right = st.columns([1, 2, 1])

    with left:
        st.button(
            "Previous",
            key=f"rbl_previous_{position}_{owner_id}",
            disabled=page <= 1,
            on_click=_rbl_move,
            args=(owner_id, -1, total_pages),
        )

    with middle:
        if position == "top":
            page = int(
                st.number_input(
                    "Page",
                    min_value=1,
                    max_value=total_pages,
                    step=1,
                    value=None,
                    key=f"rbl_page_{owner_id}",
                )
                or 1
            )

        st.caption(
            f"Page {page:,} of {total_pages:,}"
            " · 20 articles per page"
        )

    with right:
        st.button(
            "Next",
            key=f"rbl_next_{position}_{owner_id}",
            disabled=page >= total_pages,
            on_click=_rbl_move,
            args=(owner_id, 1, total_pages),
        )

    return page


def _rbl_render(owner_id, templates):
    import json

    st.subheader("Articles")

    query = st.text_input(
        "Search titles, article text, or tags",
        key=f"rbl_search_text_{owner_id}",
    )

    tags = _rb_tag_input(
        owner_id,
        "Require tags — all selected tags must match",
        f"rbl_search_tags_{owner_id}",
    )

    try:
        normalized_tags = _rb_tags(tags)

        signature = json.dumps(
            [
                query.strip(),
                sorted(normalized_tags),
            ],
            ensure_ascii=False,
        )

        # The existing search helper returns 20 articles per page.
        count, rows = _rb_search(
            owner_id,
            query,
            tags,
            page=1,
        )

    except ValueError as error:
        st.error(str(error))
        return

    page_key = f"rbl_page_{owner_id}"
    signature_key = f"rbl_signature_{owner_id}"

    # Start from page one when search conditions change.
    if st.session_state.get(signature_key) != signature:
        st.session_state[signature_key] = signature
        st.session_state[page_key] = 1

    total_pages = max(1, (count + 19) // 20)

    page = max(
        1,
        min(
            total_pages,
            int(st.session_state.get(page_key, 1) or 1),
        ),
    )

    # Set state before creating the page-number widget.
    st.session_state[page_key] = page

    if not count:
        st.info(
            "No articles match these search conditions."
        )
        return

    page = _rbl_navigation(
        owner_id,
        page,
        total_pages,
        "top",
    )

    if page != 1:
        count, rows = _rb_search(
            owner_id,
            query,
            tags,
            page=page,
        )

    if not rows:
        st.info(
            "The results changed. Use Previous or change "
            "the search to refresh the list."
        )
        return

    first = (page - 1) * 20 + 1
    last = first + len(rows) - 1

    st.caption(
        f"Showing articles {first:,}–{last:,} "
        f"of {count:,}. Newest first."
    )

    ids = [row["id"] for row in rows]
    placeholders = ",".join("?" for _ in ids)

    # Fetch article text only for the current page.
    posts = {
        row["id"]: row
        for row in _rf_rows(
            "SELECT * FROM rf_blog_posts "
            "WHERE owner_id=? AND id IN ("
            + placeholders
            + ")",
            [owner_id] + ids,
        )
    }

    # Fetch tags for the current page in one query.
    tag_rows = _rf_rows(
        "SELECT pt.post_id,t.name "
        "FROM rf_blog_post_tags pt "
        "JOIN rf_blog_tags t ON t.id=pt.tag_id "
        "JOIN rf_blog_posts p ON p.id=pt.post_id "
        "WHERE p.owner_id=? AND t.owner_id=? "
        "AND p.id IN ("
        + placeholders
        + ") ORDER BY t.normalized",
        [owner_id, owner_id] + ids,
    )

    tags_by_post = {}

    for row in tag_rows:
        tags_by_post.setdefault(
            row["post_id"],
            [],
        ).append(row["name"])

    # Preserve the ordering returned by the search helper.
    for result in rows:
        post = posts.get(result["id"])

        if post is None:
            continue

        post_id = post["id"]
        prefix = f"rbl_article_{owner_id}_{post_id}"

        with st.container(border=True):
            st.subheader(post["title"])

            dates = (
                f"Article #{post_id}"
                f" | Created: {post['created_at']}"
            )

            if post.get("updated_at"):
                dates += (
                    f" | Updated: {post['updated_at']}"
                )

            st.caption(dates)

            template = templates.get(
                post["template_id"]
            )

            if template:
                st.caption(_rf_label(template))

            else:
                st.caption(
                    "Associated race template is unavailable."
                )

            article_tags = tags_by_post.get(
                post_id,
                [],
            )

            if article_tags:
                st.caption(
                    "Tags: "
                    + json.dumps(
                        article_tags,
                        ensure_ascii=False,
                    )
                )

            body = post.get("body") or ""

            if len(body) <= 500:
                st.markdown(
                    body,
                    unsafe_allow_html=False,
                )

            else:
                # A plain-text preview avoids broken Markdown
                # caused by cutting a link or formatting token.
                st.text(
                    body[:500].rstrip() + "…"
                )

                if st.checkbox(
                    "Read full article",
                    key=prefix + "_full",
                ):
                    st.markdown(
                        body,
                        unsafe_allow_html=False,
                    )

            if st.checkbox(
                "Show images",
                key=prefix + "_images",
            ):
                images = _rf_rows(
                    "SELECT filename,image_data "
                    "FROM rf_blog_images "
                    "WHERE owner_id=? AND post_id=? "
                    "ORDER BY id",
                    (owner_id, post_id),
                )

                if not images:
                    st.caption(
                        "This article has no images."
                    )

                for image in images:
                    st.image(
                        bytes(image["image_data"]),
                        caption=image["filename"],
                    )

            if st.checkbox(
                "Edit this article",
                key=prefix + "_edit",
            ):
                _rb_edit_article(
                    owner_id,
                    post,
                    templates,
                )

    _rbl_navigation(
        owner_id,
        page,
        total_pages,
        "bottom",
    )

def _rt_fields():
    return (
        "race_name_id",
        "race_date",
        "program_number",
        "distance",
        "number_of_horses",
        "race_class_id",
        "venue_id",
    )


def _rt_current(conn, owner_id, template_id, expected):
    found = conn.execute(
        "SELECT * FROM rf_race_templates "
        "WHERE owner_id=? AND id=?",
        (owner_id, template_id),
    ).fetchone()

    if found is None:
        raise ValueError("This template is unavailable.")

    current = dict(found)

    if any(
        current.get(key) != expected.get(key)
        for key in _rt_fields()
    ):
        raise ValueError(
            "This template changed after the editor was opened. "
            "Your changes were not saved. "
            "Reload the stored template first."
        )

    return current


def _rt_update(
    owner_id,
    template_id,
    expected,
    race_name_id,
    new_name,
    race_date,
    program,
    distance,
    horses,
    class_id,
    venue_id,
):
    if venue_id is None:
        raise ValueError("Select a venue.")

    if not date(1980, 1, 1) <= race_date <= date(2100, 12, 31):
        raise ValueError(
            "Race date must be between 1980 and 2100."
        )

    if not (
        1 <= int(program) <= 12
        and 1 <= int(distance) <= 5000
        and 1 <= int(horses) <= 18
    ):
        raise ValueError(
            "Program, distance, or number of horses "
            "is outside the supported range."
        )

    conn = _rf_db()

    try:
        conn.execute("BEGIN IMMEDIATE")

        try:
            _rt_current(
                conn,
                owner_id,
                template_id,
                expected,
            )

            if not conn.execute(
                "SELECT 1 FROM venues "
                "WHERE owner_id=? AND id=?",
                (owner_id, venue_id),
            ).fetchone():
                raise ValueError(
                    "The selected venue is unavailable "
                    "for this account."
                )

            if class_id is not None and not conn.execute(
                "SELECT 1 FROM race_classes "
                "WHERE owner_id=? AND id=?",
                (owner_id, class_id),
            ).fetchone():
                raise ValueError(
                    "The selected race class is unavailable "
                    "for this account."
                )

            if race_name_id is None:
                name = str(new_name or "").strip()

                if not name or len(name) > 200:
                    raise ValueError(
                        "Enter a new race name of 1–200 characters."
                    )

                existing = conn.execute(
                    "SELECT id FROM race_names "
                    "WHERE owner_id=? "
                    "AND RF_CASEFOLD(race_name)=RF_CASEFOLD(?)",
                    (owner_id, name),
                ).fetchone()

                if existing:
                    race_name_id = existing["id"]

                else:
                    race_name_id = conn.execute(
                        "INSERT INTO race_names(owner_id,race_name) "
                        "VALUES (?,?)",
                        (owner_id, name),
                    ).lastrowid

            elif not conn.execute(
                "SELECT 1 FROM race_names "
                "WHERE owner_id=? AND id=?",
                (owner_id, race_name_id),
            ).fetchone():
                raise ValueError(
                    "The selected race name is unavailable "
                    "for this account."
                )

            conn.execute("""
                UPDATE rf_race_templates
                SET race_name_id=?,
                    race_date=?,
                    program_number=?,
                    distance=?,
                    number_of_horses=?,
                    race_class_id=?,
                    venue_id=?
                WHERE owner_id=? AND id=?
            """, (
                race_name_id,
                race_date.isoformat(),
                int(program),
                int(distance),
                int(horses),
                class_id,
                venue_id,
                owner_id,
                template_id,
            ))

            conn.commit()

        except Exception:
            conn.rollback()
            raise

    finally:
        conn.close()


def _rt_delete(owner_id, template_id, expected):
    conn = _rf_db()

    try:
        conn.execute("BEGIN IMMEDIATE")

        try:
            _rt_current(
                conn,
                owner_id,
                template_id,
                expected,
            )

            if conn.execute(
                "SELECT 1 FROM rf_blog_posts "
                "WHERE template_id=? LIMIT 1",
                (template_id,),
            ).fetchone():
                raise ValueError(
                    "This template is linked to a blog article "
                    "and cannot be deleted. Edit the linked articles "
                    "and select another template first."
                )

            cursor = conn.execute(
                "DELETE FROM rf_race_templates "
                "WHERE owner_id=? AND id=?",
                (owner_id, template_id),
            )

            if cursor.rowcount != 1:
                raise ValueError(
                    "This template is unavailable."
                )

            conn.commit()

        except Exception:
            conn.rollback()
            raise

    finally:
        conn.close()


def _rt_reload(owner_id, template_id):
    st.session_state.pop(
        f"rt_snapshot_{owner_id}_{template_id}",
        None,
    )

    key = f"rt_generation_{owner_id}_{template_id}"

    st.session_state[key] = (
        st.session_state.get(key, 0) + 1
    )


def _rt_manage(owner_id):
    _rtn_require_native()
    st.markdown('---')
    st.subheader('Edit or Delete Race Templates')
    notice = st.session_state.pop(f'rt_notice_{owner_id}', None)
    if notice:
        st.success(notice)
    rows = _rf_templates(owner_id)
    if not rows:
        st.info('No race templates are registered.')
        return
    lookup = {row['id']: row for row in rows}
    selected = st.selectbox('Template to edit or delete', list(lookup), format_func=lambda value: f'#{value} | {_rf_label(lookup[value])}', key=f'rt_selected_{owner_id}')
    current = lookup[selected]
    snapshot_key = f'rt_snapshot_{owner_id}_{selected}'
    if snapshot_key not in st.session_state:
        st.session_state[snapshot_key] = dict(current)
    saved = st.session_state[snapshot_key]
    st.button('Reload Stored Template', key=f'rt_reload_{owner_id}_{selected}', on_click=_rt_reload, args=(owner_id, selected), help="Discard the editor's unsaved fields and load the current template.")
    if any((current.get(key) != saved.get(key) for key in _rt_fields())):
        st.warning('The stored template changed. Reload it before saving or deleting.')
    generation = st.session_state.get(f'rt_generation_{owner_id}_{selected}', 0)
    prefix = f'rt_edit_{owner_id}_{selected}_{generation}'
    names = {row['id']: row['race_name'] for row in get_user_race_names(owner_id)}
    venues = {row['id']: row['venue_name'] for row in get_user_venues(owner_id)}
    class_ids, class_labels = _rf_class_options(owner_id)
    classes = dict(zip(class_ids, class_labels))
    name_ids = [None] + list(names)
    venue_ids = [None] + list(venues)
    initial_name = saved.get('race_name_id') if saved.get('race_name_id') in names else None
    initial_venue = saved.get('venue_id') if saved.get('venue_id') in venues else None
    initial_class = saved.get('race_class_id') if saved.get('race_class_id') in classes else None
    try:
        initial_date = date.fromisoformat(saved['race_date'])
    except (ValueError, TypeError):
        initial_date = date.today()
        st.warning('The stored date is invalid. Choose the correct date before saving.')
    initial_date = max(date(1980, 1, 1), min(date(2100, 12, 31), initial_date))
    st.caption('Edits preserve the template ID and its blog links. Existing checklist records are not changed. Choosing a different race name does not rename the shared Race Names entry.')
    with st.form(prefix):
        name_id, new_name = _rtn_input(owner_id, prefix + '_race_name', initial_name)
        venue_id = st.selectbox('Venue', venue_ids, index=venue_ids.index(initial_venue), format_func=lambda value: '(Select a venue)' if value is None else venues[value], key=prefix + '_venue')
        race_date = st.date_input('Race date', value=initial_date, min_value=date(1980, 1, 1), max_value=date(2100, 12, 31), key=prefix + '_date')
        program = st.number_input('Program number', min_value=1, max_value=12, value=max(1, min(12, int(saved.get('program_number') or 1))), key=prefix + '_program')
        distance = st.number_input('Distance (meters)', min_value=1, max_value=5000, value=max(1, min(5000, int(saved.get('distance') or 1600))), step=100, key=prefix + '_distance')
        horses = st.number_input('Number of horses', min_value=1, max_value=18, value=max(1, min(18, int(saved.get('number_of_horses') or 18))), key=prefix + '_horses')
        class_id = st.selectbox('Race class', class_ids, index=class_ids.index(initial_class), format_func=lambda value: classes[value], key=prefix + '_class')
        submit = st.form_submit_button('Save Template Changes')
    if submit:
        try:
            _rt_update(owner_id, selected, saved, name_id, new_name, race_date, program, distance, horses, class_id, venue_id)
        except sqlite3.IntegrityError:
            st.error('Changes were not saved. Another template may already use that race name, date, and program number, or a referenced item is unavailable. No other template was overwritten.')
        except (ValueError, sqlite3.Error) as error:
            st.error(f'Changes were not saved: {error}')
        else:
            _rt_reload(owner_id, selected)
            st.session_state[f'rt_notice_{owner_id}'] = f'Template #{selected} updated.'
            st.rerun()
    with st.expander('Delete Selected Template', expanded=False):
        linked = _rf_rows('SELECT COUNT(*) AS n FROM rf_blog_posts WHERE template_id=?', (selected,))[0]['n']
        if linked:
            st.warning(f'This template has {linked} linked blog article(s). Move those articles to another template before deleting it.')
        st.caption('Deletion removes only this saved template. It does not delete checklists, race names, venues, classes, articles, tags, or images.')
        confirmed = st.checkbox(f'Permanently delete template #{selected}', key=prefix + '_confirm_delete')
        if st.button('Delete Template Permanently', key=prefix + '_delete', disabled=not confirmed or bool(linked)):
            try:
                _rt_delete(owner_id, selected, saved)
            except (ValueError, sqlite3.Error) as error:
                st.error(f'Template was not deleted: {error}')
            else:
                _rt_reload(owner_id, selected)
                st.session_state[f'rt_notice_{owner_id}'] = f'Template #{selected} deleted.'
                st.rerun()


def _rb_migrate():
    conn = _rf_db()
    try:
        conn.execute("BEGIN IMMEDIATE")
        try:
            columns = {
                row["name"]
                for row in conn.execute(
                    "PRAGMA table_info(rf_blog_posts)"
                )
            }

            if not columns:
                raise RuntimeError(
                    "Race-blog tables are missing. "
                    "Install the race-feature update first."
                )

            if "revision" not in columns:
                conn.execute(
                    "ALTER TABLE rf_blog_posts "
                    "ADD COLUMN revision INTEGER NOT NULL DEFAULT 0"
                )

            if "updated_at" not in columns:
                conn.execute(
                    "ALTER TABLE rf_blog_posts "
                    "ADD COLUMN updated_at TEXT"
                )

            conn.commit()

        except Exception:
            conn.rollback()
            raise

    finally:
        conn.close()


def _rb_tags(values):
    # Strings are treated as newline-separated, never comma-separated.
    if isinstance(values, str):
        values = values.splitlines()

    result = {}

    for value in values or []:
        tag = str(value).strip()

        if not tag:
            continue

        if "\n" in tag or "\r" in tag:
            raise ValueError("Each tag must occupy a single line.")

        if len(tag) > 60:
            raise ValueError(
                "Each tag must be 60 characters or fewer."
            )

        result.setdefault(tag.casefold(), tag)

    if len(result) > 20:
        raise ValueError("Use no more than 20 tags.")

    return result


def _rb_tag_options(owner_id):
    rows = _rf_rows("""
        SELECT DISTINCT t.name, t.normalized
        FROM rf_blog_tags t
        JOIN rf_blog_post_tags pt ON pt.tag_id = t.id
        JOIN rf_blog_posts p ON p.id = pt.post_id
        WHERE t.owner_id = ? AND p.owner_id = ?
        ORDER BY t.normalized
    """, (owner_id, owner_id))

    return [row["name"] for row in rows]


def _rb_tag_input(owner_id, label, key, initial=None):
    import inspect

    initial = list(_rb_tags(initial or []).values())
    options = {}

    for value in _rb_tag_options(owner_id) + initial:
        options.setdefault(value.casefold(), value)

    # Keep the initial spelling in the available/default selections.
    for value in initial:
        options[value.casefold()] = value

    available = list(options.values())

    try:
        parameters = inspect.signature(
            st.multiselect
        ).parameters
    except (TypeError, ValueError):
        parameters = {}

    if "accept_new_options" in parameters:
        kwargs = {
            "label": label,
            "options": available,
            "default": initial,
            "key": key,
            "accept_new_options": True,
            "max_selections": 20,
            "help": (
                "Type a tag and press Enter to add it. "
                "Use the x on a tag to remove it. "
                "Commas are not separators."
            ),
        }

        # Avoid Enter accidentally selecting all matching options
        # on versions that provide this setting.
        if "select_all" in parameters:
            kwargs["select_all"] = False

        return st.multiselect(**kwargs)

    text = st.text_area(
        label + " — one tag per line",
        value="\n".join(initial),
        key=key,
        height=100,
        help=(
            "Press Enter after each tag. "
            "Each nonempty line becomes one tag. "
            "Commas are not separators."
        ),
    )

    return [
        line.strip()
        for line in text.splitlines()
        if line.strip()
    ]


def _rb_post_tags(owner_id, post_id):
    rows = _rf_rows("""
        SELECT t.name
        FROM rf_blog_post_tags pt
        JOIN rf_blog_tags t ON t.id = pt.tag_id
        JOIN rf_blog_posts p ON p.id = pt.post_id
        WHERE p.owner_id = ?
          AND p.id = ?
          AND t.owner_id = ?
        ORDER BY t.normalized
    """, (owner_id, post_id, owner_id))

    return [row["name"] for row in rows]


def _rb_image_metadata(owner_id, post_id):
    return _rf_rows("""
        SELECT id, filename, mime_type,
               length(image_data) AS byte_count
        FROM rf_blog_images
        WHERE owner_id = ? AND post_id = ?
        ORDER BY id
    """, (owner_id, post_id))


def _rb_save(
    owner_id,
    template_id,
    title,
    body,
    tag_values,
    uploads,
    post_id=None,
    expected_revision=None,
    remove_image_ids=None,
):
    title = str(title or "").strip()
    body = str(body or "").strip()

    if not title or len(title) > 200:
        raise ValueError(
            "Enter an article title of 1–200 characters."
        )

    if not body or len(body) > 200_000:
        raise ValueError(
            "Enter article text of 1–200,000 characters."
        )

    tags = _rb_tags(tag_values)
    removals = set(remove_image_ids or [])

    if any(
        isinstance(value, bool) or not isinstance(value, int)
        for value in removals
    ):
        raise ValueError("Invalid image selection.")

    if post_id is not None:
        existing = _rf_rows(
            "SELECT id FROM rf_blog_posts "
            "WHERE owner_id = ? AND id = ?",
            (owner_id, post_id),
        )

        if not existing:
            raise ValueError(
                "The article is unavailable for this account."
            )

        if expected_revision is None:
            raise ValueError(
                "The article revision is missing. Reload the article."
            )

    elif removals:
        raise ValueError(
            "Images cannot be removed from an unsaved article."
        )

    # Reuse the existing image validation/normalization.
    prepared_images = _rf_images(list(uploads or []))

    # Validates ownership of the associated template.
    _rf_template(owner_id, template_id)

    conn = _rf_db()

    try:
        with conn:
            if not conn.execute(
                "SELECT 1 FROM rf_race_templates "
                "WHERE owner_id = ? AND id = ?",
                (owner_id, template_id),
            ).fetchone():
                raise ValueError(
                    "The selected race template is unavailable."
                )

            if post_id is None:
                cursor = conn.execute("""
                    INSERT INTO rf_blog_posts(
                        owner_id, template_id, title, body,
                        revision, updated_at
                    )
                    VALUES (?, ?, ?, ?, 0, NULL)
                """, (
                    owner_id,
                    template_id,
                    title,
                    body,
                ))

                saved_id = cursor.lastrowid
                old_images = []

            else:
                cursor = conn.execute("""
                    UPDATE rf_blog_posts
                    SET template_id = ?,
                        title = ?,
                        body = ?,
                        updated_at = CURRENT_TIMESTAMP,
                        revision = revision + 1
                    WHERE owner_id = ?
                      AND id = ?
                      AND revision = ?
                """, (
                    template_id,
                    title,
                    body,
                    owner_id,
                    post_id,
                    int(expected_revision),
                ))

                if cursor.rowcount != 1:
                    raise ValueError(
                        "This article changed after you opened the editor. "
                        "Your changes were not saved. Copy any text you "
                        "want to keep, then click Reload Stored Article."
                    )

                saved_id = post_id

                old_images = [
                    dict(row)
                    for row in conn.execute("""
                        SELECT id, length(image_data) AS byte_count
                        FROM rf_blog_images
                        WHERE owner_id = ? AND post_id = ?
                    """, (owner_id, saved_id))
                ]

            valid_image_ids = {
                row["id"] for row in old_images
            }

            if not removals.issubset(valid_image_ids):
                raise ValueError(
                    "An image selected for removal is unavailable."
                )

            retained_images = [
                row
                for row in old_images
                if row["id"] not in removals
            ]

            if len(retained_images) + len(prepared_images) > 6:
                raise ValueError(
                    "An article can contain at most six images. "
                    "Select existing images for removal before "
                    "adding more."
                )

            retained_bytes = sum(
                row["byte_count"] or 0
                for row in retained_images
            )

            new_bytes = sum(
                len(data)
                for _, _, data in prepared_images
            )

            if retained_bytes + new_bytes > 20 * 1024 * 1024:
                raise ValueError(
                    "Combined stored images for this article "
                    "must not exceed 20 MB."
                )

            # Replace only this article's tag associations.
            conn.execute(
                "DELETE FROM rf_blog_post_tags WHERE post_id = ?",
                (saved_id,),
            )

            for normalized, name in tags.items():
                conn.execute("""
                    INSERT INTO rf_blog_tags(
                        owner_id, name, normalized
                    )
                    VALUES (?, ?, ?)
                    ON CONFLICT(owner_id, normalized) DO NOTHING
                """, (owner_id, name, normalized))

                tag_id = conn.execute(
                    "SELECT id FROM rf_blog_tags "
                    "WHERE owner_id = ? AND normalized = ?",
                    (owner_id, normalized),
                ).fetchone()["id"]

                conn.execute(
                    "INSERT INTO rf_blog_post_tags(post_id, tag_id) "
                    "VALUES (?, ?)",
                    (saved_id, tag_id),
                )

            for image_id in removals:
                conn.execute(
                    "DELETE FROM rf_blog_images "
                    "WHERE owner_id = ? AND post_id = ? AND id = ?",
                    (owner_id, saved_id, image_id),
                )

            for filename, mime, data in prepared_images:
                conn.execute("""
                    INSERT INTO rf_blog_images(
                        owner_id, post_id, filename,
                        mime_type, image_data
                    )
                    VALUES (?, ?, ?, ?, ?)
                """, (
                    owner_id,
                    saved_id,
                    filename,
                    mime,
                    sqlite3.Binary(data),
                ))

        return saved_id

    finally:
        conn.close()


def _rb_search(owner_id, query, tag_values, page=1):
    required_tags = _rb_tags(tag_values)
    clauses = ["p.owner_id = ?"]
    parameters = [owner_id]
    query = str(query or "").strip()

    if query:
        clauses.append("""
            (
                instr(
                    RF_CASEFOLD(p.title || ' ' || p.body),
                    RF_CASEFOLD(?)
                ) > 0
                OR EXISTS (
                    SELECT 1
                    FROM rf_blog_post_tags pt
                    JOIN rf_blog_tags t ON t.id = pt.tag_id
                    WHERE pt.post_id = p.id
                      AND t.owner_id = p.owner_id
                      AND instr(t.normalized, RF_CASEFOLD(?)) > 0
                )
            )
        """)

        parameters.extend([query, query])

    for normalized in required_tags:
        clauses.append("""
            EXISTS (
                SELECT 1
                FROM rf_blog_post_tags pt
                JOIN rf_blog_tags t ON t.id = pt.tag_id
                WHERE pt.post_id = p.id
                  AND t.owner_id = p.owner_id
                  AND t.normalized = ?
            )
        """)

        parameters.append(normalized)

    where = " AND ".join(clauses)

    count = _rf_rows(
        "SELECT COUNT(*) AS n FROM rf_blog_posts p WHERE " + where,
        parameters,
    )[0]["n"]

    rows = _rf_rows(
        "SELECT p.id, p.title, p.created_at, p.updated_at "
        "FROM rf_blog_posts p WHERE "
        + where
        + " ORDER BY p.id DESC LIMIT 20 OFFSET ?",
        parameters + [max(0, int(page) - 1) * 20],
    )

    return count, rows


def _rb_reload_editor(owner_id, post_id):
    st.session_state.pop(
        f"rb_edit_snapshot_{owner_id}_{post_id}",
        None,
    )

    generation_key = f"rb_edit_generation_{owner_id}_{post_id}"

    st.session_state[generation_key] = (
        st.session_state.get(generation_key, 0) + 1
    )


def _rb_edit_article(owner_id, post, templates):
    post_id = post["id"]
    snapshot_key = f"rb_edit_snapshot_{owner_id}_{post_id}"

    if snapshot_key not in st.session_state:
        st.session_state[snapshot_key] = {
            "revision": int(post["revision"]),
            "title": post["title"],
            "body": post["body"],
            "template_id": post["template_id"],
            "tags": _rb_post_tags(owner_id, post_id),
        }

    snapshot = st.session_state[snapshot_key]

    st.button(
        "Reload Stored Article",
        key=f"rb_reload_article_{owner_id}_{post_id}",
        on_click=_rb_reload_editor,
        args=(owner_id, post_id),
        help=(
            "Discard this editor's unsaved fields and reload "
            "the stored article on the next render."
        ),
    )

    if int(post["revision"]) != snapshot["revision"]:
        st.warning(
            "The stored article has changed since this editor "
            "was opened. Copy any unsaved text you want to retain, "
            "then reload before saving."
        )

    if not templates:
        st.info(
            "A race template is required to save an article."
        )
        return

    template_ids = list(templates)
    initial_template = snapshot["template_id"]

    if initial_template not in templates:
        initial_template = template_ids[0]
        st.warning(
            "The original race template is unavailable. "
            "Choose a replacement before saving."
        )

    generation = st.session_state.get(
        f"rb_edit_generation_{owner_id}_{post_id}",
        0,
    )

    prefix = (
        f"rb_edit_{owner_id}_{post_id}_"
        f"{snapshot['revision']}_{generation}"
    )

    image_rows = _rb_image_metadata(owner_id, post_id)
    image_lookup = {
        row["id"]: row for row in image_rows
    }

    with st.form(prefix):
        template_id = st.selectbox(
            "Race template",
            template_ids,
            index=template_ids.index(initial_template),
            format_func=lambda value: _rf_label(templates[value]),
            key=prefix + "_template",
        )

        title = st.text_input(
            "Article title",
            value=snapshot["title"],
            max_chars=200,
            key=prefix + "_title",
        )

        body = st.text_area(
            "Article text — Markdown supported",
            value=snapshot["body"],
            max_chars=200_000,
            height=320,
            key=prefix + "_body",
        )

        tags = _rb_tag_input(
            owner_id,
            "Tags — type a tag and press Enter",
            prefix + "_tags",
            snapshot["tags"],
        )

        removals = st.multiselect(
            "Existing images to remove — leave empty to keep all",
            list(image_lookup),
            format_func=lambda value: (
                f"#{value} — {image_lookup[value]['filename']}"
            ),
            key=prefix + "_remove_images",
        )

        uploads = st.file_uploader(
            "Add images — existing images are kept unless selected above",
            type=["jpg", "jpeg", "png", "webp"],
            accept_multiple_files=True,
            key=prefix + "_uploads",
        )

        st.caption(
            "Maximum six stored images per article, 20 MB combined. "
            "New image uploads must be 5 MB or smaller each."
        )

        save = st.form_submit_button("Save Article Changes")

    if save:
        try:
            _rb_save(
                owner_id,
                template_id,
                title,
                body,
                tags,
                uploads,
                post_id=post_id,
                expected_revision=snapshot["revision"],
                remove_image_ids=removals,
            )

        except Exception as error:
            st.error(f"Changes were not saved: {error}")

        else:
            _rb_reload_editor(owner_id, post_id)

            st.session_state[
                f"rb_blog_notice_{owner_id}"
            ] = f"Article #{post_id} updated."

            st.rerun()


def _rb_page(owner_id):
    st.header('Race Blog')
    st.caption('Private articles for your account. Add tags by typing a tag and pressing Enter.')
    notice = st.session_state.pop(f'rb_blog_notice_{owner_id}', None)
    if notice:
        st.success(notice)
    templates = {row['id']: row for row in _rf_templates(owner_id)}
    generation_key = f'rb_create_generation_{owner_id}'
    generation = st.session_state.get(generation_key, 0)
    prefix = f'rb_create_{owner_id}_{generation}'
    with st.expander('Write a Race Blog Article', expanded=False):
        if not templates:
            st.info('Create a race template first.')
        else:
            with st.form(prefix):
                template_id = st.selectbox('Race template for this article', list(templates), format_func=lambda value: _rf_label(templates[value]), key=prefix + '_template')
                title = st.text_input('Article title', max_chars=200, key=prefix + '_title')
                body = st.text_area('Article text — Markdown supported', height=280, max_chars=200000, key=prefix + '_body')
                tags = _rb_tag_input(owner_id, 'Tags — type a tag and press Enter', prefix + '_tags')
                uploads = st.file_uploader('Images — up to six, 5 MB each', type=['jpg', 'jpeg', 'png', 'webp'], accept_multiple_files=True, key=prefix + '_uploads')
                save = st.form_submit_button('Save Blog Article')
            if save:
                try:
                    post_id = _rb_save(owner_id, template_id, title, body, tags, uploads)
                except Exception as error:
                    st.error(f'Article was not saved: {error}')
                else:
                    st.session_state[generation_key] = generation + 1
                    st.session_state[f'rb_blog_notice_{owner_id}'] = f'Article #{post_id} saved.'
                    st.rerun()
    _rbl_render(owner_id, templates)


def _rf_venue_migrate():
    conn = _rf_db()
    try:
        conn.execute("BEGIN IMMEDIATE")
        try:
            if "venue_id" not in {r["name"] for r in conn.execute("PRAGMA table_info(rf_race_templates)")}:
                conn.execute("ALTER TABLE rf_race_templates ADD COLUMN venue_id INTEGER REFERENCES venues(id)")
            conn.execute("CREATE INDEX IF NOT EXISTS idx_rf_template_venue ON rf_race_templates(owner_id,venue_id)")
            conn.commit()
        except Exception:
            conn.rollback()
            raise
    finally:
        conn.close()


def _rf_venue_options(owner_id):
    rows = get_user_venues(owner_id)
    return [None]+[r["id"] for r in rows], {r["id"]:r["venue_name"] for r in rows}


def _rf_template_venue_input(owner_id):
    ids, labels = _rf_venue_options(owner_id)
    if not labels:
        st.info("Register a venue from the Venues menu before saving a template.")
    return st.selectbox("Venue — required when saving a template",ids,
        format_func=lambda value:"(Select a venue)" if value is None else labels[value],
        key=f"rf_template_venue_{owner_id}")


def _rf_templates(owner_id):
    return _rf_rows("""SELECT t.*,rn.race_name,rc.race_class_name,v.venue_name
        FROM rf_race_templates t
        LEFT JOIN race_names rn ON rn.id=t.race_name_id AND rn.owner_id=t.owner_id
        LEFT JOIN race_classes rc ON rc.id=t.race_class_id AND rc.owner_id=t.owner_id
        LEFT JOIN venues v ON v.id=t.venue_id AND v.owner_id=t.owner_id
        WHERE t.owner_id=? ORDER BY t.race_date DESC,t.program_number,t.id DESC""",(owner_id,))


def _rf_label(row):
    return (f"{row['race_date']} | {row.get('venue_name') or '(Venue not set)'} | "
        f"R{row['program_number']} | {row.get('race_name') or '(Race name unavailable)'} | "
        f"{row['distance']}m | {row['number_of_horses']} horses"
        +(f" | {row['race_class_name']}" if row.get("race_class_name") else ""))


def _rf_template(owner_id,template_id):
    row=next((r for r in _rf_templates(owner_id) if r["id"]==template_id),None)
    if row is None or not row.get("race_name"):
        raise ValueError("The race template or its race name is unavailable.")
    _rf_resolve_class(owner_id,None,row["race_class_id"])
    if row.get("venue_id") is not None and not row.get("venue_name"):
        raise ValueError("The template's venue is unavailable. Choose a valid venue and save the template again.")
    return row


def _rf_save_template(owner_id,name_id,new_name,race_date,program,distance,horses,class_id,*,venue_id=None):
    if venue_id is None:
        raise ValueError("Select a venue before saving the race template.")
    if not 1<=int(program)<=12 or not 1<=int(distance)<=5000 or not 1<=int(horses)<=18:
        raise ValueError("Race template numbers are outside the supported ranges.")
    if not date(1980,1,1)<=race_date<=date(2100,12,31):
        raise ValueError("Race date must be between 1980 and 2100.")
    conn=_rf_db()
    try:
        with conn:
            if not conn.execute("SELECT 1 FROM venues WHERE owner_id=? AND id=?",(owner_id,venue_id)).fetchone():
                raise ValueError("The selected venue does not belong to this account.")
            if class_id is not None and not conn.execute("SELECT 1 FROM race_classes WHERE owner_id=? AND id=?",(owner_id,class_id)).fetchone():
                raise ValueError("The selected class does not belong to this account.")
            if name_id is None:
                name=new_name.strip()
                if not name or len(name)>200:
                    raise ValueError("Enter a race name of 1–200 characters.")
                found=conn.execute("SELECT id FROM race_names WHERE owner_id=? AND RF_CASEFOLD(race_name)=RF_CASEFOLD(?)",(owner_id,name)).fetchone()
                name_id=found["id"] if found else conn.execute("INSERT INTO race_names(owner_id,race_name) VALUES (?,?)",(owner_id,name)).lastrowid
            elif not conn.execute("SELECT 1 FROM race_names WHERE owner_id=? AND id=?",(owner_id,name_id)).fetchone():
                raise ValueError("Race name does not belong to this account.")
            conn.execute("""INSERT INTO rf_race_templates
                (owner_id,race_name_id,race_date,program_number,distance,number_of_horses,race_class_id,venue_id)
                VALUES (?,?,?,?,?,?,?,?)
                ON CONFLICT(owner_id,race_name_id,race_date,program_number) DO UPDATE SET
                distance=excluded.distance,number_of_horses=excluded.number_of_horses,
                race_class_id=excluded.race_class_id,venue_id=excluded.venue_id""",
                (owner_id,name_id,race_date.isoformat(),int(program),int(distance),int(horses),class_id,venue_id))
    finally:
        conn.close()


def _rf_load(owner_id,template_id,mode,target_keys=None):
    try:
        row=_rf_template(owner_id,template_id)
        if mode=="registration":
            values={"selected_race_idx":row["race_name"],"date_of_race":date.fromisoformat(row["race_date"]),
                "program_number":row["program_number"],"distance":row["distance"],
                "number_of_horses":row["number_of_horses"],"race_class_id":row["race_class_id"]}
            if row.get("venue_id") is not None:
                values["selected_venue_idx"]=row["venue_name"]
            if not target_keys or any(field not in target_keys for field in values):
                raise ValueError("Registration widget mapping is incomplete.")
            for field,value in values.items():
                st.session_state[target_keys[field]]=value
            for field in ("selected_race_idx","selected_venue_idx"):
                if field in values:
                    st.session_state[target_keys[field]+"_new_name"]=""
        else:
            reset_filter_values(owner_id)
            values={"race_name_id":row["race_name_id"],"race_class_id":row["race_class_id"],
                "venue_ids":[row["venue_id"]] if row.get("venue_id") is not None else [],
                "date_from":date.fromisoformat(row["race_date"]),"date_to":date.fromisoformat(row["race_date"]),
                "program_number":row["program_number"],"number_of_horses":row["number_of_horses"],
                "distance_from":row["distance"],"distance_to":row["distance"],"enable_distance_filter":True,
                "page_number":1,"active_filter_title":"Race template: "+_rf_label(row)}
            for field,value in values.items():
                st.session_state[saved_filter_key(owner_id,field)]=value
            st.session_state[filter_load_version_key(owner_id)]+=1
            st.session_state[second_filter_key(owner_id,"enabled")]=False
            st.session_state.pop(_review_filter_restore_key(owner_id),None)
            st.session_state.pop("selected_review_checklist_id",None)
        notice="Loaded: "+_rf_label(row)
        if row.get("venue_id") is None:
            notice+=". This older template has no venue. Re-save it with a venue; registration venue was not changed and Review has no venue restriction."
        st.session_state[f"rf_notice_{mode}_{owner_id}"]=notice
    except (ValueError,sqlite3.Error) as error:
        st.session_state[f"rf_error_{mode}_{owner_id}"]=str(error)


def _rf_venue_editor_key(owner_id,entry_id,field):
    return f"rf_venue_editor_{owner_id}_{entry_id}_{field}"


def _rf_venue_editor_widget(widget_function,*args,**kwargs):
    key=kwargs.get("key")
    if key is not None and key in st.session_state:
        if getattr(widget_function,"__name__","")=="selectbox":
            kwargs["index"]=None
        else:
            kwargs["value"]=None
    return widget_function(*args,**kwargs)


def _rf_venue_load_editor(owner_id, entry_id, template_id):
    try:
        if not _rf_rows('SELECT id FROM checklists WHERE owner_id=? AND id=?', (owner_id, entry_id)):
            raise ValueError('Checklist is unavailable.')
        row = _rf_template(owner_id, template_id)
        race_ids = [None] + [r['id'] for r in get_user_race_names(owner_id)]
        venue_ids = [None] + [r['id'] for r in get_user_venues(owner_id)]
        values = {'edit_race_idx': race_ids.index(row['race_name_id']), 'edit_distance': row['distance'], 'edit_date': date.fromisoformat(row['race_date']), 'edit_program_number': row['program_number'], 'edit_number_of_horses': row['number_of_horses']}
        if row.get('venue_id') is not None:
            values['edit_venue_idx'] = venue_ids.index(row['venue_id'])
        for field, value in values.items():
            st.session_state[_rf_venue_editor_key(owner_id, entry_id, field)] = value
        st.session_state[f'rf_editor_class_{owner_id}_{entry_id}'] = row['race_class_id']
        _cru_clear_for_template(owner_id, entry_id, values)
        message = 'Loaded into editor: ' + _rf_label(row) + '. Click Update Checklist to save.'
        if row.get('venue_id') is None:
            message += ' The existing venue was left unchanged.'
        st.session_state[f'rf_venue_editor_notice_{owner_id}_{entry_id}'] = message
    except (ValueError, sqlite3.Error) as error:
        st.session_state[f'rf_venue_editor_error_{owner_id}_{entry_id}'] = str(error)



def _rf_venue_editor_loader(owner_id,entry):
    entry_id=entry["id"]
    notice=st.session_state.pop(f"rf_venue_editor_notice_{owner_id}_{entry_id}",None)
    error=st.session_state.pop(f"rf_venue_editor_error_{owner_id}_{entry_id}",None)
    if notice:
        st.success(notice)
    if error:
        st.error(error)
    with st.expander("Load Race Template into This Checklist",expanded=False):
        rows=_rf_templates(owner_id)
        if not rows:
            st.info("Create a race template first.")
            return
        lookup={r["id"]:r for r in rows}
        selected=st.selectbox("Race template for this checklist",[None]+list(lookup),
            format_func=lambda value:"(Select a template)" if value is None else _rf_label(lookup[value]),
            key=f"rf_venue_editor_template_{owner_id}_{entry_id}")
        st.caption("Loads race name, venue, date, program number, distance, number of horses, and class. It does not change Review filters or save the record until you click Update Checklist.")
        st.button("Load into Checklist Editor",key=f"rf_venue_editor_load_{owner_id}_{entry_id}",
            disabled=selected is None,on_click=_rf_venue_load_editor,args=(owner_id,entry_id,selected))


def _rf_venue_set_existing(owner_id,template_id,venue_id):
    if venue_id is None:
        raise ValueError("Select a venue.")
    conn=_rf_db()
    try:
        with conn:
            if not conn.execute("SELECT 1 FROM venues WHERE owner_id=? AND id=?",(owner_id,venue_id)).fetchone():
                raise ValueError("The selected venue does not belong to this account.")
            cursor=conn.execute("UPDATE rf_race_templates SET venue_id=? WHERE owner_id=? AND id=?",(venue_id,owner_id,template_id))
            if cursor.rowcount!=1:
                raise ValueError("Race template is unavailable.")
    finally:
        conn.close()


def _rf_venue_existing_editor(owner_id):
    with st.expander("Set Venue on an Existing Template",expanded=False):
        rows=_rf_templates(owner_id)
        ids,labels=_rf_venue_options(owner_id)
        if not rows or len(ids)==1:
            st.info("Register a race template and at least one venue first.")
            return
        lookup={r["id"]:r for r in rows}
        selected=st.selectbox("Existing race template",list(lookup),
            format_func=lambda value:_rf_label(lookup[value]),key=f"rf_venue_existing_{owner_id}")
        row=lookup[selected]
        current=row.get("venue_id") if row.get("venue_id") in ids else None
        key=f"rf_venue_existing_choice_{owner_id}_{selected}"
        venue=st.selectbox("Venue for this template",ids,
            index=None if key in st.session_state else ids.index(current),
            format_func=lambda value:"(Select a venue)" if value is None else labels[value],key=key)
        st.caption("Updates only this template's venue. Its ID, other settings, blog links, and existing checklists are unchanged.")
        if st.button("Save Template Venue",key=f"rf_venue_existing_save_{owner_id}",disabled=venue is None):
            try:
                _rf_venue_set_existing(owner_id,selected,venue)
                st.success("Template venue saved. Other template settings were preserved.")
            except (ValueError,sqlite3.Error) as error:
                st.error(str(error))

def _rf_db():
    conn = get_db_connection()
    conn.execute("PRAGMA foreign_keys = ON")
    conn.create_function("RF_CASEFOLD", 1, lambda x: str(x or "").casefold())
    return conn


def _rf_rows(sql, args=()):
    conn = _rf_db()
    try:
        return [dict(row) for row in conn.execute(sql, args).fetchall()]
    finally:
        conn.close()


def _rf_migrate():
    conn = _rf_db()
    try:
        exists = conn.execute("SELECT 1 FROM sqlite_master WHERE name='rf_versions' AND type='table'").fetchone()
        if exists and conn.execute("SELECT 1 FROM rf_versions WHERE version='20261114-v2'").fetchone():
            return
        conn.execute("BEGIN IMMEDIATE")
        try:
            conn.execute("CREATE TABLE IF NOT EXISTS race_classes (id INTEGER PRIMARY KEY AUTOINCREMENT, owner_id INTEGER NOT NULL REFERENCES users(id), race_class_name TEXT NOT NULL, UNIQUE(owner_id,race_class_name))")
            if "race_class_id" not in {r["name"] for r in conn.execute("PRAGMA table_info(checklists)")}:
                conn.execute("ALTER TABLE checklists ADD COLUMN race_class_id INTEGER REFERENCES race_classes(id)")
            conn.execute("CREATE INDEX IF NOT EXISTS idx_rf_checklist_class ON checklists(owner_id,race_class_id)")
            conn.execute("""CREATE TABLE IF NOT EXISTS rf_race_templates (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                owner_id INTEGER NOT NULL REFERENCES users(id),
                race_name_id INTEGER NOT NULL REFERENCES race_names(id),
                race_date TEXT NOT NULL,
                program_number INTEGER NOT NULL CHECK(program_number BETWEEN 1 AND 12),
                distance INTEGER NOT NULL CHECK(distance BETWEEN 1 AND 5000),
                number_of_horses INTEGER NOT NULL CHECK(number_of_horses BETWEEN 1 AND 18),
                race_class_id INTEGER REFERENCES race_classes(id),
                UNIQUE(owner_id,race_name_id,race_date,program_number))""")
            conn.execute("""CREATE TABLE IF NOT EXISTS rf_blog_posts (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                owner_id INTEGER NOT NULL REFERENCES users(id),
                template_id INTEGER NOT NULL REFERENCES rf_race_templates(id),
                title TEXT NOT NULL, body TEXT NOT NULL,
                created_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP)""")
            conn.execute("""CREATE TABLE IF NOT EXISTS rf_blog_tags (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                owner_id INTEGER NOT NULL REFERENCES users(id),
                name TEXT NOT NULL, normalized TEXT NOT NULL,
                UNIQUE(owner_id,normalized))""")
            conn.execute("""CREATE TABLE IF NOT EXISTS rf_blog_post_tags (
                post_id INTEGER NOT NULL REFERENCES rf_blog_posts(id) ON DELETE CASCADE,
                tag_id INTEGER NOT NULL REFERENCES rf_blog_tags(id),
                PRIMARY KEY(post_id,tag_id))""")
            conn.execute("""CREATE TABLE IF NOT EXISTS rf_blog_images (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                owner_id INTEGER NOT NULL REFERENCES users(id),
                post_id INTEGER NOT NULL REFERENCES rf_blog_posts(id) ON DELETE CASCADE,
                filename TEXT NOT NULL, mime_type TEXT NOT NULL, image_data BLOB NOT NULL)""")
            conn.execute("CREATE INDEX IF NOT EXISTS idx_rf_posts_owner ON rf_blog_posts(owner_id,id DESC)")
            conn.execute("CREATE INDEX IF NOT EXISTS idx_rf_images_post ON rf_blog_images(owner_id,post_id)")
            conn.execute("CREATE TABLE IF NOT EXISTS rf_versions(version TEXT PRIMARY KEY)")
            conn.execute("INSERT INTO rf_versions(version) VALUES ('20261114-v2')")
            conn.commit()
        except Exception:
            conn.rollback()
            raise
    finally:
        conn.close()


def _rf_class_options(owner_id):
    rows = _rf_rows("SELECT id,race_class_name FROM race_classes WHERE owner_id=? ORDER BY race_class_name COLLATE NOCASE,id", (owner_id,))
    return [None] + [r["id"] for r in rows], ["(No selection)"] + [r["race_class_name"] for r in rows]


def _rf_class_select(owner_id, key, current=None):
    ids, labels = _rf_class_options(owner_id)
    current = current if current in ids else None
    return st.selectbox("Race Class", ids,
        index=None if key in st.session_state else ids.index(current),
        format_func=lambda value: labels[ids.index(value)], key=key)


def _rf_resolve_class(owner_id, checklist_id, value):
    if value is _RF_UNSET:
        if checklist_id is None:
            return None
        rows = _rf_rows("SELECT race_class_id FROM checklists WHERE owner_id=? AND id=?", (owner_id,checklist_id))
        return rows[0]["race_class_id"] if rows else None
    if value is not None and not _rf_rows("SELECT id FROM race_classes WHERE owner_id=? AND id=?", (owner_id,value)):
        raise ValueError("The selected race class does not belong to this account.")
    return value


def _rf_enrich(function):
    import functools
    @functools.wraps(function)
    def wrapped(owner_id, *args, **kwargs):
        records = function(owner_id, *args, **kwargs)
        rows = _rf_rows("""SELECT c.id,c.race_class_id,rc.race_class_name FROM checklists c
            LEFT JOIN race_classes rc ON rc.id=c.race_class_id AND rc.owner_id=c.owner_id
            WHERE c.owner_id=?""", (owner_id,))
        extra = {r["id"]:r for r in rows}
        for entry in records:
            value = extra.get(entry["id"], {})
            entry["race_class_id"] = value.get("race_class_id")
            entry["race_class_name"] = value.get("race_class_name") or ""
        return records
    return wrapped


def _rf_classes_page(owner_id):
    st.header("Race Classes")
    with st.form(f"rf_add_class_{owner_id}", clear_on_submit=True):
        name = st.text_input("New race class", max_chars=100)
        submitted = st.form_submit_button("Register Race Class")
    if submitted:
        if not name.strip():
            st.error("Enter a race-class name.")
        else:
            conn = _rf_db()
            try:
                with conn:
                    conn.execute("INSERT INTO race_classes(owner_id,race_class_name) VALUES (?,?)", (owner_id,name.strip()))
                st.rerun()
            except sqlite3.IntegrityError:
                st.error("This race class is already registered.")
            finally:
                conn.close()
    rows = _rf_rows("SELECT id,race_class_name FROM race_classes WHERE owner_id=? ORDER BY race_class_name", (owner_id,))
    for row in rows:
        with st.expander(row["race_class_name"]):
            with st.form(f"rf_rename_class_{owner_id}_{row['id']}"):
                name = st.text_input("Race-class name", value=row["race_class_name"], max_chars=100)
                rename = st.form_submit_button("Rename Race Class")
            if rename:
                if not name.strip():
                    st.error("Enter a race-class name.")
                    continue
                conn = _rf_db()
                try:
                    with conn:
                        conn.execute("UPDATE race_classes SET race_class_name=? WHERE owner_id=? AND id=?", (name.strip(),owner_id,row["id"]))
                    st.rerun()
                except sqlite3.IntegrityError:
                    st.error("This race class already exists.")
                finally:
                    conn.close()
    st.caption("Renaming preserves associations. Class deletion is not enabled.")










def _rf_templates_page(owner_id):
    _rtn_require_native()
    st.header('Race Templates')
    names = {r['id']: r['race_name'] for r in get_user_race_names(owner_id)}
    st.caption('Saving the same race name, date, and program number updates that template. Existing checklist records do not change.')
    with st.form(f'rf_template_form_{owner_id}'):
        name_id, name = _rtn_input(owner_id, f'rtn_create_{owner_id}')
        race_date = st.date_input('Race date', value=date.today(), min_value=date(1980, 1, 1), max_value=date(2100, 12, 31))
        program = st.number_input('Program number', min_value=1, max_value=12, value=1)
        distance = st.number_input('Distance (meters)', min_value=1, max_value=5000, value=1600, step=100)
        horses = st.number_input('Number of horses', min_value=1, max_value=18, value=18)
        class_id = _rf_class_select(owner_id, f'rf_template_class_{owner_id}')
        rf_template_venue_id = _rf_template_venue_input(owner_id)
        submitted = st.form_submit_button('Save Race Template')
    if submitted:
        try:
            _rf_save_template(owner_id, name_id, name, race_date, program, distance, horses, class_id, venue_id=rf_template_venue_id)
            st.success('Race template saved.')
        except (ValueError, sqlite3.Error) as error:
            st.error(f'Could not save template: {error}')
    rows = _rf_templates(owner_id)
    if rows:
        st.dataframe(pd.DataFrame([{'ID': r['id'], 'Date': r['race_date'], 'Race': r['race_name'] or '', 'Program': r['program_number'], 'Distance': r['distance'], 'Horses': r['number_of_horses'], 'Class': r['race_class_name'] or '', 'Venue': r.get('venue_name') or '(Not set)'} for r in rows]), hide_index=True, width='stretch')
    else:
        st.info('No race templates registered yet.')
    _rf_venue_existing_editor(owner_id)
    _rt_manage(owner_id)





def _rf_seeded_widget(widget_function, *args, **kwargs):
    key = kwargs.get("key")
    if key is not None and key in st.session_state:
        kwargs["value"] = None
    return widget_function(*args, **kwargs)




def _rf_loader(owner_id, mode, target_keys=None):
    notice = st.session_state.pop(f"rf_notice_{mode}_{owner_id}",None)
    error = st.session_state.pop(f"rf_error_{mode}_{owner_id}",None)
    if notice:
        st.success(notice)
    if error:
        st.error(error)
    with st.expander("Load Race Template", expanded=False):
        rows = _rf_templates(owner_id)
        if not rows:
            st.info("Create a race template from the Race Templates menu.")
            return
        lookup = {r["id"]:r for r in rows}
        selected = st.selectbox("Race template", [None]+list(lookup), format_func=lambda x: "(Select a template)" if x is None else _rf_label(lookup[x]), key=f"rf_loader_{mode}_{owner_id}")
        st.caption("Load replaces first-filter conditions with this race's settings and disables the second filter." if mode=="review" else "Load fills race fields. It does not save a checklist.")
        st.button("Load Race Template", key=f"rf_load_button_{mode}_{owner_id}", disabled=selected is None, on_click=_rf_load, args=(owner_id,selected,mode,target_keys))


def _rf_tags(text):
    tags = {}
    for part in text.split(","):
        value = part.strip()
        if not value:
            continue
        if len(value)>60:
            raise ValueError("Each tag must be 60 characters or fewer.")
        tags.setdefault(value.casefold(),value)
    if len(tags)>20:
        raise ValueError("Use no more than 20 tags.")
    return tags


def _rf_images(uploads):
    import io
    import warnings
    from pathlib import Path
    from PIL import Image, ImageOps
    if len(uploads)>6:
        raise ValueError("Upload no more than six images.")
    prepared, total = [], 0
    for upload in uploads:
        raw = upload.getvalue()
        if not raw or len(raw)>5*1024*1024:
            raise ValueError("Each image must be nonempty and no larger than 5 MB.")
        with warnings.catch_warnings():
            warnings.simplefilter("error", Image.DecompressionBombWarning)
            with Image.open(io.BytesIO(raw)) as image:
                if image.format not in {"JPEG","PNG","WEBP"} or image.width*image.height>20_000_000:
                    raise ValueError("Use JPEG/PNG/WebP images no larger than 20 megapixels.")
                image.verify()
            with Image.open(io.BytesIO(raw)) as original:
                image = ImageOps.exif_transpose(original)
                image.load()
                alpha = image.mode in {"RGBA","LA"} or "transparency" in image.info
                # A fresh image avoids retaining uploaded metadata.
                pixels = image.convert("RGBA" if alpha else "RGB")
                clean = Image.new(pixels.mode,pixels.size)
                clean.paste(pixels)
                output = io.BytesIO()
                clean.save(output,format="PNG" if alpha else "JPEG",**({} if alpha else {"quality":90}))
        data = output.getvalue()
        total += len(data)
        if total>20*1024*1024:
            raise ValueError("Combined processed images must not exceed 20 MB.")
        name = Path(upload.name.replace("\\","/").split("/")[-1]).stem[:160] or "image"
        prepared.append((name+(".png" if alpha else ".jpg"), "image/png" if alpha else "image/jpeg",data))
    return prepared


def _rf_save_post(owner_id,template_id,title,body,tag_text,uploads):
    title, body = title.strip(), body.strip()
    if not title or not body or len(title)>200 or len(body)>200_000:
        raise ValueError("Enter a title (1–200 characters) and article text (1–200,000 characters).")
    tags, images = _rf_tags(tag_text), _rf_images(uploads)
    _rf_template(owner_id,template_id)
    conn = _rf_db()
    try:
        with conn:
            if not conn.execute("SELECT 1 FROM rf_race_templates WHERE owner_id=? AND id=?", (owner_id,template_id)).fetchone():
                raise ValueError("Race template is unavailable.")
            post_id = conn.execute("INSERT INTO rf_blog_posts(owner_id,template_id,title,body) VALUES (?,?,?,?)", (owner_id,template_id,title,body)).lastrowid
            for normalized,name in tags.items():
                conn.execute("INSERT INTO rf_blog_tags(owner_id,name,normalized) VALUES (?,?,?) ON CONFLICT(owner_id,normalized) DO NOTHING", (owner_id,name,normalized))
                tag_id = conn.execute("SELECT id FROM rf_blog_tags WHERE owner_id=? AND normalized=?", (owner_id,normalized)).fetchone()["id"]
                conn.execute("INSERT INTO rf_blog_post_tags(post_id,tag_id) VALUES (?,?)", (post_id,tag_id))
            for name,mime,data in images:
                conn.execute("INSERT INTO rf_blog_images(owner_id,post_id,filename,mime_type,image_data) VALUES (?,?,?,?,?)", (owner_id,post_id,name,mime,sqlite3.Binary(data)))
        return post_id
    finally:
        conn.close()


def _rf_search(owner_id,query,tag_text,page=1):
    tags = _rf_tags(tag_text)
    clauses, args = ["p.owner_id=?"], [owner_id]
    if query.strip():
        clauses.append("""(instr(RF_CASEFOLD(p.title||' '||p.body),RF_CASEFOLD(?))>0 OR EXISTS (
            SELECT 1 FROM rf_blog_post_tags pt JOIN rf_blog_tags tg ON tg.id=pt.tag_id
            WHERE pt.post_id=p.id AND tg.owner_id=p.owner_id AND instr(tg.normalized,RF_CASEFOLD(?))>0))""")
        args.extend([query.strip(),query.strip()])
    for tag in tags:
        clauses.append("""EXISTS (SELECT 1 FROM rf_blog_post_tags pt JOIN rf_blog_tags tg ON tg.id=pt.tag_id
            WHERE pt.post_id=p.id AND tg.owner_id=p.owner_id AND tg.normalized=?)""")
        args.append(tag)
    where = " AND ".join(clauses)
    count = _rf_rows("SELECT COUNT(*) n FROM rf_blog_posts p WHERE "+where,args)[0]["n"]
    rows = _rf_rows("SELECT p.id,p.title,p.created_at FROM rf_blog_posts p WHERE "+where+" ORDER BY p.id DESC LIMIT 20 OFFSET ?", args+[max(0,page-1)*20])
    return count,rows


def _rf_blog_page(owner_id):
    _rb_page(owner_id)


def _review_page_size_without_duplicate_default(
    widget_function,
    *args,
    **kwargs,
):
    key = kwargs.get("key")

    if key is not None and key in st.session_state:
        # index=None supplies no competing default. Streamlit uses the
        # existing Session State value associated with this widget key.
        if len(args) >= 3:
            positional = list(args)
            positional[2] = None
            args = tuple(positional)
            kwargs.pop("index", None)
        else:
            kwargs["index"] = None

    return widget_function(*args, **kwargs)

def get_db_connection():
    os.makedirs("data", exist_ok=True)
    conn = sqlite3.connect(DB_PATH, timeout=30)
    conn.row_factory = sqlite3.Row
    conn.execute("PRAGMA busy_timeout = 30000")
    conn.execute("PRAGMA journal_mode = WAL")
    return conn


def init_db():
    conn = get_db_connection()
    cursor = conn.cursor()
    cursor.execute('\n        CREATE TABLE IF NOT EXISTS users (\n            id INTEGER PRIMARY KEY AUTOINCREMENT,\n            username TEXT UNIQUE NOT NULL,\n            display_name TEXT NOT NULL,\n            password TEXT NOT NULL\n        )\n    ')
    cursor.execute('\n        CREATE TABLE IF NOT EXISTS invitation_codes (\n            code TEXT PRIMARY KEY,\n            used INTEGER DEFAULT 0\n        )\n    ')
    cursor.execute('\n        CREATE TABLE IF NOT EXISTS horses (\n            id INTEGER PRIMARY KEY AUTOINCREMENT,\n            owner_id INTEGER NOT NULL,\n            horse_name TEXT NOT NULL,\n            UNIQUE(owner_id, horse_name),\n            FOREIGN KEY(owner_id) REFERENCES users(id)\n        )\n    ')
    cursor.execute('\n        CREATE TABLE IF NOT EXISTS horse_owners (\n            id INTEGER PRIMARY KEY AUTOINCREMENT,\n            owner_id INTEGER NOT NULL,\n            horse_owner_name TEXT NOT NULL,\n            UNIQUE(owner_id, horse_owner_name),\n            FOREIGN KEY(owner_id) REFERENCES users(id)\n        )\n    ')
    cursor.execute('\n        CREATE TABLE IF NOT EXISTS jockeys (\n            id INTEGER PRIMARY KEY AUTOINCREMENT,\n            owner_id INTEGER NOT NULL,\n            jockey_name TEXT NOT NULL,\n            UNIQUE(owner_id, jockey_name),\n            FOREIGN KEY(owner_id) REFERENCES users(id)\n        )\n    ')
    cursor.execute('\n        CREATE TABLE IF NOT EXISTS trainers (\n            id INTEGER PRIMARY KEY AUTOINCREMENT,\n            owner_id INTEGER NOT NULL,\n            trainer_name TEXT NOT NULL,\n            UNIQUE(owner_id, trainer_name),\n            FOREIGN KEY(owner_id) REFERENCES users(id)\n        )\n    ')
    cursor.execute('\n        CREATE TABLE IF NOT EXISTS breeding_farms (\n            id INTEGER PRIMARY KEY AUTOINCREMENT,\n            owner_id INTEGER NOT NULL,\n            breeding_farm_name TEXT NOT NULL,\n            UNIQUE(owner_id, breeding_farm_name),\n            FOREIGN KEY(owner_id) REFERENCES users(id)\n        )\n    ')
    cursor.execute('\n        CREATE TABLE IF NOT EXISTS stallions (\n            id INTEGER PRIMARY KEY AUTOINCREMENT,\n            owner_id INTEGER NOT NULL,\n            stallion_name TEXT NOT NULL,\n            UNIQUE(owner_id, stallion_name),\n            FOREIGN KEY(owner_id) REFERENCES users(id)\n        )\n    ')
    cursor.execute('\n        CREATE TABLE IF NOT EXISTS criteria (\n            id INTEGER PRIMARY KEY AUTOINCREMENT,\n            owner_id INTEGER NOT NULL,\n            criteria_name TEXT NOT NULL,\n            UNIQUE(owner_id, criteria_name),\n            FOREIGN KEY(owner_id) REFERENCES users(id)\n        )\n    ')
    cursor.execute('\n        CREATE TABLE IF NOT EXISTS venues (\n            id INTEGER PRIMARY KEY AUTOINCREMENT,\n            owner_id INTEGER NOT NULL,\n            venue_name TEXT NOT NULL,\n            UNIQUE(owner_id, venue_name),\n            FOREIGN KEY(owner_id) REFERENCES users(id)\n        )\n    ')
    cursor.execute('\n        CREATE TABLE IF NOT EXISTS race_names (\n            id INTEGER PRIMARY KEY AUTOINCREMENT,\n            owner_id INTEGER NOT NULL,\n            race_name TEXT NOT NULL,\n            UNIQUE(owner_id, race_name),\n            FOREIGN KEY(owner_id) REFERENCES users(id)\n        )\n    ')
    cursor.execute('\n        CREATE TABLE IF NOT EXISTS checklists (\n            id INTEGER PRIMARY KEY AUTOINCREMENT,\n            owner_id INTEGER NOT NULL,\n            horse_id INTEGER,\n            horse_owner_id INTEGER,\n            jockey_id INTEGER,\n            previous_jockey_id INTEGER,\n            trainer_id INTEGER,\n            breeding_farm_id INTEGER,\n            stallion_id INTEGER,\n            broodmare_sire_id INTEGER,\n            venue_id INTEGER,\n            previous_venue_id INTEGER,\n            race_name_id INTEGER,\n            distance INTEGER,\n            previous_distance INTEGER,\n            previous_race_date TEXT,\n            interval_days INTEGER,\n            weight_change REAL,\n            date_of_race TEXT,\n            memo TEXT,\n            finished_place TEXT,\n            checklist TEXT,\n            program_number INTEGER,\n            number_of_horses INTEGER,\n            odds REAL,\n            prize REAL,\n            bracket_number INTEGER,\n            horse_number INTEGER,\n            horse_weight REAL,\n            FOREIGN KEY(owner_id) REFERENCES users(id),\n            FOREIGN KEY(horse_id) REFERENCES horses(id),\n            FOREIGN KEY(horse_owner_id) REFERENCES horse_owners(id),\n            FOREIGN KEY(jockey_id) REFERENCES jockeys(id),\n            FOREIGN KEY(previous_jockey_id) REFERENCES jockeys(id),\n            FOREIGN KEY(trainer_id) REFERENCES trainers(id),\n            FOREIGN KEY(breeding_farm_id) REFERENCES breeding_farms(id),\n            FOREIGN KEY(stallion_id) REFERENCES stallions(id),\n            FOREIGN KEY(broodmare_sire_id) REFERENCES stallions(id),\n            FOREIGN KEY(venue_id) REFERENCES venues(id),\n            FOREIGN KEY(previous_venue_id) REFERENCES venues(id),\n            FOREIGN KEY(race_name_id) REFERENCES race_names(id)\n        )\n    ')
    cursor.execute('\n        CREATE TABLE IF NOT EXISTS saved_filters (\n            id INTEGER PRIMARY KEY AUTOINCREMENT,\n            owner_id INTEGER NOT NULL,\n            title TEXT NOT NULL,\n            filter_data TEXT NOT NULL,\n            created_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP,\n            UNIQUE(owner_id, title),\n            FOREIGN KEY(owner_id) REFERENCES users(id)\n        )\n    ')
    cursor.execute('PRAGMA table_info(checklists)')
    existing_columns = {row['name'] for row in cursor.fetchall()}
    required_columns = {'horse_owner_id': 'INTEGER', 'jockey_id': 'INTEGER', 'previous_jockey_id': 'INTEGER', 'trainer_id': 'INTEGER', 'breeding_farm_id': 'INTEGER', 'stallion_id': 'INTEGER', 'broodmare_sire_id': 'INTEGER', 'venue_id': 'INTEGER', 'previous_venue_id': 'INTEGER', 'race_name_id': 'INTEGER', 'distance': 'INTEGER', 'previous_distance': 'INTEGER', 'previous_race_date': 'TEXT', 'interval_days': 'INTEGER', 'weight_change': 'REAL', 'date_of_race': 'TEXT', 'memo': 'TEXT', 'finished_place': 'TEXT', 'checklist': 'TEXT', 'program_number': 'INTEGER', 'number_of_horses': 'INTEGER', 'odds': 'REAL', 'prize': 'REAL', 'bracket_number': 'INTEGER', 'horse_number': 'INTEGER', 'horse_weight': 'REAL'}
    for column_name, column_type in required_columns.items():
        if column_name not in existing_columns:
            cursor.execute(f'ALTER TABLE checklists ADD COLUMN {column_name} {column_type}')
    cursor.execute('\n        CREATE UNIQUE INDEX IF NOT EXISTS unique_owner_horse_date\n        ON checklists (owner_id, horse_id, date_of_race)\n    ')
    cursor.execute('\n        CREATE INDEX IF NOT EXISTS idx_checklists_owner_date\n        ON checklists (owner_id, date_of_race DESC)\n    ')
    cursor.execute('\n        CREATE INDEX IF NOT EXISTS idx_checklists_owner_interval\n        ON checklists (owner_id, interval_days)\n    ')
    cursor.execute('\n        CREATE INDEX IF NOT EXISTS idx_checklists_owner_previous_venue\n        ON checklists (owner_id, previous_venue_id)\n    ')
    cursor.execute('\n        CREATE INDEX IF NOT EXISTS idx_checklists_owner_weight_change\n        ON checklists (owner_id, weight_change)\n    ')
    cursor.execute('\n        CREATE INDEX IF NOT EXISTS idx_saved_filters_owner\n        ON saved_filters (owner_id, created_at DESC)\n    ')
    conn.commit()
    conn.close()
    _rf_migrate()
    _rf_venue_migrate()
    _rb_migrate()





# -------------------------------------------------
# Helpers
# -------------------------------------------------
def clean_text(value):
    if value is None:
        return ""

    if isinstance(value, float) and pd.isna(value):
        return ""

    return str(value).strip()


def safe_json_loads(value):
    if not value:
        return {}

    try:
        parsed = json.loads(value)
        return parsed if isinstance(parsed, dict) else {}
    except (json.JSONDecodeError, TypeError):
        return {}


def parse_race_date(value):
    if value is None or value == "":
        return None

    if isinstance(value, pd.Timestamp):
        return value.date()

    if isinstance(value, datetime):
        return value.date()

    if isinstance(value, date):
        return value

    date_text = clean_text(value)

    if not date_text:
        return None

    try:
        return datetime.fromisoformat(date_text).date()
    except (ValueError, TypeError):
        pass

    for fmt in ("%Y-%m-%d", "%Y/%m/%d", "%Y%m%d"):
        try:
            return datetime.strptime(date_text, fmt).date()
        except (ValueError, TypeError):
            continue

    return None


def normalize_date(date_val):
    parsed_date = parse_race_date(date_val)

    if parsed_date is not None:
        return parsed_date.isoformat()

    return None


def calculate_interval_days(date_of_race, previous_race_date):
    current_date = parse_race_date(date_of_race)
    previous_date = parse_race_date(previous_race_date)

    if current_date is None or previous_date is None:
        return None

    interval_days = (current_date - previous_date).days

    return interval_days if interval_days >= 0 else None


def to_optional_int(value):
    try:
        if value is None or pd.isna(value):
            return None

        value = int(float(value))
        return value if value > 0 else None
    except (ValueError, TypeError):
        return None


def to_optional_float(value):
    try:
        if value is None or pd.isna(value):
            return None

        value = float(value)
        return value if value > 0 else None
    except (ValueError, TypeError):
        return None


def to_optional_signed_float(value):
    try:
        if value is None or pd.isna(value):
            return None

        return float(value)
    except (ValueError, TypeError):
        return None


def parse_optional_int(value):
    value = clean_text(value)

    if not value:
        return None

    try:
        return int(float(value))
    except (ValueError, TypeError):
        return None


def parse_optional_float(value):
    value = clean_text(value)

    if not value:
        return None

    try:
        return float(value)
    except (ValueError, TypeError):
        return None


def parse_boolean(value):
    if isinstance(value, bool):
        return value

    if value is None or pd.isna(value):
        return False

    normalized = clean_text(value).lower()

    return normalized in {
        "1",
        "true",
        "t",
        "yes",
        "y",
        "on",
        "checked",
        "✓",
    }


def format_signed_number(value, decimal_places=1):
    if value is None:
        return ""

    value = float(value)

    if value.is_integer():
        return str(int(value))

    return f"{value:.{decimal_places}f}".rstrip("0").rstrip(".")


def make_options(items, label_key):
    labels = ["(No selection)"] + [item[label_key] for item in items]
    ids = [None] + [item["id"] for item in items]
    return labels, ids


def get_selected_id(options_ids, selected_index):
    if selected_index < 0 or selected_index >= len(options_ids):
        return None
    return options_ids[selected_index]


def format_yen(value):
    if value is None:
        return "N/A"

    return f"¥{value:,.0f}"


def get_paginated_items(items, page_number, page_size):
    if page_size <= 0:
        return items

    start_index = (page_number - 1) * page_size
    end_index = start_index + page_size

    return items[start_index:end_index]


