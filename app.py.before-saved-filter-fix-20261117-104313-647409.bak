# CURRENT_REVIEW_FILTER_DIAGNOSTICS_V1
def _current_review_filter_safe_value(value):
    import datetime
    import math

    if value is None or isinstance(value, (str, bool, int)):
        return value

    if isinstance(value, float):
        return value if math.isfinite(value) else str(value)

    if isinstance(value, (datetime.date, datetime.datetime)):
        return value.isoformat()

    if isinstance(value, (list, tuple, set, frozenset)):
        items = list(value)

        if isinstance(value, (set, frozenset)):
            items.sort(key=str)

        return [
            _current_review_filter_safe_value(item)
            for item in items
        ]

    if isinstance(value, dict):
        return {
            str(key): _current_review_filter_safe_value(item)
            for key, item in value.items()
        }

    return str(value)


def _current_review_filter_length(value):
    try:
        return len(value)
    except (TypeError, AttributeError):
        return None


def _current_review_filter_is_record_argument(name, value):
    normalized = name.lower()

    if normalized in {
        "checklists",
        "records",
        "entries",
        "rows",
        "data",
        "filtered_checklists",
        "first_filtered_checklists",
        "second_filtered_checklists",
    }:
        return True

    if "checklists" in normalized:
        return True

    if isinstance(value, (list, tuple)) and value:
        first = value[0]

        if isinstance(first, dict):
            return bool(
                {
                    "horse_id",
                    "horse_name",
                    "horse_weight",
                    "race_date",
                }.intersection(first)
            )

    return False


def _current_review_filter_trace(function):
    import functools
    import inspect

    signature = inspect.signature(function)

    @functools.wraps(function)
    def wrapped(*args, **kwargs):
        captures = st.session_state.get(
            "_current_review_filter_capture_stack",
            [],
        )

        if not captures:
            return function(*args, **kwargs)

        # Capture only actual function arguments, not an unrelated snapshot
        # of all Session State keys.
        bound = signature.bind(*args, **kwargs)
        bound.apply_defaults()

        supplied = {}
        source_counts = {}

        for name, value in bound.arguments.items():
            if _current_review_filter_is_record_argument(name, value):
                source_counts[name] = _current_review_filter_length(value)
                continue

            # User identity is not a filtering control to display here.
            if name in {"owner_id", "user_id"}:
                continue

            supplied[name] = _current_review_filter_safe_value(value)

        result = function(*args, **kwargs)

        captures[-1].append({
            "arguments": supplied,
            "source_counts": source_counts,
            "result_count": _current_review_filter_length(result),
        })

        return result

    return wrapped


def _current_review_filter_render(calls):
    import json
    with st.expander('Current Review Filters', expanded=False):
        st.caption('These are the actual arguments received by the checklist filtering function during this page render. Restored and default values are included.')
        if not calls:
            st.info('The filtering function has not run during this render. No current filter results were captured.')
            return
        for index, call in enumerate(calls, start=1):
            st.markdown(f'#### Filtering pass {index}')
            counts = call['source_counts']
            output_count = call['result_count']
            if counts:
                sources = '; '.join((f'{name}: ' + (f'{count:,}' if count is not None else 'count unavailable') for name, count in counts.items()))
                output_text = f'{output_count:,}' if output_count is not None else 'count unavailable'
                st.write(f'Input records — {sources}. Output records — {output_text}.')
                if len(counts) == 1:
                    input_count = next(iter(counts.values()))
                    if input_count is not None and output_count is not None and (output_count < input_count):
                        st.warning('This filtering pass reduced the number of records. Its supplied values are shown below.')
                    elif input_count is not None and output_count == input_count:
                        st.caption('This pass did not reduce the record count. Conditions may still be enabled.')
            else:
                st.write('Output records: ' + (f'{output_count:,}' if output_count is not None else 'count unavailable'))
            arguments = call['arguments']
            rows = [{'Filter argument': name, 'Value received': json.dumps(value, ensure_ascii=False, sort_keys=True, default=str)} for name, value in arguments.items()]
            if rows:
                st.table(rows)
            else:
                st.info('No separate filter arguments were supplied.')
        st.caption('Read enable/apply switches together with their associated values. A stored range is not necessarily applied when its switch is false. Null values, empty lists, and default bounds are shown rather than guessed to be active or inactive.')
        st.caption('These counts describe calls to filter_checklists, not the number of rows visible on the current pagination page. The input may already be restricted by database loading or earlier application logic.')



# CURRENT_FILTER_VISIBILITY_BELOW_HEADER_V1
def _current_review_filter_place_panel():
    stack = st.session_state.get(
        "_current_review_filter_capture_stack",
        [],
    )

    if stack:
        stack[-1].panel = st.container()


def _current_review_filter_page(function):
    import functools

    @functools.wraps(function)
    def wrapped(*args, **kwargs):
        class ReviewFilterCalls(list):
            pass

        calls = ReviewFilterCalls()
        calls.panel = None

        state_key = "_current_review_filter_capture_stack"
        stack = st.session_state.get(state_key)

        if stack is None:
            stack = []
            st.session_state[state_key] = stack

        stack.append(calls)

        try:
            return function(*args, **kwargs)
        finally:
            if stack and stack[-1] is calls:
                stack.pop()

            # The original review function reserves this container directly
            # after its header. Do not create a fallback above the header.
            if calls.panel is not None:
                with calls.panel:
                    _current_review_filter_render(calls)

    return wrapped


@_current_review_filter_trace
def filter_checklists(checklists, selected_filters, selected_venue_ids, criteria_filters, criteria_mode, distance_from, distance_to, previous_distance_from, previous_distance_to, interval_days_from, interval_days_to, weight_change_from, weight_change_to, date_from, date_to, memo_keyword, program_number, number_of_horses, finished_places, exclude_finished_places, odds_from, odds_to, prize_from, prize_to, enable_bracket_filter, bracket_from, bracket_to, enable_horse_filter, horse_from, horse_to, enable_weight_filter, weight_from, weight_to, enable_weight_change_filter=False, enable_distance_filter=False, enable_previous_distance_filter=False, enable_interval_days_filter=False):
    filtered = []
    for entry in checklists:
        matches = True
        for field_name, selected_id in selected_filters.items():
            if selected_id is not None and entry.get(field_name) != selected_id:
                matches = False
                break
        if not matches:
            continue
        if selected_venue_ids and entry.get('venue_id') not in selected_venue_ids:
            continue
        entry_date = parse_race_date(entry.get('date_of_race'))
        if date_from and (entry_date is None or entry_date < date_from):
            continue
        if date_to and (entry_date is None or entry_date > date_to):
            continue
        checklist_map = entry.get('checklist') or {}
        if criteria_filters:
            if criteria_mode == 'AND':
                if not all((checklist_map.get(item, False) for item in criteria_filters)):
                    continue
            elif criteria_mode == 'OR':
                if not any((checklist_map.get(item, False) for item in criteria_filters)):
                    continue
            elif criteria_mode == 'NOT matched by criteria':
                if any((checklist_map.get(item, False) for item in criteria_filters)):
                    continue
        if enable_distance_filter:
            distance_value = entry.get('distance')
            if distance_value is None:
                continue
            if distance_value < distance_from or distance_value > distance_to:
                continue
        if enable_previous_distance_filter:
            previous_distance_value = entry.get('previous_distance')
            if previous_distance_value is None:
                continue
            if previous_distance_value < previous_distance_from or previous_distance_value > previous_distance_to:
                continue
        if enable_interval_days_filter:
            interval_days_value = entry.get('interval_days')
            if interval_days_value is None:
                continue
            if interval_days_value < interval_days_from or interval_days_value > interval_days_to:
                continue
        if enable_weight_change_filter:
            weight_change_value = entry.get('weight_change')
            if weight_change_value is None:
                continue
            if weight_change_value < weight_change_from or weight_change_value > weight_change_to:
                continue
        if memo_keyword.strip():
            keyword = memo_keyword.strip().lower()
            searchable_text = ' | '.join([clean_text(entry.get('memo')).lower(), clean_text(entry.get('horse_name')).lower(), clean_text(entry.get('horse_owner_name')).lower(), clean_text(entry.get('jockey_name')).lower(), clean_text(entry.get('previous_jockey_name')).lower(), clean_text(entry.get('trainer_name')).lower(), clean_text(entry.get('breeding_farm_name')).lower(), clean_text(entry.get('stallion_name')).lower(), clean_text(entry.get('broodmare_sire_name')).lower(), clean_text(entry.get('venue_name')).lower(), clean_text(entry.get('previous_venue_name')).lower(), clean_text(entry.get('race_name')).lower()])
            if keyword not in searchable_text:
                continue
        if program_number > 0:
            if entry.get('program_number') != program_number:
                continue
        if number_of_horses > 0:
            if entry.get('number_of_horses') != number_of_horses:
                continue
        entry_finished_place = clean_text(entry.get('finished_place'))
        if finished_places and entry_finished_place not in finished_places:
            continue
        if exclude_finished_places and entry_finished_place in exclude_finished_places:
            continue
        odds_value = entry.get('odds')
        if odds_value is None:
            if odds_from > 0:
                continue
        elif odds_value < odds_from or odds_value > odds_to:
            continue
        prize_value = entry.get('prize')
        if prize_value is None:
            if prize_from > 0:
                continue
        elif prize_value < prize_from or prize_value > prize_to:
            continue
        if enable_bracket_filter:
            bracket_value = entry.get('bracket_number')
            if bracket_value is None:
                continue
            if bracket_value < bracket_from or bracket_value > bracket_to:
                continue
        if enable_horse_filter:
            horse_number_value = entry.get('horse_number')
            if horse_number_value is None:
                continue
            if horse_number_value < horse_from or horse_number_value > horse_to:
                continue
        if enable_weight_filter:
            horse_weight_value = entry.get('horse_weight')
            if horse_weight_value is None:
                continue
            if horse_weight_value < weight_from or horse_weight_value > weight_to:
                continue
        filtered.append(entry)
    return filtered



# REVIEW_ARROW_TYPES_AND_WIDTH_FIX_V1
def _review_arrow_safe_summary(dataframe):
    # This function receives a newly created display dataframe.
    # It does not modify the underlying checklist records.
    if dataframe.empty:
        return dataframe

    numeric_columns = {
        "ID",
        "Days Since Last Race",
        "Distance",
        "Previous Distance",
        "Weight Change (kg)",
        "Horse Weight (kg)",
        "Odds",
        "Program Number",
        "Number of Horses",
        "Bracket Number",
        "Horse Number",
    }

    for column in dataframe.columns:
        if column in numeric_columns:
            numeric = pd.to_numeric(
                dataframe[column],
                errors="coerce",
            )

            # Keep non-finite values out of numeric display columns.
            numeric = numeric.mask(
                numeric.isin([float("inf"), float("-inf")])
            )

            if column == "ID":
                valid = numeric.dropna()

                if valid.empty or (valid % 1 == 0).all():
                    dataframe[column] = numeric.astype("Int64")
                else:
                    dataframe[column] = numeric.astype("Float64")
            else:
                dataframe[column] = numeric.astype("Float64")

        else:
            # Finishing positions remain text so nonnumeric race outcomes
            # are preserved. Currency-formatted prize text also stays text.
            dataframe[column] = (
                dataframe[column]
                .astype("string")
                .fillna("")
            )

    return dataframe

# REVIEW_TABLE_TALLER_AND_REFERENCE_COLUMNS_V1
# REVIEW_MATCHED_TABLE_MEMO_V1
def build_summary_dataframe(checklists):
    summary_rows = []
    for entry in checklists:
        checked_criteria = [key for key, value in (entry.get('checklist') or {}).items() if value]
        summary_rows.append({'ID': entry['id'], 'Date': entry.get('date_of_race') or '', 'Previous Race Date': entry.get('previous_race_date') or '', 'Days Since Last Race': entry.get('interval_days') if entry.get('interval_days') is not None else '', 'Bracket Number': entry.get('bracket_number'), 'Horse Number': entry.get('horse_number'), 'Horse': entry.get('horse_name') or '', 'Memo': '' if entry.get('memo') is None else str(entry.get('memo')), 'Horse Owner': entry.get('horse_owner_name') or '', 'Jockey': entry.get('jockey_name') or '', 'Trainer': entry.get('trainer_name') or '', 'Breeding Farm': entry.get('breeding_farm_name') or '', 'Stallion': entry.get('stallion_name') or '', 'Race': entry.get('race_name') or '', 'Venue': entry.get('venue_name') or '', 'Previous Venue': entry.get('previous_venue_name') or '', 'Distance': entry.get('distance') or '', 'Previous Distance': entry.get('previous_distance') or '', 'Weight Change (kg)': format_signed_number(entry.get('weight_change')), 'Horse Weight (kg)': entry.get('horse_weight') or '', 'Place': entry.get('finished_place') or '', 'Odds': entry.get('odds') if entry.get('odds') is not None else '', 'Prize (¥)': f"¥{entry.get('prize'):,.0f}" if entry.get('prize') is not None else '', 'Criteria': ' | '.join(checked_criteria), 'Race Class': entry.get('race_class_name') or ''})
    return _review_arrow_safe_summary(pd.DataFrame(summary_rows))






def calculate_review_metrics(filtered_checklists):
    completed = [
        entry
        for entry in filtered_checklists
        if clean_text(entry.get("finished_place")).isdigit()
    ]

    first = [
        entry
        for entry in completed
        if int(clean_text(entry.get("finished_place"))) == 1
    ]

    within_3 = [
        entry
        for entry in completed
        if int(clean_text(entry.get("finished_place"))) in (1, 2, 3)
    ]

    odds_values = [
        entry["odds"]
        for entry in within_3
        if isinstance(entry.get("odds"), (int, float))
    ]

    prize_values = [
        entry["prize"]
        for entry in within_3
        if isinstance(entry.get("prize"), (int, float))
    ]

    horse_weight_values = [
        entry["horse_weight"]
        for entry in within_3
        if isinstance(entry.get("horse_weight"), (int, float))
    ]

    distance_values = [
        entry["distance"]
        for entry in within_3
        if isinstance(entry.get("distance"), (int, float))
    ]

    interval_days_values = [
        entry["interval_days"]
        for entry in within_3
        if isinstance(entry.get("interval_days"), (int, float))
    ]

    return {
        "total": len(filtered_checklists),
        "completed": len(completed),
        "win_rate": (
            len(first) / len(completed) * 100
            if completed
            else None
        ),
        "top_3_rate": (
            len(within_3) / len(completed) * 100
            if completed
            else None
        ),
        "average_top_3_odds": (
            sum(odds_values) / len(odds_values)
            if odds_values
            else None
        ),
        "average_top_3_prize": (
            sum(prize_values) / len(prize_values)
            if prize_values
            else None
        ),
        "average_top_3_distance": (
            sum(distance_values) / len(distance_values)
            if distance_values
            else None
        ),
        "average_top_3_interval_days": (
            sum(interval_days_values) / len(interval_days_values)
            if interval_days_values
            else None
        ),
        "average_top_3_weight": (
            sum(horse_weight_values) / len(horse_weight_values)
            if horse_weight_values
            else None
        ),
    }


