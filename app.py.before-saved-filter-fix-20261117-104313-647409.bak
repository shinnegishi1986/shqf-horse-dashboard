# App routing
# -------------------------------------------------
# PERSISTENT_LOGIN_DATABASE_TOKEN_V1
def _persistent_login_initialize():
    conn = get_db_connection()

    try:
        conn.execute(
            """
            CREATE TABLE IF NOT EXISTS persistent_login_tokens (
                token_hash TEXT PRIMARY KEY,
                owner_id INTEGER NOT NULL,
                password_version TEXT NOT NULL,
                created_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP,
                FOREIGN KEY(owner_id) REFERENCES users(id)
            )
            """
        )
        conn.commit()
    finally:
        conn.close()


def _persistent_login_digest(value):
    import hashlib

    return hashlib.sha256(value.encode("utf-8")).hexdigest()


def _persistent_login_component():
    from pathlib import Path
    import streamlit.components.v1 as components

    return components.declare_component(
        "horse_checklist_persistent_login_v1",
        path=str(
            Path(__file__).resolve().parent
            / "_persistent_login_component"
        ),
    )


def _persistent_login_cookie_name():
    # Different local application directories get different cookie names.
    from pathlib import Path

    application_id = _persistent_login_digest(
        str(Path(__file__).resolve())
    )[:12]

    return f"horse_checklist_login_{application_id}"


def _persistent_login_revoke(token):
    if not token:
        return

    conn = get_db_connection()

    try:
        conn.execute(
            """
            DELETE FROM persistent_login_tokens
            WHERE token_hash = ?
            """,
            (_persistent_login_digest(token),),
        )
        conn.commit()
    finally:
        conn.close()


def _persistent_login_lookup(token):
    if not isinstance(token, str) or not 40 <= len(token) <= 128:
        return None

    conn = get_db_connection()

    try:
        row = conn.execute(
            """
            SELECT
                users.id,
                users.display_name,
                users.password,
                persistent_login_tokens.password_version
            FROM persistent_login_tokens
            JOIN users
                ON users.id = persistent_login_tokens.owner_id
            WHERE persistent_login_tokens.token_hash = ?
            """,
            (_persistent_login_digest(token),),
        ).fetchone()

        if row is None:
            return None

        if (
            _persistent_login_digest(row["password"])
            != row["password_version"]
        ):
            conn.execute(
                """
                DELETE FROM persistent_login_tokens
                WHERE token_hash = ?
                """,
                (_persistent_login_digest(token),),
            )
            conn.commit()
            return None

        return {
            "id": row["id"],
            "display_name": row["display_name"],
        }
    finally:
        conn.close()


def _persistent_login_issue(owner_id):
    import secrets

    _persistent_login_initialize()

    old_token = st.session_state.get("_persistent_login_token")
    _persistent_login_revoke(old_token)

    token = secrets.token_urlsafe(48)
    conn = get_db_connection()

    try:
        user = conn.execute(
            "SELECT password FROM users WHERE id = ?",
            (owner_id,),
        ).fetchone()

        if user is None:
            raise ValueError("The user account no longer exists.")

        conn.execute(
            """
            INSERT INTO persistent_login_tokens (
                token_hash,
                owner_id,
                password_version
            )
            VALUES (?, ?, ?)
            """,
            (
                _persistent_login_digest(token),
                owner_id,
                _persistent_login_digest(user["password"]),
            ),
        )
        conn.commit()
    finally:
        conn.close()

    st.session_state["_persistent_login_token"] = token
    st.session_state["_persistent_login_pending"] = {
        "operation": "set",
        "token": token,
        "request_id": secrets.token_hex(16),
    }


def _persistent_login_logout():
    import secrets

    _persistent_login_revoke(
        st.session_state.get("_persistent_login_token")
    )

    st.session_state.clear()

    st.session_state["_persistent_login_pending"] = {
        "operation": "delete",
        "token": "",
        "request_id": secrets.token_hex(16),
    }


def _persistent_login_bootstrap():
    import secrets

    _persistent_login_initialize()

    if "_persistent_login_read_request" not in st.session_state:
        st.session_state["_persistent_login_read_request"] = (
            secrets.token_hex(16)
        )

    pending = st.session_state.get("_persistent_login_pending")

    request = pending or {
        "operation": "read",
        "token": "",
        "request_id": st.session_state[
            "_persistent_login_read_request"
        ],
    }

    component = _persistent_login_component()

    result = component(
        cookie_name=_persistent_login_cookie_name(),
        operation=request["operation"],
        token=request["token"],
        request_id=request["request_id"],
        key="_persistent_login_cookie_bridge",
        default=None,
    )

    # Wait for the browser's acknowledgement rather than restoring login
    # from a stale component return value.
    if (
        not isinstance(result, dict)
        or result.get("request_id") != request["request_id"]
    ):
        st.info("Restoring login session…")
        st.stop()

    if result.get("error"):
        st.warning(
            "Persistent login storage is unavailable in this browser. "
            "Your current login can still be used, but another login "
            "may be required after a reload."
        )

    if pending:
        st.session_state.pop("_persistent_login_pending", None)

        if pending["operation"] == "delete":
            st.session_state["logged_in"] = False
            st.session_state.pop("_persistent_login_token", None)
            return

        # A successfully authenticated user can keep using the current
        # session even if the browser refuses persistent cookie storage.
        token = pending["token"]
    else:
        token = (
            st.session_state.get("_persistent_login_token")
            or result.get("token", "")
        )

    user = _persistent_login_lookup(token)

    if user is None:
        st.session_state["logged_in"] = False
        st.session_state.pop("user_id", None)
        st.session_state.pop("display_name", None)
        st.session_state.pop("_persistent_login_token", None)
        return

    st.session_state["logged_in"] = True
    st.session_state["user_id"] = user["id"]
    st.session_state["display_name"] = user["display_name"]
    st.session_state["_persistent_login_token"] = token

def render_login_page():
    st.title('Horse Checklist App')
    login_tab, register_tab = st.tabs(['Login', 'Register'])
    with login_tab:
        with st.form('login_form'):
            username = st.text_input('Username')
            password = st.text_input('Password', type='password')
            login_clicked = st.form_submit_button('Login')
        if login_clicked:
            success, display_name, user_id = login_user(username, password)
            if success:
                st.session_state.logged_in = True
                st.session_state.display_name = display_name
                st.session_state.user_id = user_id
                st.session_state['app_navigation_page'] = 'Checklist Review'
                _persistent_login_issue(user_id)
                st.rerun()
            else:
                st.error('Invalid username or password.')
    with register_tab:
        with st.form('register_form', clear_on_submit=True):
            username = st.text_input('Username', key='register_username')
            display_name = st.text_input('Display Name')
            password = st.text_input('Password', type='password', key='register_password')
            password_confirm = st.text_input('Confirm Password', type='password')
            invitation_code = st.text_input('Invitation Code')
            register_clicked = st.form_submit_button('Register')
        if register_clicked:
            username = clean_text(username)
            display_name = clean_text(display_name)
            invitation_code = clean_text(invitation_code)
            if not username or not display_name or (not password) or (not invitation_code):
                st.error('Please complete all fields.')
            elif password != password_confirm:
                st.error('Passwords do not match.')
            else:
                success, message = register_user(username, display_name, password, invitation_code)
                if success:
                    st.success(message)
                else:
                    st.error(message)




# REVIEW_FIRST_REMOVE_LIGHTWEIGHT_MODE_V1
# THREE_ADDITIONAL_PRIZE_PAGES_V1
_MPX_PERIODS = ['Month', '3 months', '6 months', 'Annual (calendar year)']

_MPX_CONFIG = {'stallion': ('Stallion', 'Stallions', 'stallions', 'stallion_name', 'stallion_id'), 'breedingfarm': ('Breeding Farm', 'Breeding Farms', 'breeding_farms', 'breeding_farm_name', 'breeding_farm_id'), 'criteria': ('Checklist Criterion', 'Checklist Criteria', 'criteria', 'criteria_name', None)}

def _mpx_labels(rows):
    from collections import Counter
    cleaned = [(row['id'], str(row['name']).strip()) for row in rows if row['name'] is not None and str(row['name']).strip()]
    counts = Counter((name for _, name in cleaned))
    result, used = ({}, set())
    for key, name in cleaned:
        candidate = name if counts[name] == 1 else f'{name} [#{key}]'
        while candidate in used:
            candidate += f' [#{key}]'
        result[key] = candidate
        used.add(candidate)
    return result

def _mpx_fetch(owner_id, kind):
    _, _, table, column, field = _MPX_CONFIG[kind]
    conn = get_db_connection()
    try:
        refs = [dict(row) for row in conn.execute(f'SELECT id, "{column}" AS name FROM "{table}" WHERE owner_id = ? ORDER BY "{column}" COLLATE NOCASE, id', (owner_id,)).fetchall()]
        venues = [dict(row) for row in conn.execute('SELECT id, venue_name AS name FROM venues WHERE owner_id = ?', (owner_id,)).fetchall()]
        reference = f'"{field}"' if field else 'NULL'
        records = [dict(row) for row in conn.execute(f'SELECT id, date_of_race, prize, venue_id, checklist, {reference} AS reference_id FROM checklists WHERE owner_id = ?', (owner_id,)).fetchall()]
    finally:
        conn.close()
    return (_mpx_labels(refs), {row['id']: str(row['name']) for row in refs if row['name'] is not None}, _mpx_labels(venues), records)

def _mpx_checked(value):
    if isinstance(value, str):
        return value.strip().casefold() in {'1', 'true', 't', 'yes', 'y', 'on', 'checked'}
    return value is True or (not isinstance(value, bool) and isinstance(value, (int, float)) and (value == 1))

def _mpx_prepare(records, refs, raw_names, venues, chosen, first, end, kind):
    import json
    import math
    from collections import defaultdict
    selected = set(chosen)
    values = defaultdict(list)
    counts = defaultdict(int)
    stats = {'valid': 0, 'missing': 0, 'invalid': 0, 'invalid_dates': 0}
    criterion_ids = {raw_names[key]: key for key in selected} if kind == 'criteria' else {}
    for record in records:
        if kind == 'criteria':
            saved = record.get('checklist')
            if isinstance(saved, str):
                try:
                    saved = json.loads(saved)
                except (ValueError, TypeError):
                    saved = {}
            if not isinstance(saved, dict):
                saved = {}
            matched = [criterion_ids[name] for name, value in saved.items() if name in criterion_ids and _mpx_checked(value)]
        else:
            key = record.get('reference_id')
            matched = [key] if key in selected else []
        if not matched:
            continue
        racedate = parse_race_date(record.get('date_of_race'))
        if racedate is None:
            stats['invalid_dates'] += len(matched)
            continue
        if not first <= racedate < end:
            continue
        raw_prize = record.get('prize')
        if raw_prize is None or (isinstance(raw_prize, str) and (not raw_prize.strip())):
            stats['missing'] += len(matched)
            continue
        try:
            if isinstance(raw_prize, bool):
                raise ValueError('Boolean prize')
            prize = float(raw_prize)
            if not math.isfinite(prize) or prize < 0:
                raise ValueError('Invalid prize')
        except (TypeError, ValueError, OverflowError):
            stats['invalid'] += len(matched)
            continue
        venue = venues.get(record.get('venue_id'), '(No venue)')
        for key in matched:
            values[key, venue].append(prize)
            counts[key, venue] += 1
            stats['valid'] += 1
    amounts = {key: math.fsum(items) for key, items in values.items()}
    total_parts = defaultdict(list)
    for (key, _), amount in amounts.items():
        total_parts[key].append(amount)
    totals = {key: math.fsum(total_parts[key]) for key in chosen}
    grand_total = math.fsum(totals.values())
    if not math.isfinite(grand_total):
        raise ValueError('The recorded prize total exceeds the supported numeric range.')
    order = sorted(chosen, key=lambda key: (-totals[key], refs[key].casefold(), key))
    venue_order = sorted({venue for _, venue in amounts}, key=lambda value: (value.casefold(), value))
    stats.update(total=grand_total, venues=len(venue_order), entity_order=[refs[key] for key in order], venue_order=venue_order)
    label = _MPX_CONFIG[kind][0]
    total_column = 'Attributed Prize (JPY)' if kind == 'criteria' else 'Total Prize (JPY)'
    count_column = 'Criterion matches' if kind == 'criteria' else 'Valid-prize checklists'
    chart_rows = []
    table_rows = []
    for key in order:
        table_row = {label: refs[key], total_column: totals[key], count_column: sum((counts[key, venue] for venue in venue_order))}
        for venue in venue_order:
            amount = amounts.get((key, venue), 0.0)
            table_row[f'Venue: {venue}'] = amount
            if (key, venue) in amounts:
                chart_rows.append({'entity': refs[key], 'venue': venue, 'prize': amount, 'entity_total': totals[key], 'checklists': counts[key, venue]})
        table_rows.append(table_row)
    return (chart_rows, table_rows, stats)

def _mpx_page(kind):
    import calendar
    from datetime import datetime, timedelta
    from zoneinfo import ZoneInfo
    import pandas as pd
    owner_id = st.session_state.user_id
    label, plural, _, _, _ = _MPX_CONFIG[kind]
    prefix = f'mpx_{kind}_{owner_id}_'
    st.header(f'Prize a Month — {plural}')
    now = datetime.now(ZoneInfo('Asia/Tokyo'))
    first_col, second_col = st.columns(2)
    with first_col:
        year = int(st.number_input('Year', min_value=1980, max_value=2100, value=now.year, step=1, key=prefix + 'year'))
    with second_col:
        month = int(st.selectbox('Month', list(range(1, 13)), index=now.month - 1, format_func=lambda number: calendar.month_name[number], key=prefix + 'month'))
    period = st.radio('Data period', _MPX_PERIODS, horizontal=True, key=prefix + 'period')
    refs, raw_names, venues, records = _mpx_fetch(owner_id, kind)
    if not refs:
        st.info(f'No {plural.lower()} are registered for this account.')
        return
    options = sorted(refs, key=lambda key: (refs[key].casefold(), key))
    choices = st.multiselect(f'Compare {plural.lower()}', [None] + options, default=[None], format_func=lambda key: f'All {plural.lower()}' if key is None else refs[key], key=prefix + 'selection', help='All includes every registered item. Remove All to compare only individually selected items.')
    chosen = options if None in choices else choices
    if not chosen:
        st.info(f'Select at least one {label.lower()}.')
        return
    first, end = _mp_dates(year, month, period)
    try:
        chart_rows, table_rows, stats = _mpx_prepare(records, refs, raw_names, venues, chosen, first, end, kind)
    except (ValueError, OverflowError) as error:
        st.error(str(error))
        return
    chart = _mpx_criteria_chart if kind == 'criteria' else _mpx_chart
    chart(chart_rows, stats, label, kind, year, month, period=period)
    st.subheader('Venue breakdown')
    table = pd.DataFrame(table_rows)
    st.dataframe(table, hide_index=True, width='stretch', height=480)
    last = end - timedelta(days=1)
    st.download_button('Download comparison CSV', data=table.to_csv(index=False).encode('utf-8-sig'), file_name=f'prize_{kind}_{first.isoformat()}_to_{last.isoformat()}.csv', mime='text/csv', key=prefix + 'csv')

def _mpx_chart(chart_rows, stats, label, kind, year, month, *, period='Month'):
    import json
    from datetime import timedelta
    import streamlit.components.v1 as components
    first, end = _mp_dates(year, month, period)
    last = end - timedelta(days=1)
    entities = list(stats['entity_order'])
    if not entities:
        return
    payload = json.dumps({'rows': chart_rows, 'entities': entities, 'venues': list(stats['venue_order']), 'label': label, 'period': period, 'dates': f'{first.isoformat()} — {last.isoformat()}', 'total': stats['total'], 'valid': stats['valid'], 'missing': stats['missing'], 'invalid': stats['invalid'], 'invalid_dates': stats['invalid_dates']}, ensure_ascii=True, allow_nan=False)
    payload = payload.replace('<', '\\u003c').replace('>', '\\u003e').replace('&', '\\u0026')
    html = '<!doctype html>\n<html lang="en">\n<head>\n<meta charset="utf-8">\n<meta name="viewport" content="width=device-width,initial-scale=1">\n<meta name="color-scheme" content="dark">\n<style>\n:root{\n  color-scheme:dark;\n  --bg:#0b1120;--panel:#111b2e;--raised:#17243b;\n  --line:#27354d;--fg:#edf3ff;--muted:#9aacc7;\n  --accent:#8ba9ff;\n}\n*{box-sizing:border-box}\n[hidden]{display:none!important}\nhtml,body{\n  margin:0;background:var(--bg);color:var(--fg);\n  font-family:Inter,ui-sans-serif,system-ui,-apple-system,\n    BlinkMacSystemFont,"Segoe UI",sans-serif;\n  -webkit-text-size-adjust:100%;\n  font-variant-numeric:tabular-nums;\n}\nbody{\n  padding:18px 18px 28px;\n  -webkit-overflow-scrolling:touch;\n}\n.header{\n  display:flex;justify-content:space-between;\n  gap:12px;align-items:flex-start;margin-bottom:18px;\n}\n.eyebrow{\n  font-size:10px;letter-spacing:.16em;\n  font-weight:700;color:var(--accent);margin-bottom:6px;\n}\n.title{\n  font-size:22px;font-weight:650;letter-spacing:-.025em;\n}\n.subtitle{\n  font-size:12px;color:var(--muted);\n  margin-top:7px;line-height:1.5;\n}\nbutton,select{\n  font:inherit;color:inherit;\n  border:1px solid var(--line);\n  background:var(--panel);border-radius:9px;\n  min-height:44px;padding:8px 12px;\n  touch-action:manipulation;font-size:14px;\n}\nselect{font-size:16px}\nbutton{cursor:pointer}\nbutton:disabled{opacity:.35;cursor:default}\nbutton:hover:not(:disabled){\n  border-color:#55729e;background:var(--raised);\n}\nbutton:focus-visible,select:focus-visible{\n  outline:2px solid #a6baff;outline-offset:3px;\n}\n.metrics{\n  display:grid;grid-template-columns:repeat(4,minmax(0,1fr));\n  gap:10px;margin-bottom:20px;\n}\n.metric{\n  text-align:left;min-height:95px;padding:15px;\n  background:linear-gradient(145deg,#14213a,#101a2d);\n  border-radius:13px;\n}\n.metric-label{\n  display:block;font-size:11px;font-weight:500;\n  color:var(--muted);margin-bottom:11px;\n}\n.metric-value{\n  display:block;font-size:clamp(17px,2.4vw,25px);\n  font-weight:650;letter-spacing:-.03em;\n  overflow-wrap:anywhere;\n}\n.metric:first-child{border-color:#3a547e}\n.metric:first-child .metric-value{color:#bbccff}\n.chart-panel{\n  border:1px solid var(--line);border-radius:14px;\n  padding:14px;background:var(--panel);\n}\n.chart-heading{\n  display:flex;justify-content:space-between;\n  align-items:center;gap:12px;\n}\n.section-title{font-size:14px;font-weight:650}\n.micro{\n  font-size:11px;line-height:1.5;color:var(--muted);\n}\n.quality{\n  font-size:11px;color:#b8c7e3;\n  background:transparent;border:none;\n  min-height:36px;padding:4px 6px;\n}\n#legend{\n  display:flex;flex-wrap:wrap;\n  gap:8px 14px;margin:14px 0 8px;\n}\n.legend-item{\n  display:inline-flex;align-items:center;gap:6px;\n  color:#bdcbe0;font-size:11px;overflow-wrap:anywhere;\n}\n.swatch{\n  display:inline-block;width:8px;height:8px;\n  border-radius:3px;flex-shrink:0;\n}\n.toolbar{\n  display:flex;flex-wrap:wrap;align-items:center;\n  justify-content:space-between;gap:10px;\n  margin:12px 0 6px;padding-top:12px;\n  border-top:1px solid var(--line);\n}\n.navigation{\n  display:flex;align-items:center;gap:8px;\n}\n.navigation button{min-width:44px;padding:8px}\n.size-label{\n  display:flex;gap:8px;align-items:center;\n  color:var(--muted);font-size:11px;\n}\n.size-label select{min-width:70px}\n.footer{\n  margin-top:12px;border-top:1px solid var(--line);\n  padding-top:12px;\n}\n#axis{display:block;width:100%;height:28px}\n.bar-row{\n  padding:9px 0 11px;border-top:1px solid #1c2a40;\n}\n.row-head{\n  display:flex;align-items:center;\n  justify-content:space-between;gap:10px;\n}\n.name{\n  flex:1;display:flex;gap:10px;align-items:center;\n  text-align:left;min-width:0;border:none;\n  background:transparent;padding:0;min-height:44px;\n}\n.name:hover:not(:disabled){\n  background:transparent;border-color:transparent;\n}\n.rank{\n  font-size:11px;width:23px;\n  color:#7087a9;flex-shrink:0;\n}\n.entity-name{\n  font-size:13px;font-weight:550;overflow-wrap:anywhere;\n}\n.row-total{\n  text-align:right;font-size:13px;font-weight:650;\n  max-width:45%;overflow-wrap:anywhere;\n}\n.bar{\n  display:block;width:100%;height:34px;touch-action:pan-y;\n}\n.segment{cursor:pointer}\n.segment:focus{\n  outline:none;stroke:#e9f1ff;stroke-width:2;\n}\n#tip{\n  position:absolute;z-index:30;width:390px;\n  max-width:calc(100% - 24px);max-height:65vh;\n  overflow:auto;-webkit-overflow-scrolling:touch;\n  background:#19263d;color:#edf3ff;\n  border:1px solid #48638b;border-radius:13px;\n  padding:15px;box-shadow:0 16px 50px #0009;\n  font-size:12px;line-height:1.6;overflow-wrap:anywhere;\n}\n#tip strong{\n  display:block;font-size:14px;margin:0 52px 4px 0;\n}\n.close{\n  float:right;min-height:36px;\n  padding:4px 8px;font-size:11px;\n}\n.tip-rule{\n  border-top:1px solid #344864;margin:10px 0;\n}\n.tip-line{\n  display:flex;justify-content:space-between;\n  gap:15px;margin:3px 0;\n}\n.tip-line span:first-child{color:#aabbd6}\n.tip-line span:last-child{\n  text-align:right;font-weight:600;\n}\n.breakdown{\n  width:100%;border-collapse:collapse;\n  margin-top:9px;font-size:11px;\n}\n.breakdown th{\n  text-align:left;color:#aabbd6;font-weight:500;\n  padding:6px 4px;border-bottom:1px solid #344864;\n}\n.breakdown td{\n  padding:6px 4px;border-bottom:1px solid #293b55;\n}\n.breakdown th:not(:first-child),\n.breakdown td:not(:first-child){text-align:right}\n.note{\n  color:#aabbd6;font-size:11px;margin-top:10px;\n}\n@media(max-width:650px){\n  body{padding:12px}\n  .metrics{\n    grid-template-columns:repeat(2,minmax(0,1fr));gap:8px;\n  }\n  .metric{min-height:85px;padding:12px}\n  .title{font-size:19px}\n  .chart-panel{padding:10px}\n  .metric-value{font-size:21px}\n  .header{margin-bottom:14px}\n}\n@media(prefers-reduced-motion:reduce){\n  *{scroll-behavior:auto!important}\n}\n</style>\n</head>\n<body>\n<header class="header">\n  <div>\n    <div class="eyebrow">PRIZE ANALYTICS</div>\n    <div id="title" class="title"></div>\n    <div id="subtitle" class="subtitle"></div>\n  </div>\n  <button\n    id="about"\n    type="button"\n    aria-label="About these totals">\n    About totals\n  </button>\n</header>\n\n<div class="metrics">\n  <button type="button" class="metric" id="kpiTotal">\n    <span class="metric-label">Recorded prize</span>\n    <span class="metric-value" id="total"></span>\n  </button>\n  <button type="button" class="metric" id="kpiRecords">\n    <span class="metric-label">Valid-prize checklists</span>\n    <span class="metric-value" id="records"></span>\n  </button>\n  <button type="button" class="metric" id="kpiNames">\n    <span class="metric-label" id="namesLabel"></span>\n    <span class="metric-value" id="names"></span>\n  </button>\n  <button type="button" class="metric" id="kpiVenues">\n    <span class="metric-label">Venues</span>\n    <span class="metric-value" id="venues"></span>\n  </button>\n</div>\n\n<section class="chart-panel">\n  <div class="chart-heading">\n    <div>\n      <div class="section-title">Prize by venue</div>\n      <div class="micro">\n        Ranked by total prize. Tap a segment for details;\n        tap a name for every venue.\n      </div>\n    </div>\n    <button\n      id="quality"\n      class="quality"\n      type="button">\n    </button>\n  </div>\n\n  <div id="legend"></div>\n\n  <div class="toolbar">\n    <div class="navigation">\n      <button\n        id="previous"\n        type="button"\n        aria-label="Previous chart view">\n        Previous\n      </button>\n      <span id="page" class="micro"></span>\n      <button\n        id="next"\n        type="button"\n        aria-label="Next chart view">\n        Next\n      </button>\n    </div>\n    <label class="size-label" for="pageSize">\n      Bars per view\n      <select id="pageSize">\n        <option>8</option>\n        <option>12</option>\n        <option>20</option>\n        <option selected>50</option>\n        <option>100</option>\n      </select>\n    </label>\n  </div>\n\n  <svg id="axis" aria-label="Recorded prize scale"></svg>\n  <div id="rows"></div>\n\n  <div class="toolbar footer">\n    <span id="range" class="micro"></span>\n    <div class="navigation">\n      <button id="previousBottom" type="button">Previous</button>\n      <button id="nextBottom" type="button">Next</button>\n    </div>\n  </div>\n</section>\n\n<div\n  id="tip"\n  role="dialog"\n  aria-label="Prize details"\n  hidden>\n</div>\n\n<script>\n"use strict";\n\nconst data=__MPD_DATA__;\nconst byId=id=>document.getElementById(id);\nconst ns="http://www.w3.org/2000/svg";\nconst tip=byId("tip");\n\nconst colors=[\n  "#88a8ff","#55d4c4","#f0bb72","#bd9bff","#f08fa8",\n  "#70bbeb","#b6d87c","#de9be2","#ed9c72","#a1b8d4",\n  "#6798e8","#39b4a6","#d5a35d","#9874dd","#ce718d",\n  "#5499c5","#92b15e","#bb79bd","#c97e53","#7b95b5"\n];\n\nconst color=index=>index<colors.length\n  ?colors[index]\n  :"hsl("+((index*137.508)%360)+",65%,65%)";\n\nconst number=value=>new Intl.NumberFormat(\n  undefined,\n  {maximumFractionDigits:20}\n).format(value);\n\nconst money=value=>"JPY "+number(value);\nconst percent=value=>(value*100).toFixed(1)+"%";\n\nconst matrix=new Map();\nconst totals=new Map();\n\ndata.entities.forEach(name=>{\n  matrix.set(name,new Map());\n  totals.set(name,0);\n});\n\ndata.rows.forEach(row=>{\n  if(matrix.has(row.entity)){\n    matrix.get(row.entity).set(row.venue,row);\n    totals.set(row.entity,row.entity_total);\n  }\n});\n\nconst maximum=Math.max(\n  1,\n  data.entities.reduce(\n    (current,name)=>Math.max(\n      current,\n      totals.get(name)||0\n    ),\n    0\n  )\n);\n\nlet page=0;\nlet pageSize=50;\nlet entries=new Map();\nlet active=null;\nlet pinned=false;\nlet hideTimer=null;\n\nbyId("title").textContent=\n  data.label+" prize comparison";\n\nbyId("subtitle").textContent=\n  data.period+"  /  "+data.dates;\n\nbyId("total").textContent=money(data.total);\nbyId("records").textContent=number(data.valid);\n\nbyId("namesLabel").textContent=\n  "Selected "+\n  (\n    data.label==="Horse Owner"\n      ?"horse owners"\n      :data.label.toLowerCase()+"s"\n  );\n\nbyId("names").textContent=\n  number(data.entities.length);\n\nbyId("venues").textContent=\n  number(data.venues.length);\n\nconst excluded=\n  data.missing+data.invalid+data.invalid_dates;\n\nbyId("quality").textContent=excluded\n  ?number(excluded)+" excluded records"\n  :"Recorded data";\n\ndata.venues.forEach((name,index)=>{\n  const item=document.createElement("span");\n  const swatch=document.createElement("span");\n  const label=document.createElement("span");\n\n  item.className="legend-item";\n  swatch.className="swatch";\n  swatch.style.background=color(index);\n  label.textContent=name;\n\n  item.append(swatch,label);\n  byId("legend").appendChild(item);\n});\n\nfunction text(parent,tag,value,className){\n  const item=document.createElement(tag);\n  item.textContent=value;\n\n  if(className){\n    item.className=className;\n  }\n\n  parent.appendChild(item);\n  return item;\n}\n\nfunction line(key,value){\n  const row=document.createElement("div");\n  row.className="tip-line";\n\n  text(row,"span",key);\n  text(row,"span",value);\n  tip.appendChild(row);\n}\n\nfunction rule(){\n  const item=document.createElement("div");\n  item.className="tip-rule";\n  tip.appendChild(item);\n}\n\nfunction resetTip(){\n  tip.replaceChildren();\n\n  const close=text(\n    tip,\n    "button",\n    "Close",\n    "close"\n  );\n\n  close.type="button";\n  close.addEventListener("click",hide);\n}\n\nfunction highlight(){\n  entries.forEach((entry,entityIndex)=>{\n    entry.segments.forEach((rect,venueIndex)=>{\n      rect.setAttribute(\n        "stroke",\n        active&&\n        active.type==="bar"&&\n        active.ei===entityIndex&&\n        active.vi===venueIndex\n          ?"#edf3ff"\n          :"none"\n      );\n    });\n  });\n}\n\nfunction hide(){\n  clearTimeout(hideTimer);\n  tip.hidden=true;\n  active=null;\n  pinned=false;\n  document.body.style.paddingBottom="28px";\n  highlight();\n}\n\nfunction anchor(){\n  if(!active){\n    return null;\n  }\n\n  if(active.type==="bar"){\n    return (\n      entries.get(active.ei)||{}\n    ).svg;\n  }\n\n  return byId(active.id);\n}\n\nfunction place(scroll){\n  const item=anchor();\n\n  if(!item){\n    return;\n  }\n\n  tip.hidden=false;\n\n  const box=item.getBoundingClientRect();\n  const width=tip.offsetWidth;\n\n  tip.style.left=Math.max(\n    12,\n    Math.min(\n      box.left+window.scrollX,\n      window.innerWidth-width-12\n    )\n  )+"px";\n\n  // Bar details stay below the selected bar.\n  tip.style.top=(\n    box.bottom+window.scrollY+8\n  )+"px";\n\n  document.body.style.paddingBottom=(\n    tip.offsetHeight+30\n  )+"px";\n\n  if(scroll){\n    const rect=tip.getBoundingClientRect();\n\n    if(\n      rect.bottom>window.innerHeight||\n      rect.top<0\n    ){\n      tip.scrollIntoView({\n        block:"nearest",\n        behavior:window.matchMedia(\n          "(prefers-reduced-motion: reduce)"\n        ).matches\n          ?"auto"\n          :"smooth"\n      });\n    }\n  }\n}\n\nfunction about(id,pin){\n  clearTimeout(hideTimer);\n  active={type:"about",id:id};\n  pinned=pin;\n\n  resetTip();\n\n  text(\n    tip,\n    "strong",\n    "About the recorded totals"\n  );\n\n  text(tip,"div",data.dates,"micro");\n  rule();\n\n  line("Recorded prize",money(data.total));\n  line("Valid-prize checklists",number(data.valid));\n  line("Missing prize",number(data.missing));\n  line("Invalid prize",number(data.invalid));\n  line("Invalid race date",number(data.invalid_dates));\n\n  text(\n    tip,\n    "div",\n    "Groups saved race prizes by the checklist stallion or breeding farm. These are horse race prizes, not fees or payments to a stallion or breeding farm. Invalid-date records cannot be assigned to a period. Uses your saved checklist prizes and race dates, "+\n    "across all finishing places. Review filters do not apply. "+\n    "Zero prizes are valid; missing, negative and non-finite "+\n    "prizes are excluded. These totals are not calculated "+\n    "jockey fees, trainer fees or ownership payout shares. "+\n    "Missing reference names are not selectable. "+\n    "A calendar-year period includes January–December; "+\n    "rolling periods end in the selected month.",\n    "note"\n  );\n\n  highlight();\n  place(pin);\n}\n\nfunction barDetails(entityIndex,venueIndex,pin){\n  clearTimeout(hideTimer);\n\n  const entry=entries.get(entityIndex);\n\n  if(!entry){\n    return;\n  }\n\n  const name=data.entities[entityIndex];\n  const total=totals.get(name)||0;\n\n  const row=venueIndex===null\n    ?null\n    :matrix.get(name).get(data.venues[venueIndex]);\n\n  active={\n    type:"bar",\n    ei:entityIndex,\n    vi:venueIndex\n  };\n\n  pinned=pin;\n  resetTip();\n\n  text(tip,"strong",name);\n  text(tip,"div",data.dates,"micro");\n  rule();\n\n  if(venueIndex!==null){\n    line("Venue",data.venues[venueIndex]);\n    line("Venue prize",money(row?row.prize:0));\n\n    line(\n      "Share of participant total",\n      percent(\n        total>0\n          ?(row?row.prize:0)/total\n          :0\n      )\n    );\n\n    line(\n      "Valid-prize checklists",\n      number(row?row.checklists:0)\n    );\n\n    rule();\n  }\n\n  line("Participant total",money(total));\n\n  line(\n    "Share of comparison total",\n    percent(\n      data.total>0\n        ?total/data.total\n        :0\n    )\n  );\n\n  if(venueIndex===null){\n    line(\n      "Valid-prize checklists",\n      number(\n        Array.from(\n          matrix.get(name).values()\n        ).reduce(\n          (sum,item)=>sum+item.checklists,\n          0\n        )\n      )\n    );\n\n    if(data.venues.length){\n      const table=document.createElement("table");\n      table.className="breakdown";\n\n      const head=document.createElement("tr");\n\n      ["Venue","Prize (JPY)","Records"].forEach(value=>{\n        text(head,"th",value);\n      });\n\n      table.appendChild(head);\n\n      data.venues.forEach(venue=>{\n        const record=matrix.get(name).get(venue);\n        const tableRow=document.createElement("tr");\n\n        text(tableRow,"td",venue);\n\n        text(\n          tableRow,\n          "td",\n          number(record?record.prize:0)\n        );\n\n        text(\n          tableRow,\n          "td",\n          number(record?record.checklists:0)\n        );\n\n        table.appendChild(tableRow);\n      });\n\n      tip.appendChild(table);\n\n    }else{\n      text(\n        tip,\n        "div",\n        "No valid prize values were recorded for this selection.",\n        "note"\n      );\n    }\n  }\n\n  highlight();\n  place(pin);\n}\n\nfunction laterHide(){\n  if(!pinned){\n    clearTimeout(hideTimer);\n    hideTimer=setTimeout(hide,180);\n  }\n}\n\nfunction svgElement(svg,tag,attributes,value){\n  const node=document.createElementNS(ns,tag);\n\n  Object.entries(attributes).forEach(([key,item])=>{\n    node.setAttribute(key,String(item));\n  });\n\n  if(value!==undefined){\n    node.textContent=value;\n  }\n\n  svg.appendChild(node);\n  return node;\n}\n\nfunction bindSegment(node,entityIndex,venueIndex){\n  node.setAttribute("tabindex","0");\n  node.setAttribute("role","button");\n  node.classList.add("segment");\n\n  node.setAttribute(\n    "aria-label",\n    data.entities[entityIndex]+", "+\n    (\n      venueIndex===null\n        ?"all venues"\n        :data.venues[venueIndex]\n    )+", show prize details"\n  );\n\n  node.addEventListener("click",()=>{\n    barDetails(entityIndex,venueIndex,true);\n  });\n\n  node.addEventListener("keydown",event=>{\n    if(\n      event.key==="Enter"||\n      event.key===" "\n    ){\n      event.preventDefault();\n      barDetails(entityIndex,venueIndex,true);\n    }\n  });\n\n  node.addEventListener("pointerenter",event=>{\n    if(\n      event.pointerType==="mouse"&&\n      !pinned\n    ){\n      barDetails(entityIndex,venueIndex,false);\n    }\n  });\n\n  node.addEventListener("pointerleave",laterHide);\n\n  node.addEventListener("focus",()=>{\n    if(!pinned){\n      barDetails(entityIndex,venueIndex,false);\n    }\n  });\n\n  node.addEventListener("blur",laterHide);\n}\n\nfunction paint(){\n  const axis=byId("axis");\n  const width=Math.max(\n    240,\n    axis.clientWidth||700\n  );\n\n  axis.replaceChildren();\n  axis.setAttribute(\n    "viewBox",\n    "0 0 "+width+" 28"\n  );\n\n  [0,maximum/2,maximum].forEach((value,index)=>{\n    svgElement(\n      axis,\n      "text",\n      {\n        x:(value/maximum)*width,\n        y:19,\n        fill:"#8398b8",\n        "font-size":10,\n        "text-anchor":index===0\n          ?"start"\n          :index===2\n            ?"end"\n            :"middle"\n      },\n      new Intl.NumberFormat(\n        undefined,\n        {\n          notation:"compact",\n          maximumFractionDigits:1\n        }\n      ).format(value)\n    );\n  });\n\n  entries.forEach((entry,entityIndex)=>{\n    entry.svg.replaceChildren();\n    entry.segments=new Map();\n\n    const width=Math.max(\n      240,\n      entry.svg.clientWidth||700\n    );\n\n    entry.svg.setAttribute(\n      "viewBox",\n      "0 0 "+width+" 34"\n    );\n\n    const hit=svgElement(\n      entry.svg,\n      "rect",\n      {\n        x:0,\n        y:0,\n        width:width,\n        height:34,\n        rx:5,\n        fill:"#0c1526"\n      }\n    );\n\n    bindSegment(\n      hit,\n      entityIndex,\n      null\n    );\n\n    let offset=0;\n    const name=data.entities[entityIndex];\n\n    data.venues.forEach((venue,venueIndex)=>{\n      const row=matrix.get(name).get(venue);\n      const value=row?row.prize:0;\n\n      if(value>0){\n        const rect=svgElement(\n          entry.svg,\n          "rect",\n          {\n            x:(offset/maximum)*width,\n            y:3,\n            width:(value/maximum)*width,\n            height:28,\n            fill:color(venueIndex),\n            stroke:"none",\n            "stroke-width":2\n          }\n        );\n\n        entry.segments.set(\n          venueIndex,\n          rect\n        );\n\n        bindSegment(\n          rect,\n          entityIndex,\n          venueIndex\n        );\n      }\n\n      offset+=value;\n    });\n  });\n\n  highlight();\n\n  if(active&&!tip.hidden){\n    place(false);\n  }\n}\n\nfunction render(){\n  byId("rows").replaceChildren();\n  entries=new Map();\n\n  const start=page*pageSize;\n\n  const end=Math.min(\n    data.entities.length,\n    start+pageSize\n  );\n\n  for(\n    let entityIndex=start;\n    entityIndex<end;\n    entityIndex++\n  ){\n    const row=document.createElement("section");\n    const head=document.createElement("div");\n    const name=document.createElement("button");\n    const total=document.createElement("span");\n    const svg=document.createElementNS(ns,"svg");\n\n    row.className="bar-row";\n    head.className="row-head";\n\n    name.type="button";\n    name.className="name";\n\n    text(\n      name,\n      "span",\n      String(entityIndex+1).padStart(2,"0"),\n      "rank"\n    );\n\n    text(\n      name,\n      "span",\n      data.entities[entityIndex],\n      "entity-name"\n    );\n\n    name.addEventListener("click",()=>{\n      barDetails(entityIndex,null,true);\n    });\n\n    total.className="row-total";\n    total.textContent=money(\n      totals.get(data.entities[entityIndex])||0\n    );\n\n    head.append(name,total);\n\n    svg.classList.add("bar");\n    svg.setAttribute("role","group");\n\n    svg.setAttribute(\n      "aria-label",\n      data.entities[entityIndex]+" prize by venue"\n    );\n\n    row.append(head,svg);\n    byId("rows").appendChild(row);\n\n    entries.set(\n      entityIndex,\n      {\n        svg:svg,\n        segments:new Map()\n      }\n    );\n  }\n\n  const pages=Math.max(\n    1,\n    Math.ceil(data.entities.length/pageSize)\n  );\n\n  byId("page").textContent=\n    (page+1)+" / "+pages;\n\n  byId("range").textContent=\n    "Showing "+(start+1)+"–"+end+\n    " of "+data.entities.length+\n    "  ·  Same prize scale across views";\n\n  ["previous","previousBottom"].forEach(id=>{\n    byId(id).disabled=page===0;\n  });\n\n  ["next","nextBottom"].forEach(id=>{\n    byId(id).disabled=page>=pages-1;\n  });\n\n  paint();\n}\n\nfunction move(amount){\n  hide();\n\n  page=Math.max(\n    0,\n    Math.min(\n      Math.ceil(data.entities.length/pageSize)-1,\n      page+amount\n    )\n  );\n\n  render();\n  window.scrollTo({top:0});\n}\n\n["previous","previousBottom"].forEach(id=>{\n  byId(id).addEventListener("click",()=>{\n    move(-1);\n  });\n});\n\n["next","nextBottom"].forEach(id=>{\n  byId(id).addEventListener("click",()=>{\n    move(1);\n  });\n});\n\nbyId("pageSize").addEventListener("change",event=>{\n  hide();\n  pageSize=Number(event.target.value);\n  page=0;\n  render();\n});\n\n[\n  "about",\n  "quality",\n  "kpiTotal",\n  "kpiRecords",\n  "kpiNames",\n  "kpiVenues"\n].forEach(id=>{\n  const item=byId(id);\n\n  item.addEventListener("click",()=>{\n    about(id,true);\n  });\n\n  item.addEventListener("pointerenter",event=>{\n    if(\n      event.pointerType==="mouse"&&\n      !pinned\n    ){\n      about(id,false);\n    }\n  });\n\n  item.addEventListener(\n    "pointerleave",\n    laterHide\n  );\n});\n\ntip.addEventListener("pointerenter",()=>{\n  clearTimeout(hideTimer);\n});\n\ntip.addEventListener(\n  "pointerleave",\n  laterHide\n);\n\ndocument.addEventListener("pointerdown",event=>{\n  if(\n    !tip.hidden&&\n    !tip.contains(event.target)&&\n    !event.target.closest(\n      ".bar-row,.metric,#about,#quality"\n    )\n  ){\n    hide();\n  }\n});\n\ndocument.addEventListener("keydown",event=>{\n  if(event.key==="Escape"){\n    hide();\n  }\n});\n\nlet resizeTimer;\n\nwindow.addEventListener("resize",()=>{\n  clearTimeout(resizeTimer);\n  resizeTimer=setTimeout(paint,100);\n});\n\nrender();\n</script>\n</body>\n</html>'
    components.html(html.replace('__MPD_DATA__', payload, 1), height=880, scrolling=True)

def _mpx_criteria_chart(chart_rows, stats, label, kind, year, month, *, period='Month'):
    import json
    from datetime import timedelta
    import streamlit.components.v1 as components
    first, end = _mp_dates(year, month, period)
    last = end - timedelta(days=1)
    entities = list(stats['entity_order'])
    if not entities:
        return
    payload = json.dumps({'rows': chart_rows, 'entities': entities, 'venues': list(stats['venue_order']), 'label': label, 'period': period, 'dates': f'{first.isoformat()} — {last.isoformat()}', 'total': stats['total'], 'valid': stats['valid'], 'missing': stats['missing'], 'invalid': stats['invalid'], 'invalid_dates': stats['invalid_dates']}, ensure_ascii=True, allow_nan=False)
    payload = payload.replace('<', '\\u003c').replace('>', '\\u003e').replace('&', '\\u0026')
    html = '<!doctype html>\n<html lang="en">\n<head>\n<meta charset="utf-8">\n<meta name="viewport" content="width=device-width,initial-scale=1">\n<meta name="color-scheme" content="dark">\n<style>\n:root{\n  color-scheme:dark;\n  --bg:#0b1120;--panel:#111b2e;--raised:#17243b;\n  --line:#27354d;--fg:#edf3ff;--muted:#9aacc7;\n  --accent:#8ba9ff;\n}\n*{box-sizing:border-box}\n[hidden]{display:none!important}\nhtml,body{\n  margin:0;background:var(--bg);color:var(--fg);\n  font-family:Inter,ui-sans-serif,system-ui,-apple-system,\n    BlinkMacSystemFont,"Segoe UI",sans-serif;\n  -webkit-text-size-adjust:100%;\n  font-variant-numeric:tabular-nums;\n}\nbody{\n  padding:18px 18px 28px;\n  -webkit-overflow-scrolling:touch;\n}\n.header{\n  display:flex;justify-content:space-between;\n  gap:12px;align-items:flex-start;margin-bottom:18px;\n}\n.eyebrow{\n  font-size:10px;letter-spacing:.16em;\n  font-weight:700;color:var(--accent);margin-bottom:6px;\n}\n.title{\n  font-size:22px;font-weight:650;letter-spacing:-.025em;\n}\n.subtitle{\n  font-size:12px;color:var(--muted);\n  margin-top:7px;line-height:1.5;\n}\nbutton,select{\n  font:inherit;color:inherit;\n  border:1px solid var(--line);\n  background:var(--panel);border-radius:9px;\n  min-height:44px;padding:8px 12px;\n  touch-action:manipulation;font-size:14px;\n}\nselect{font-size:16px}\nbutton{cursor:pointer}\nbutton:disabled{opacity:.35;cursor:default}\nbutton:hover:not(:disabled){\n  border-color:#55729e;background:var(--raised);\n}\nbutton:focus-visible,select:focus-visible{\n  outline:2px solid #a6baff;outline-offset:3px;\n}\n.metrics{\n  display:grid;grid-template-columns:repeat(4,minmax(0,1fr));\n  gap:10px;margin-bottom:20px;\n}\n.metric{\n  text-align:left;min-height:95px;padding:15px;\n  background:linear-gradient(145deg,#14213a,#101a2d);\n  border-radius:13px;\n}\n.metric-label{\n  display:block;font-size:11px;font-weight:500;\n  color:var(--muted);margin-bottom:11px;\n}\n.metric-value{\n  display:block;font-size:clamp(17px,2.4vw,25px);\n  font-weight:650;letter-spacing:-.03em;\n  overflow-wrap:anywhere;\n}\n.metric:first-child{border-color:#3a547e}\n.metric:first-child .metric-value{color:#bbccff}\n.chart-panel{\n  border:1px solid var(--line);border-radius:14px;\n  padding:14px;background:var(--panel);\n}\n.chart-heading{\n  display:flex;justify-content:space-between;\n  align-items:center;gap:12px;\n}\n.section-title{font-size:14px;font-weight:650}\n.micro{\n  font-size:11px;line-height:1.5;color:var(--muted);\n}\n.quality{\n  font-size:11px;color:#b8c7e3;\n  background:transparent;border:none;\n  min-height:36px;padding:4px 6px;\n}\n#legend{\n  display:flex;flex-wrap:wrap;\n  gap:8px 14px;margin:14px 0 8px;\n}\n.legend-item{\n  display:inline-flex;align-items:center;gap:6px;\n  color:#bdcbe0;font-size:11px;overflow-wrap:anywhere;\n}\n.swatch{\n  display:inline-block;width:8px;height:8px;\n  border-radius:3px;flex-shrink:0;\n}\n.toolbar{\n  display:flex;flex-wrap:wrap;align-items:center;\n  justify-content:space-between;gap:10px;\n  margin:12px 0 6px;padding-top:12px;\n  border-top:1px solid var(--line);\n}\n.navigation{\n  display:flex;align-items:center;gap:8px;\n}\n.navigation button{min-width:44px;padding:8px}\n.size-label{\n  display:flex;gap:8px;align-items:center;\n  color:var(--muted);font-size:11px;\n}\n.size-label select{min-width:70px}\n.footer{\n  margin-top:12px;border-top:1px solid var(--line);\n  padding-top:12px;\n}\n#axis{display:block;width:100%;height:28px}\n.bar-row{\n  padding:9px 0 11px;border-top:1px solid #1c2a40;\n}\n.row-head{\n  display:flex;align-items:center;\n  justify-content:space-between;gap:10px;\n}\n.name{\n  flex:1;display:flex;gap:10px;align-items:center;\n  text-align:left;min-width:0;border:none;\n  background:transparent;padding:0;min-height:44px;\n}\n.name:hover:not(:disabled){\n  background:transparent;border-color:transparent;\n}\n.rank{\n  font-size:11px;width:23px;\n  color:#7087a9;flex-shrink:0;\n}\n.entity-name{\n  font-size:13px;font-weight:550;overflow-wrap:anywhere;\n}\n.row-total{\n  text-align:right;font-size:13px;font-weight:650;\n  max-width:45%;overflow-wrap:anywhere;\n}\n.bar{\n  display:block;width:100%;height:34px;touch-action:pan-y;\n}\n.segment{cursor:pointer}\n.segment:focus{\n  outline:none;stroke:#e9f1ff;stroke-width:2;\n}\n#tip{\n  position:absolute;z-index:30;width:390px;\n  max-width:calc(100% - 24px);max-height:65vh;\n  overflow:auto;-webkit-overflow-scrolling:touch;\n  background:#19263d;color:#edf3ff;\n  border:1px solid #48638b;border-radius:13px;\n  padding:15px;box-shadow:0 16px 50px #0009;\n  font-size:12px;line-height:1.6;overflow-wrap:anywhere;\n}\n#tip strong{\n  display:block;font-size:14px;margin:0 52px 4px 0;\n}\n.close{\n  float:right;min-height:36px;\n  padding:4px 8px;font-size:11px;\n}\n.tip-rule{\n  border-top:1px solid #344864;margin:10px 0;\n}\n.tip-line{\n  display:flex;justify-content:space-between;\n  gap:15px;margin:3px 0;\n}\n.tip-line span:first-child{color:#aabbd6}\n.tip-line span:last-child{\n  text-align:right;font-weight:600;\n}\n.breakdown{\n  width:100%;border-collapse:collapse;\n  margin-top:9px;font-size:11px;\n}\n.breakdown th{\n  text-align:left;color:#aabbd6;font-weight:500;\n  padding:6px 4px;border-bottom:1px solid #344864;\n}\n.breakdown td{\n  padding:6px 4px;border-bottom:1px solid #293b55;\n}\n.breakdown th:not(:first-child),\n.breakdown td:not(:first-child){text-align:right}\n.note{\n  color:#aabbd6;font-size:11px;margin-top:10px;\n}\n@media(max-width:650px){\n  body{padding:12px}\n  .metrics{\n    grid-template-columns:repeat(2,minmax(0,1fr));gap:8px;\n  }\n  .metric{min-height:85px;padding:12px}\n  .title{font-size:19px}\n  .chart-panel{padding:10px}\n  .metric-value{font-size:21px}\n  .header{margin-bottom:14px}\n}\n@media(prefers-reduced-motion:reduce){\n  *{scroll-behavior:auto!important}\n}\n</style>\n</head>\n<body>\n<header class="header">\n  <div>\n    <div class="eyebrow">PRIZE ANALYTICS</div>\n    <div id="title" class="title"></div>\n    <div id="subtitle" class="subtitle"></div>\n  </div>\n  <button\n    id="about"\n    type="button"\n    aria-label="About these totals">\n    About totals\n  </button>\n</header>\n\n<div class="metrics">\n  <button type="button" class="metric" id="kpiTotal">\n    <span class="metric-label">Attributed prize</span>\n    <span class="metric-value" id="total"></span>\n  </button>\n  <button type="button" class="metric" id="kpiRecords">\n    <span class="metric-label">Criterion matches</span>\n    <span class="metric-value" id="records"></span>\n  </button>\n  <button type="button" class="metric" id="kpiNames">\n    <span class="metric-label" id="namesLabel"></span>\n    <span class="metric-value" id="names"></span>\n  </button>\n  <button type="button" class="metric" id="kpiVenues">\n    <span class="metric-label">Venues</span>\n    <span class="metric-value" id="venues"></span>\n  </button>\n</div>\n\n<section class="chart-panel">\n  <div class="chart-heading">\n    <div>\n      <div class="section-title">Prize by venue</div>\n      <div class="micro">\n        Ranked by total prize. Tap a segment for details;\n        tap a name for every venue.\n      </div>\n    </div>\n    <button\n      id="quality"\n      class="quality"\n      type="button">\n    </button>\n  </div>\n\n  <div id="legend"></div>\n\n  <div class="toolbar">\n    <div class="navigation">\n      <button\n        id="previous"\n        type="button"\n        aria-label="Previous chart view">\n        Previous\n      </button>\n      <span id="page" class="micro"></span>\n      <button\n        id="next"\n        type="button"\n        aria-label="Next chart view">\n        Next\n      </button>\n    </div>\n    <label class="size-label" for="pageSize">\n      Bars per view\n      <select id="pageSize">\n        <option>8</option>\n        <option>12</option>\n        <option>20</option>\n        <option selected>50</option>\n        <option>100</option>\n      </select>\n    </label>\n  </div>\n\n  <svg id="axis" aria-label="Attributed prize scale"></svg>\n  <div id="rows"></div>\n\n  <div class="toolbar footer">\n    <span id="range" class="micro"></span>\n    <div class="navigation">\n      <button id="previousBottom" type="button">Previous</button>\n      <button id="nextBottom" type="button">Next</button>\n    </div>\n  </div>\n</section>\n\n<div\n  id="tip"\n  role="dialog"\n  aria-label="Prize details"\n  hidden>\n</div>\n\n<script>\n"use strict";\n\nconst data=__MPD_DATA__;\nconst byId=id=>document.getElementById(id);\nconst ns="http://www.w3.org/2000/svg";\nconst tip=byId("tip");\n\nconst colors=[\n  "#88a8ff","#55d4c4","#f0bb72","#bd9bff","#f08fa8",\n  "#70bbeb","#b6d87c","#de9be2","#ed9c72","#a1b8d4",\n  "#6798e8","#39b4a6","#d5a35d","#9874dd","#ce718d",\n  "#5499c5","#92b15e","#bb79bd","#c97e53","#7b95b5"\n];\n\nconst color=index=>index<colors.length\n  ?colors[index]\n  :"hsl("+((index*137.508)%360)+",65%,65%)";\n\nconst number=value=>new Intl.NumberFormat(\n  undefined,\n  {maximumFractionDigits:20}\n).format(value);\n\nconst money=value=>"JPY "+number(value);\nconst percent=value=>(value*100).toFixed(1)+"%";\n\nconst matrix=new Map();\nconst totals=new Map();\n\ndata.entities.forEach(name=>{\n  matrix.set(name,new Map());\n  totals.set(name,0);\n});\n\ndata.rows.forEach(row=>{\n  if(matrix.has(row.entity)){\n    matrix.get(row.entity).set(row.venue,row);\n    totals.set(row.entity,row.entity_total);\n  }\n});\n\nconst maximum=Math.max(\n  1,\n  data.entities.reduce(\n    (current,name)=>Math.max(\n      current,\n      totals.get(name)||0\n    ),\n    0\n  )\n);\n\nlet page=0;\nlet pageSize=50;\nlet entries=new Map();\nlet active=null;\nlet pinned=false;\nlet hideTimer=null;\n\nbyId("title").textContent=\n  data.label+" prize comparison";\n\nbyId("subtitle").textContent=\n  data.period+"  /  "+data.dates;\n\nbyId("total").textContent=money(data.total);\nbyId("records").textContent=number(data.valid);\n\nbyId("namesLabel").textContent=\n  "Selected "+\n  (\n    data.label==="Horse Owner"\n      ?"horse owners"\n      :"checklist criteria"\n  );\n\nbyId("names").textContent=\n  number(data.entities.length);\n\nbyId("venues").textContent=\n  number(data.venues.length);\n\nconst excluded=\n  data.missing+data.invalid+data.invalid_dates;\n\nbyId("quality").textContent=excluded\n  ?number(excluded)+" excluded criterion matches"\n  :"Criterion attribution";\n\ndata.venues.forEach((name,index)=>{\n  const item=document.createElement("span");\n  const swatch=document.createElement("span");\n  const label=document.createElement("span");\n\n  item.className="legend-item";\n  swatch.className="swatch";\n  swatch.style.background=color(index);\n  label.textContent=name;\n\n  item.append(swatch,label);\n  byId("legend").appendChild(item);\n});\n\nfunction text(parent,tag,value,className){\n  const item=document.createElement(tag);\n  item.textContent=value;\n\n  if(className){\n    item.className=className;\n  }\n\n  parent.appendChild(item);\n  return item;\n}\n\nfunction line(key,value){\n  const row=document.createElement("div");\n  row.className="tip-line";\n\n  text(row,"span",key);\n  text(row,"span",value);\n  tip.appendChild(row);\n}\n\nfunction rule(){\n  const item=document.createElement("div");\n  item.className="tip-rule";\n  tip.appendChild(item);\n}\n\nfunction resetTip(){\n  tip.replaceChildren();\n\n  const close=text(\n    tip,\n    "button",\n    "Close",\n    "close"\n  );\n\n  close.type="button";\n  close.addEventListener("click",hide);\n}\n\nfunction highlight(){\n  entries.forEach((entry,entityIndex)=>{\n    entry.segments.forEach((rect,venueIndex)=>{\n      rect.setAttribute(\n        "stroke",\n        active&&\n        active.type==="bar"&&\n        active.ei===entityIndex&&\n        active.vi===venueIndex\n          ?"#edf3ff"\n          :"none"\n      );\n    });\n  });\n}\n\nfunction hide(){\n  clearTimeout(hideTimer);\n  tip.hidden=true;\n  active=null;\n  pinned=false;\n  document.body.style.paddingBottom="28px";\n  highlight();\n}\n\nfunction anchor(){\n  if(!active){\n    return null;\n  }\n\n  if(active.type==="bar"){\n    return (\n      entries.get(active.ei)||{}\n    ).svg;\n  }\n\n  return byId(active.id);\n}\n\nfunction place(scroll){\n  const item=anchor();\n\n  if(!item){\n    return;\n  }\n\n  tip.hidden=false;\n\n  const box=item.getBoundingClientRect();\n  const width=tip.offsetWidth;\n\n  tip.style.left=Math.max(\n    12,\n    Math.min(\n      box.left+window.scrollX,\n      window.innerWidth-width-12\n    )\n  )+"px";\n\n  // Bar details stay below the selected bar.\n  tip.style.top=(\n    box.bottom+window.scrollY+8\n  )+"px";\n\n  document.body.style.paddingBottom=(\n    tip.offsetHeight+30\n  )+"px";\n\n  if(scroll){\n    const rect=tip.getBoundingClientRect();\n\n    if(\n      rect.bottom>window.innerHeight||\n      rect.top<0\n    ){\n      tip.scrollIntoView({\n        block:"nearest",\n        behavior:window.matchMedia(\n          "(prefers-reduced-motion: reduce)"\n        ).matches\n          ?"auto"\n          :"smooth"\n      });\n    }\n  }\n}\n\nfunction about(id,pin){\n  clearTimeout(hideTimer);\n  active={type:"about",id:id};\n  pinned=pin;\n\n  resetTip();\n\n  text(\n    tip,\n    "strong",\n    "About criterion attribution"\n  );\n\n  text(tip,"div",data.dates,"micro");\n  rule();\n\n  line("Attributed prize",money(data.total));\n  line("Criterion matches",number(data.valid));\n  line("Missing prize",number(data.missing));\n  line("Invalid prize",number(data.invalid));\n  line("Invalid race date",number(data.invalid_dates));\n\n  text(\n    tip,\n    "div",\n    "Each checked criterion receives the full saved checklist prize once. Criteria overlap: attributed prizes and criterion matches can count the same checklist more than once. Shares use the sum of selected criterion totals, not unique race prizes. Invalid-date matches cannot be assigned to a period. Uses your saved checklist prizes and race dates, "+\n    "across all finishing places. Review filters do not apply. "+\n    "Zero prizes are valid; missing, negative and non-finite "+\n    "prizes are excluded. These totals are not calculated "+\n    "jockey fees, trainer fees or ownership payout shares. "+\n    "Missing reference names are not selectable. "+\n    "A calendar-year period includes January–December; "+\n    "rolling periods end in the selected month.",\n    "note"\n  );\n\n  highlight();\n  place(pin);\n}\n\nfunction barDetails(entityIndex,venueIndex,pin){\n  clearTimeout(hideTimer);\n\n  const entry=entries.get(entityIndex);\n\n  if(!entry){\n    return;\n  }\n\n  const name=data.entities[entityIndex];\n  const total=totals.get(name)||0;\n\n  const row=venueIndex===null\n    ?null\n    :matrix.get(name).get(data.venues[venueIndex]);\n\n  active={\n    type:"bar",\n    ei:entityIndex,\n    vi:venueIndex\n  };\n\n  pinned=pin;\n  resetTip();\n\n  text(tip,"strong",name);\n  text(tip,"div",data.dates,"micro");\n  rule();\n\n  if(venueIndex!==null){\n    line("Venue",data.venues[venueIndex]);\n    line("Venue prize",money(row?row.prize:0));\n\n    line(\n      "Share of criterion total",\n      percent(\n        total>0\n          ?(row?row.prize:0)/total\n          :0\n      )\n    );\n\n    line(\n      "Criterion matches",\n      number(row?row.checklists:0)\n    );\n\n    rule();\n  }\n\n  line("Criterion total",money(total));\n\n  line(\n    "Share of attributed total",\n    percent(\n      data.total>0\n        ?total/data.total\n        :0\n    )\n  );\n\n  if(venueIndex===null){\n    line(\n      "Criterion matches",\n      number(\n        Array.from(\n          matrix.get(name).values()\n        ).reduce(\n          (sum,item)=>sum+item.checklists,\n          0\n        )\n      )\n    );\n\n    if(data.venues.length){\n      const table=document.createElement("table");\n      table.className="breakdown";\n\n      const head=document.createElement("tr");\n\n      ["Venue","Prize (JPY)","Records"].forEach(value=>{\n        text(head,"th",value);\n      });\n\n      table.appendChild(head);\n\n      data.venues.forEach(venue=>{\n        const record=matrix.get(name).get(venue);\n        const tableRow=document.createElement("tr");\n\n        text(tableRow,"td",venue);\n\n        text(\n          tableRow,\n          "td",\n          number(record?record.prize:0)\n        );\n\n        text(\n          tableRow,\n          "td",\n          number(record?record.checklists:0)\n        );\n\n        table.appendChild(tableRow);\n      });\n\n      tip.appendChild(table);\n\n    }else{\n      text(\n        tip,\n        "div",\n        "No valid prize values were recorded for this selection.",\n        "note"\n      );\n    }\n  }\n\n  highlight();\n  place(pin);\n}\n\nfunction laterHide(){\n  if(!pinned){\n    clearTimeout(hideTimer);\n    hideTimer=setTimeout(hide,180);\n  }\n}\n\nfunction svgElement(svg,tag,attributes,value){\n  const node=document.createElementNS(ns,tag);\n\n  Object.entries(attributes).forEach(([key,item])=>{\n    node.setAttribute(key,String(item));\n  });\n\n  if(value!==undefined){\n    node.textContent=value;\n  }\n\n  svg.appendChild(node);\n  return node;\n}\n\nfunction bindSegment(node,entityIndex,venueIndex){\n  node.setAttribute("tabindex","0");\n  node.setAttribute("role","button");\n  node.classList.add("segment");\n\n  node.setAttribute(\n    "aria-label",\n    data.entities[entityIndex]+", "+\n    (\n      venueIndex===null\n        ?"all venues"\n        :data.venues[venueIndex]\n    )+", show prize details"\n  );\n\n  node.addEventListener("click",()=>{\n    barDetails(entityIndex,venueIndex,true);\n  });\n\n  node.addEventListener("keydown",event=>{\n    if(\n      event.key==="Enter"||\n      event.key===" "\n    ){\n      event.preventDefault();\n      barDetails(entityIndex,venueIndex,true);\n    }\n  });\n\n  node.addEventListener("pointerenter",event=>{\n    if(\n      event.pointerType==="mouse"&&\n      !pinned\n    ){\n      barDetails(entityIndex,venueIndex,false);\n    }\n  });\n\n  node.addEventListener("pointerleave",laterHide);\n\n  node.addEventListener("focus",()=>{\n    if(!pinned){\n      barDetails(entityIndex,venueIndex,false);\n    }\n  });\n\n  node.addEventListener("blur",laterHide);\n}\n\nfunction paint(){\n  const axis=byId("axis");\n  const width=Math.max(\n    240,\n    axis.clientWidth||700\n  );\n\n  axis.replaceChildren();\n  axis.setAttribute(\n    "viewBox",\n    "0 0 "+width+" 28"\n  );\n\n  [0,maximum/2,maximum].forEach((value,index)=>{\n    svgElement(\n      axis,\n      "text",\n      {\n        x:(value/maximum)*width,\n        y:19,\n        fill:"#8398b8",\n        "font-size":10,\n        "text-anchor":index===0\n          ?"start"\n          :index===2\n            ?"end"\n            :"middle"\n      },\n      new Intl.NumberFormat(\n        undefined,\n        {\n          notation:"compact",\n          maximumFractionDigits:1\n        }\n      ).format(value)\n    );\n  });\n\n  entries.forEach((entry,entityIndex)=>{\n    entry.svg.replaceChildren();\n    entry.segments=new Map();\n\n    const width=Math.max(\n      240,\n      entry.svg.clientWidth||700\n    );\n\n    entry.svg.setAttribute(\n      "viewBox",\n      "0 0 "+width+" 34"\n    );\n\n    const hit=svgElement(\n      entry.svg,\n      "rect",\n      {\n        x:0,\n        y:0,\n        width:width,\n        height:34,\n        rx:5,\n        fill:"#0c1526"\n      }\n    );\n\n    bindSegment(\n      hit,\n      entityIndex,\n      null\n    );\n\n    let offset=0;\n    const name=data.entities[entityIndex];\n\n    data.venues.forEach((venue,venueIndex)=>{\n      const row=matrix.get(name).get(venue);\n      const value=row?row.prize:0;\n\n      if(value>0){\n        const rect=svgElement(\n          entry.svg,\n          "rect",\n          {\n            x:(offset/maximum)*width,\n            y:3,\n            width:(value/maximum)*width,\n            height:28,\n            fill:color(venueIndex),\n            stroke:"none",\n            "stroke-width":2\n          }\n        );\n\n        entry.segments.set(\n          venueIndex,\n          rect\n        );\n\n        bindSegment(\n          rect,\n          entityIndex,\n          venueIndex\n        );\n      }\n\n      offset+=value;\n    });\n  });\n\n  highlight();\n\n  if(active&&!tip.hidden){\n    place(false);\n  }\n}\n\nfunction render(){\n  byId("rows").replaceChildren();\n  entries=new Map();\n\n  const start=page*pageSize;\n\n  const end=Math.min(\n    data.entities.length,\n    start+pageSize\n  );\n\n  for(\n    let entityIndex=start;\n    entityIndex<end;\n    entityIndex++\n  ){\n    const row=document.createElement("section");\n    const head=document.createElement("div");\n    const name=document.createElement("button");\n    const total=document.createElement("span");\n    const svg=document.createElementNS(ns,"svg");\n\n    row.className="bar-row";\n    head.className="row-head";\n\n    name.type="button";\n    name.className="name";\n\n    text(\n      name,\n      "span",\n      String(entityIndex+1).padStart(2,"0"),\n      "rank"\n    );\n\n    text(\n      name,\n      "span",\n      data.entities[entityIndex],\n      "entity-name"\n    );\n\n    name.addEventListener("click",()=>{\n      barDetails(entityIndex,null,true);\n    });\n\n    total.className="row-total";\n    total.textContent=money(\n      totals.get(data.entities[entityIndex])||0\n    );\n\n    head.append(name,total);\n\n    svg.classList.add("bar");\n    svg.setAttribute("role","group");\n\n    svg.setAttribute(\n      "aria-label",\n      data.entities[entityIndex]+" prize by venue"\n    );\n\n    row.append(head,svg);\n    byId("rows").appendChild(row);\n\n    entries.set(\n      entityIndex,\n      {\n        svg:svg,\n        segments:new Map()\n      }\n    );\n  }\n\n  const pages=Math.max(\n    1,\n    Math.ceil(data.entities.length/pageSize)\n  );\n\n  byId("page").textContent=\n    (page+1)+" / "+pages;\n\n  byId("range").textContent=\n    "Showing "+(start+1)+"–"+end+\n    " of "+data.entities.length+\n    "  ·  Same prize scale across views";\n\n  ["previous","previousBottom"].forEach(id=>{\n    byId(id).disabled=page===0;\n  });\n\n  ["next","nextBottom"].forEach(id=>{\n    byId(id).disabled=page>=pages-1;\n  });\n\n  paint();\n}\n\nfunction move(amount){\n  hide();\n\n  page=Math.max(\n    0,\n    Math.min(\n      Math.ceil(data.entities.length/pageSize)-1,\n      page+amount\n    )\n  );\n\n  render();\n  window.scrollTo({top:0});\n}\n\n["previous","previousBottom"].forEach(id=>{\n  byId(id).addEventListener("click",()=>{\n    move(-1);\n  });\n});\n\n["next","nextBottom"].forEach(id=>{\n  byId(id).addEventListener("click",()=>{\n    move(1);\n  });\n});\n\nbyId("pageSize").addEventListener("change",event=>{\n  hide();\n  pageSize=Number(event.target.value);\n  page=0;\n  render();\n});\n\n[\n  "about",\n  "quality",\n  "kpiTotal",\n  "kpiRecords",\n  "kpiNames",\n  "kpiVenues"\n].forEach(id=>{\n  const item=byId(id);\n\n  item.addEventListener("click",()=>{\n    about(id,true);\n  });\n\n  item.addEventListener("pointerenter",event=>{\n    if(\n      event.pointerType==="mouse"&&\n      !pinned\n    ){\n      about(id,false);\n    }\n  });\n\n  item.addEventListener(\n    "pointerleave",\n    laterHide\n  );\n});\n\ntip.addEventListener("pointerenter",()=>{\n  clearTimeout(hideTimer);\n});\n\ntip.addEventListener(\n  "pointerleave",\n  laterHide\n);\n\ndocument.addEventListener("pointerdown",event=>{\n  if(\n    !tip.hidden&&\n    !tip.contains(event.target)&&\n    !event.target.closest(\n      ".bar-row,.metric,#about,#quality"\n    )\n  ){\n    hide();\n  }\n});\n\ndocument.addEventListener("keydown",event=>{\n  if(event.key==="Escape"){\n    hide();\n  }\n});\n\nlet resizeTimer;\n\nwindow.addEventListener("resize",()=>{\n  clearTimeout(resizeTimer);\n  resizeTimer=setTimeout(paint,100);\n});\n\nrender();\n</script>\n</body>\n</html>'
    components.html(html.replace('__MPD_DATA__', payload, 1), height=880, scrolling=True)

# HORSE_CHECKLIST_LEFT_MENU_V1
def _hcm_select_page(state_key, page):
    st.session_state[state_key] = page

def _hcm_menu(label, options, index=0, format_func=str, key=None, *, disabled=False, **kwargs):
    pages = list(options)
    if not pages:
        return None
    state_key = key or 'app_navigation_page'
    default_index = 0 if index is None else int(index)
    if not 0 <= default_index < len(pages):
        default_index = 0
    active = st.session_state.get(state_key, pages[default_index])
    if active not in pages:
        active = pages[default_index]
    st.session_state[state_key] = active
    css = '\n    <style>\n    .st-key-hc_left_menu {\n        gap: 0.3rem !important;\n    }\n\n    .st-key-hc_left_menu button {\n        width: 100% !important;\n        min-height: 44px !important;\n        justify-content: flex-start !important;\n        text-align: left !important;\n        padding: 0.65rem 0.85rem !important;\n        border-radius: 10px !important;\n        box-shadow: none;\n        transition:\n            background-color 120ms ease,\n            border-color 120ms ease;\n    }\n\n    .st-key-hc_left_menu button p {\n        width: 100%;\n        margin: 0;\n        text-align: left !important;\n        font-size: 0.875rem !important;\n        font-weight: 500 !important;\n        line-height: 1.35 !important;\n        color: inherit !important;\n        overflow-wrap: anywhere;\n    }\n\n    .st-key-hc_left_menu button[kind="secondary"],\n    .st-key-hc_left_menu button[data-testid="stBaseButton-secondary"] {\n        background: transparent !important;\n        border: 1px solid transparent !important;\n        color: inherit !important;\n    }\n\n    .st-key-hc_left_menu button[kind="secondary"]:hover:not(:disabled),\n    .st-key-hc_left_menu button[data-testid="stBaseButton-secondary"]:hover:not(:disabled) {\n        background: rgba(128, 145, 172, 0.12) !important;\n        border-color: rgba(128, 145, 172, 0.2) !important;\n    }\n\n    .st-key-hc_left_menu button[kind="primary"],\n    .st-key-hc_left_menu button[data-testid="stBaseButton-primary"] {\n        background: linear-gradient(\n            110deg,\n            #234d8b,\n            #1d3c6b\n        ) !important;\n        border: 1px solid #4774b4 !important;\n        color: #f5f8ff !important;\n        box-shadow: inset 3px 0 0 #a7c7ff !important;\n    }\n\n    .st-key-hc_left_menu button[kind="primary"] p,\n    .st-key-hc_left_menu button[data-testid="stBaseButton-primary"] p {\n        font-weight: 650 !important;\n    }\n\n    .st-key-hc_left_menu button:focus-visible {\n        outline: 2px solid #7daaff !important;\n        outline-offset: 2px !important;\n    }\n\n    .st-key-hc_left_menu button:disabled {\n        opacity: 0.45;\n    }\n\n    @media (prefers-reduced-motion: reduce) {\n        .st-key-hc_left_menu button {\n            transition: none !important;\n        }\n    }\n    </style>\n    '
    formatter = format_func or str
    with st.sidebar.container():
        st.markdown(css, unsafe_allow_html=True)
        with st.container(key='hc_left_menu'):
            for position, page in enumerate(pages):
                st.button(str(formatter(page)), key=f'hc_menu_{state_key}_{position}', type='primary' if page == active else 'secondary', disabled=disabled, width='stretch', on_click=_hcm_select_page, args=(state_key, page))
    return active

def main():
    _review_was_logged_in = bool(st.session_state.get('logged_in', False))
    st.session_state.setdefault('app_navigation_page', 'Checklist Review')
    init_db()
    _persistent_login_bootstrap()
    if not _review_was_logged_in and st.session_state.get('logged_in', False):
        st.session_state['app_navigation_page'] = 'Checklist Review'
    if 'logged_in' not in st.session_state:
        st.session_state.logged_in = False
    if not st.session_state.logged_in:
        render_login_page()
        return
    st.sidebar.title('Horse Checklist App')
    st.sidebar.write(f'Logged in as: {st.session_state.display_name}')
    page = _hcm_menu('Menu', ['Checklist Review', 'Monthly Jockey Prize', 'Monthly Horse Owner Prize', 'Monthly Trainer Prize', 'Race Checklist', 'Account Settings', 'Horses', 'Horse Owners', 'Jockeys', 'Trainers', 'Breeding Farms', 'Stallions', 'Venues', 'Race Names', 'Criteria', 'Race Templates', 'Race Classes', 'Race Blog', 'Prize a Month — Stallions', 'Prize a Month — Breeding Farms', 'Prize a Month — Checklist Criteria'], key='app_navigation_page')
    if st.sidebar.button('Logout'):
        _persistent_login_logout()
        st.rerun()
    if page in {'Prize a Month — Stallions': 'stallion', 'Prize a Month — Breeding Farms': 'breedingfarm', 'Prize a Month — Checklist Criteria': 'criteria'}:
        _mpx_page({'Prize a Month — Stallions': 'stallion', 'Prize a Month — Breeding Farms': 'breedingfarm', 'Prize a Month — Checklist Criteria': 'criteria'}[page])
        return
    if page == 'Monthly Trainer Prize':
        _mc_page('trainer')
        return
    if page == 'Monthly Jockey Prize':
        _mc_page('jockey')
        return
    if page == 'Monthly Horse Owner Prize':
        _mc_page('owner')
        return
    if page == 'Race Templates':
        _rf_templates_page(st.session_state.user_id)
        return
    if page == 'Race Classes':
        _rf_classes_page(st.session_state.user_id)
        return
    if page == 'Race Blog':
        _rf_blog_page(st.session_state.user_id)
        return
    if page == 'Race Checklist':
        render_race_checklist_page()
    elif page == 'Checklist Review':
        render_checklist_review_page()
    elif page == 'Account Settings':
        render_account_settings_page()
    elif page == 'Horses':
        render_template_page('horse', 'Horses', 'Horse Name')
    elif page == 'Horse Owners':
        render_template_page('horse_owner', 'Horse Owners', 'Horse Owner Name')
    elif page == 'Jockeys':
        render_template_page('jockey', 'Jockeys', 'Jockey Name')
    elif page == 'Trainers':
        render_template_page('trainer', 'Trainers', 'Trainer Name')
    elif page == 'Breeding Farms':
        render_template_page('breeding_farm', 'Breeding Farms', 'Breeding Farm Name')
    elif page == 'Stallions':
        render_template_page('stallion', 'Stallions', 'Stallion Name')
    elif page == 'Venues':
        render_template_page('venue', 'Venues', 'Venue Name')
    elif page == 'Race Names':
        render_template_page('race_name', 'Race Names', 'Race Name')
    elif page == 'Criteria':
        render_template_page('criteria', 'Criteria', 'Criteria Name')









if __name__ == "__main__":
    main()

