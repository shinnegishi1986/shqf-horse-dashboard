# Checklist editor
# -------------------------------------------------
# REVIEW_UPDATE_FILTER_AND_WEIGHT_PROTECTION_V1
def _review_filter_restore_key(owner_id):
    return f"review_pending_filter_restore_{owner_id}"


def _capture_review_update_filter_state(owner_id):
    from copy import deepcopy

    prefixes = (
        f"saved_filter_{owner_id}_",
        f"second_filter_{owner_id}_",
    )

    return {
        key: deepcopy(value)
        for key, value in st.session_state.items()
        if isinstance(key, str) and key.startswith(prefixes)
    }


# REVIEW_PROTECTED_WIDGET_STATE_FIX_V1
def _review_is_protected_filter_widget(key, owner_id):
    if not isinstance(key, str):
        return False

    # Explicitly covers the uploader identified in the reported error.
    protected_keys = {
        f"saved_filter_{owner_id}_backup_import_file",
        f"second_filter_{owner_id}_backup_import_file",
    }

    protected_keys.update([
        'batch_checklist_file',
        'import_uploaded_file_button',
        f'review_filter_history_clear_{owner_id}',
        f'review_filter_history_next_{owner_id}',
        f'review_filter_history_previous_{owner_id}',
        saved_filter_key(owner_id, 'backup_import_button'),
        saved_filter_key(owner_id, 'backup_import_file'),
        saved_filter_key(owner_id, 'delete_button'),
        saved_filter_key(owner_id, 'load_button'),
        saved_filter_key(owner_id, 'reset_button'),
        saved_filter_key(owner_id, 'save_button'),
        second_filter_key(owner_id, 'reset_button')
    ])

    return key in protected_keys

def _queue_review_update_filter_restore(owner_id, snapshot):
    from copy import deepcopy
    if not _review_is_protected_filter_widget(_review_filter_restore_key(owner_id), owner_id):
        st.session_state[_review_filter_restore_key(owner_id)] = deepcopy(snapshot)



def _restore_review_update_filter_state(owner_id):
    snapshot = st.session_state.pop(_review_filter_restore_key(owner_id), None)
    if not isinstance(snapshot, dict):
        return
    prefixes = (f'saved_filter_{owner_id}_', f'second_filter_{owner_id}_')
    for key, value in snapshot.items():
        if isinstance(key, str) and key.startswith(prefixes):
            if not _review_is_protected_filter_widget(key, owner_id):
                st.session_state[key] = value



def _review_editor_weight_value(
    entered_weight,
    existing_weight,
    clear_weight,
):
    if clear_weight:
        return None

    parsed_weight = to_optional_float(entered_weight)

    if parsed_weight is not None:
        return parsed_weight

    # Preserve the stored value rather than turning an empty editor value
    # into a destructive update.
    return existing_weight

def render_checklist_editor(entry, owner_id, horses, horse_owners, jockeys, trainers, breeding_farms, stallions, venues, race_names, criteria):
    _crf_require_native()
    _cru_prepare(owner_id, entry['id'], [_crf_key(owner_id, entry['id'], 'breeding_farm_id'), _crf_key(owner_id, entry['id'], 'broodmare_sire_id'), _crf_key(owner_id, entry['id'], 'horse_id'), _crf_key(owner_id, entry['id'], 'horse_owner_id'), _crf_key(owner_id, entry['id'], 'jockey_id'), _crf_key(owner_id, entry['id'], 'previous_jockey_id'), _crf_key(owner_id, entry['id'], 'previous_venue_id'), _crf_key(owner_id, entry['id'], 'race_class_id'), _crf_key(owner_id, entry['id'], 'race_name_id'), _crf_key(owner_id, entry['id'], 'stallion_id'), _crf_key(owner_id, entry['id'], 'trainer_id'), _crf_key(owner_id, entry['id'], 'venue_id')])
    st.subheader(f"Edit Checklist #{entry['id']}")
    horse_options, horse_ids = make_options(horses, 'horse_name')
    horse_owner_options, horse_owner_ids = make_options(horse_owners, 'horse_owner_name')
    jockey_options, jockey_ids = make_options(jockeys, 'jockey_name')
    trainer_options, trainer_ids = make_options(trainers, 'trainer_name')
    breeding_farm_options, breeding_farm_ids = make_options(breeding_farms, 'breeding_farm_name')
    stallion_options, stallion_ids = make_options(stallions, 'stallion_name')
    venue_options, venue_ids = make_options(venues, 'venue_name')
    race_options, race_ids = make_options(race_names, 'race_name')

    def selected_index(ids, entry_id):
        return ids.index(entry_id) if entry_id in ids else 0
    existing_date = parse_race_date(entry.get('date_of_race')) or date.today()
    existing_previous_race_date = parse_race_date(entry.get('previous_race_date'))
    _rf_venue_editor_loader(owner_id, entry)
    with st.form(f"edit_checklist_form_{entry['id']}"):
        edit_horse_idx, cru_new_horse_id = _crf_reference('Horse', owner_id, entry['id'], 'horse_id', horse_options, horse_ids, entry.get('horse_id'))
        edit_horse_owner_idx, cru_new_horse_owner_id = _crf_reference('Horse Owner', owner_id, entry['id'], 'horse_owner_id', horse_owner_options, horse_owner_ids, entry.get('horse_owner_id'))
        edit_jockey_idx, cru_new_jockey_id = _crf_reference('Jockey', owner_id, entry['id'], 'jockey_id', jockey_options, jockey_ids, entry.get('jockey_id'))
        edit_previous_jockey_idx, cru_new_previous_jockey_id = _crf_reference('Previous Jockey', owner_id, entry['id'], 'previous_jockey_id', jockey_options, jockey_ids, entry.get('previous_jockey_id'))
        edit_trainer_idx, cru_new_trainer_id = _crf_reference('Trainer', owner_id, entry['id'], 'trainer_id', trainer_options, trainer_ids, entry.get('trainer_id'))
        edit_breeding_farm_idx, cru_new_breeding_farm_id = _crf_reference('Breeding Farm', owner_id, entry['id'], 'breeding_farm_id', breeding_farm_options, breeding_farm_ids, entry.get('breeding_farm_id'))
        edit_stallion_idx, cru_new_stallion_id = _crf_reference('Stallion', owner_id, entry['id'], 'stallion_id', stallion_options, stallion_ids, entry.get('stallion_id'))
        edit_broodmare_sire_idx, cru_new_broodmare_sire_id = _crf_reference('Broodmare Sire', owner_id, entry['id'], 'broodmare_sire_id', stallion_options, stallion_ids, entry.get('broodmare_sire_id'))
        edit_venue_idx, cru_new_venue_id = _crf_reference('Venue', owner_id, entry['id'], 'venue_id', venue_options, venue_ids, entry.get('venue_id'))
        edit_previous_venue_idx, cru_new_previous_venue_id = _crf_reference('Previous Venue', owner_id, entry['id'], 'previous_venue_id', venue_options, venue_ids, entry.get('previous_venue_id'))
        edit_race_idx, cru_new_race_name_id = _crf_reference('Race Name', owner_id, entry['id'], 'race_name_id', race_options, race_ids, entry.get('race_name_id'))
        rf_editor_class_id, cru_new_race_class_id = _crf_class(owner_id, entry)
        edit_distance = _rf_venue_editor_widget(st.number_input, 'Distance (meters)', min_value=0, max_value=5000, value=int(entry.get('distance') or 0), step=100, key=_rf_venue_editor_key(owner_id, entry['id'], 'edit_distance'))
        edit_previous_distance = st.number_input('Previous Distance (meters)', min_value=0, max_value=5000, value=int(entry.get('previous_distance') or 0), step=100)
        edit_date = _rf_venue_editor_widget(st.date_input, 'Date of Race', value=existing_date, key=_rf_venue_editor_key(owner_id, entry['id'], 'edit_date'))
        edit_previous_race_date = st.date_input('Previous Race Date (optional)', min_value=date(1980, 1, 1), max_value=edit_date, value=existing_previous_race_date)
        edit_interval_days_preview = calculate_interval_days(edit_date, edit_previous_race_date)
        if edit_interval_days_preview is None:
            st.caption('Days Since Last Race: Enter a previous race date to calculate.')
        else:
            st.info(f'Days Since Last Race: {edit_interval_days_preview} day(s)')
        edit_weight_change = st.number_input('Weight Change (kg) (optional)', min_value=-999.9, max_value=999.9, value=float(entry.get('weight_change') or 0.0), step=0.1, help='Enter a negative value for weight loss. For weight gain, enter the number without a + sign.')
        edit_memo = st.text_area('Memo', value=entry.get('memo') or '')
        edit_finished_place = st.text_input('Finished Place', value=entry.get('finished_place') or '')
        col1, col2 = st.columns(2)
        with col1:
            edit_program_number = _rf_venue_editor_widget(st.number_input, 'Program Number (レース番号)', min_value=0, max_value=12, value=int(entry.get('program_number') or 0), key=_rf_venue_editor_key(owner_id, entry['id'], 'edit_program_number'))
            edit_number_of_horses = _rf_venue_editor_widget(st.number_input, 'Number of Horses (出走頭数)', min_value=0, max_value=18, value=int(entry.get('number_of_horses') or 0), key=_rf_venue_editor_key(owner_id, entry['id'], 'edit_number_of_horses'))
            edit_odds = st.number_input('Odds', min_value=0.0, max_value=999.9, value=float(entry.get('odds') or 0.0), step=0.1)
            edit_prize = st.number_input('Prize (¥)', min_value=0.0, max_value=1000000000.0, value=float(entry.get('prize') or 0.0), step=1000.0)
        with col2:
            edit_bracket_number = st.number_input('Bracket Number (枠番)', min_value=0, max_value=8, value=int(entry.get('bracket_number') or 0))
            edit_horse_number = st.number_input('Horse Number (馬番)', min_value=0, max_value=18, value=int(entry.get('horse_number') or 0))
            edit_horse_weight = st.number_input('Horse Weight (kg)', min_value=0.0, max_value=999.9, value=float(entry.get('horse_weight') or 0.0), step=0.1)
            clear_stored_horse_weight = st.checkbox('Clear stored horse weight', value=False, key=f"review_clear_horse_weight_{owner_id}_{entry['id']}", help='Leave unchecked to preserve the stored weight when the weight input is empty or zero.')
        st.write('Checklist criteria:')
        edit_checklist_data = {}
        existing_checklist_data = entry.get('checklist') or {}
        for criterion in criteria:
            criterion_name = criterion['criteria_name']
            edit_checklist_data[criterion_name] = st.checkbox(criterion_name, value=bool(existing_checklist_data.get(criterion_name, False)))
        update_clicked = st.form_submit_button('Update Checklist')
    delete_clicked = st.button('Delete This Checklist', key=f"delete_checklist_{entry['id']}", type='secondary')
    if update_clicked:
        normalized_edit_date = normalize_date(edit_date)
        normalized_edit_previous_race_date = normalize_date(edit_previous_race_date)
        if normalized_edit_previous_race_date and calculate_interval_days(normalized_edit_date, normalized_edit_previous_race_date) is None:
            st.error('Previous race date cannot be after the current race date.')
            return
        _review_update_filter_snapshot = _capture_review_update_filter_state(owner_id)
        success, message = update_checklist(checklist_id=entry['id'], owner_id=owner_id, horse_id=get_selected_id(horse_ids, edit_horse_idx), horse_owner_id=get_selected_id(horse_owner_ids, edit_horse_owner_idx), jockey_id=get_selected_id(jockey_ids, edit_jockey_idx), previous_jockey_id=get_selected_id(jockey_ids, edit_previous_jockey_idx), trainer_id=get_selected_id(trainer_ids, edit_trainer_idx), breeding_farm_id=get_selected_id(breeding_farm_ids, edit_breeding_farm_idx), stallion_id=get_selected_id(stallion_ids, edit_stallion_idx), broodmare_sire_id=get_selected_id(stallion_ids, edit_broodmare_sire_idx), venue_id=get_selected_id(venue_ids, edit_venue_idx), previous_venue_id=get_selected_id(venue_ids, edit_previous_venue_idx), race_name_id=get_selected_id(race_ids, edit_race_idx), distance=to_optional_int(edit_distance), previous_distance=to_optional_int(edit_previous_distance), date_of_race=normalized_edit_date, previous_race_date=normalized_edit_previous_race_date, weight_change=to_optional_signed_float(edit_weight_change), memo=clean_text(edit_memo), finished_place=clean_text(edit_finished_place), program_number=to_optional_int(edit_program_number), number_of_horses=to_optional_int(edit_number_of_horses), odds=to_optional_float(edit_odds), prize=to_optional_float(edit_prize), checklist_data=edit_checklist_data if any(edit_checklist_data.values()) else None, bracket_number=to_optional_int(edit_bracket_number), horse_number=to_optional_int(edit_horse_number), horse_weight=_review_editor_weight_value(edit_horse_weight, entry.get('horse_weight'), clear_stored_horse_weight), race_class_id=rf_editor_class_id, _review_new_references={'horse_id': cru_new_horse_id, 'horse_owner_id': cru_new_horse_owner_id, 'jockey_id': cru_new_jockey_id, 'previous_jockey_id': cru_new_previous_jockey_id, 'trainer_id': cru_new_trainer_id, 'breeding_farm_id': cru_new_breeding_farm_id, 'stallion_id': cru_new_stallion_id, 'broodmare_sire_id': cru_new_broodmare_sire_id, 'venue_id': cru_new_venue_id, 'previous_venue_id': cru_new_previous_venue_id, 'race_name_id': cru_new_race_name_id, 'race_class_id': cru_new_race_class_id})
        if success:
            st.success(message)
            _queue_review_update_filter_restore(owner_id, _review_update_filter_snapshot)
            _cru_mark_clear(owner_id, entry['id'])
            st.rerun()
        else:
            st.error(message)
    if delete_clicked:
        success, message = delete_checklist(entry['id'], owner_id)
        if success:
            st.success(message)
            st.session_state.pop('selected_review_checklist_id', None)
            st.rerun()
        else:
            st.error(message)







# -------------------------------------------------
# Second Filter UI
# -------------------------------------------------
# REVIEW_STABLE_NUMERIC_FILTER_VALUES_V1
def _review_numeric_filter_cache(owner_id):
    key = f"review_numeric_filter_cache_v1_{owner_id}"

    cache = st.session_state.get(key)

    if not isinstance(cache, dict):
        cache = {}
        st.session_state[key] = cache

    return cache


def _review_numeric_filter_identity(owner_id, widget_key):
    if not isinstance(widget_key, str):
        return None

    for prefix in (
        f"saved_filter_{owner_id}_",
        f"second_filter_{owner_id}_",
    ):
        if widget_key.startswith(prefix):
            return prefix, widget_key[len(prefix):]

    return None


def _review_repair_collapsed_numeric_filters(owner_id):
    defaults = get_filter_defaults()
    cache = _review_numeric_filter_cache(owner_id)

    collapsed_minimums = {
        "distance_to": 0,
        "previous_distance_to": 0,
        "interval_days_to": 0,
        "weight_change_to": -999.9,
        "odds_to": 0.0,
        "prize_to": 0.0,
        "bracket_to": 1,
        "horse_to": 1,
        "weight_to": 0.0,
    }

    optional_switches = (
        "enable_distance_filter",
        "enable_previous_distance_filter",
        "enable_interval_days_filter",
        "enable_weight_change_filter",
        "enable_bracket_filter",
        "enable_horse_filter",
        "enable_weight_filter",
    )

    repaired = []

    for prefix, title in (
        (f"saved_filter_{owner_id}_", "First Filter"),
        (f"second_filter_{owner_id}_", "Second Filter"),
    ):
        # Do not reinterpret a set of enabled optional numeric filters.
        if any(
            bool(st.session_state.get(prefix + field, False))
            for field in optional_switches
        ):
            continue

        collapsed = [
            field
            for field, minimum in collapsed_minimums.items()
            if (
                field in defaults
                and prefix + field in st.session_state
                and st.session_state[prefix + field] == minimum
                and defaults[field] != minimum
            )
        ]

        # This targets the multi-field failure in the supplied diagnostic,
        # rather than treating any legitimate zero upper bound as a bug.
        if len(collapsed) < 7:
            continue

        for field in collapsed:
            key = prefix + field
            value = defaults[field]

            st.session_state[key] = value
            cache[key] = value

        repaired.append(
            title + ": " + ", ".join(collapsed)
        )

    if repaired:
        st.session_state[
            f"review_numeric_filter_repair_notice_{owner_id}"
        ] = repaired


def _review_show_numeric_filter_repair_notice(owner_id):
    repaired = st.session_state.pop(
        f"review_numeric_filter_repair_notice_{owner_id}",
        [],
    )

    if repaired:
        st.info(
            "Recovered numeric filter upper bounds that had all fallen "
            "back to their minimum values. Other filter choices were "
            "preserved. Check Current Review Filters to confirm the ranges."
        )

        for message in repaired:
            st.caption(message)


def _review_stable_numeric_filter_input(
    widget_function,
    owner_id,
    *args,
    **kwargs,
):
    widget_key = kwargs.get("key")
    identity = _review_numeric_filter_identity(owner_id, widget_key)

    if identity is None:
        return widget_function(*args, **kwargs)

    _, field = identity
    defaults = get_filter_defaults()

    if field not in defaults:
        return widget_function(*args, **kwargs)

    default = defaults[field]

    # Leave nonnumeric fields and boolean switches to their own widgets.
    if isinstance(default, bool) or not isinstance(default, (int, float)):
        return widget_function(*args, **kwargs)

    cache = _review_numeric_filter_cache(owner_id)

    if widget_key not in st.session_state:
        # Recover a previously rendered value when a conditional widget's
        # own key has disappeared. Otherwise use the app's real default,
        # not the number input's minimum.
        value = cache.get(widget_key, default)

        if value is None:
            value = default

        st.session_state[widget_key] = value

    # Session State is the single source of the initial widget value.
    # Existing number inputs in this app use keyword arguments for value.
    kwargs["value"] = None

    result = widget_function(*args, **kwargs)

    # A filter number input is not intended to remain blank.
    # Keep a usable fallback in the independent cache without mutating
    # the widget's Session State after it has been instantiated.
    if result is not None:
        cache[widget_key] = result
        return result

    fallback = cache.get(widget_key, default)

    if fallback is None:
        fallback = default

    cache[widget_key] = fallback
    return fallback

def render_second_filter_section(owner_id, first_filtered_checklists, horse_ids, horse_options, horse_owner_ids, horse_owner_options, jockey_ids, jockey_options, trainer_ids, trainer_options, breeding_farm_ids, breeding_farm_options, stallion_ids, stallion_options, venue_ids, venue_options, race_ids, race_options, criteria):
    st.subheader('Second Filter')
    st.caption('The second filter calculates dominance within the first-filter results. It does not change the first-filter results list.')
    enable_second_filter = st.checkbox('Enable Second Filter', key=second_filter_key(owner_id, 'enabled'))
    if not enable_second_filter:
        return (None, False)
    clear_second_col1, clear_second_col2 = st.columns([3, 1])
    with clear_second_col1:
        st.caption('All conditions below are used only to calculate second-filter dominance within the first-filter results.')
    with clear_second_col2:
        if st.button('Clear Second Filter', key=second_filter_key(owner_id, 'reset_button'), type='secondary', width='stretch'):
            reset_second_filter_values(owner_id)
            st.session_state[second_filter_load_version_key(owner_id)] += 1
            st.rerun()
    left_col, right_col = st.columns(2)
    with left_col:
        selected_horse_id = render_second_filter_selectbox('Second Filter by Horse', owner_id, 'horse_id', horse_ids, horse_options)
        selected_horse_owner_id = render_second_filter_selectbox('Second Filter by Horse Owner', owner_id, 'horse_owner_id', horse_owner_ids, horse_owner_options)
        selected_jockey_id = render_second_filter_selectbox('Second Filter by Jockey', owner_id, 'jockey_id', jockey_ids, jockey_options)
        selected_previous_jockey_id = render_second_filter_selectbox('Second Filter by Previous Jockey', owner_id, 'previous_jockey_id', jockey_ids, jockey_options)
        selected_trainer_id = render_second_filter_selectbox('Second Filter by Trainer', owner_id, 'trainer_id', trainer_ids, trainer_options)
        selected_breeding_farm_id = render_second_filter_selectbox('Second Filter by Breeding Farm', owner_id, 'breeding_farm_id', breeding_farm_ids, breeding_farm_options)
        selected_stallion_id = render_second_filter_selectbox('Second Filter by Stallion', owner_id, 'stallion_id', stallion_ids, stallion_options)
        selected_broodmare_sire_id = render_second_filter_selectbox('Second Filter by Broodmare Sire', owner_id, 'broodmare_sire_id', stallion_ids, stallion_options)
        second_selected_venue_ids = st.multiselect('Second Filter by Venues', venue_ids[1:], format_func=lambda venue_id: venue_options[venue_ids.index(venue_id)], key=second_filter_key(owner_id, 'venue_ids'))
        selected_previous_venue_id = render_second_filter_selectbox('Second Filter by Previous Venue', owner_id, 'previous_venue_id', venue_ids, venue_options)
        selected_race_name_id = render_second_filter_selectbox('Second Filter by Race Name', owner_id, 'race_name_id', race_ids, race_options)
        rf_second_class_id = render_second_filter_selectbox('Second Filter by Race Class', owner_id, 'race_class_id', *_rf_class_options(owner_id))
        second_filter_memo_keyword = st.text_input('Second Filter memo or text contains keyword', key=second_filter_key(owner_id, 'memo_keyword'))
        second_filter_program_number = _review_stable_numeric_filter_input(st.number_input, owner_id, 'Second Filter by Program Number', min_value=0, max_value=12, step=1, help='0 = all', key=second_filter_key(owner_id, 'program_number'))
        second_filter_number_of_horses = _review_stable_numeric_filter_input(st.number_input, owner_id, 'Second Filter by Number of Horses', min_value=0, max_value=18, step=1, help='0 = all', key=second_filter_key(owner_id, 'number_of_horses'))
        second_filter_odds_from = _review_stable_numeric_filter_input(st.number_input, owner_id, 'Second Filter From Odds', min_value=0.0, max_value=999.9, step=0.1, key=second_filter_key(owner_id, 'odds_from'))
        second_filter_odds_to = _review_stable_numeric_filter_input(st.number_input, owner_id, 'Second Filter To Odds', min_value=0.0, max_value=999.9, step=0.1, key=second_filter_key(owner_id, 'odds_to'))
        second_filter_prize_from = _review_stable_numeric_filter_input(st.number_input, owner_id, 'Second Filter From Prize (¥)', min_value=0.0, max_value=1000000000.0, step=1000.0, key=second_filter_key(owner_id, 'prize_from'))
        second_filter_prize_to = _review_stable_numeric_filter_input(st.number_input, owner_id, 'Second Filter To Prize (¥)', min_value=0.0, max_value=1000000000.0, step=1000.0, key=second_filter_key(owner_id, 'prize_to'))
    with right_col:
        second_filter_criteria = st.multiselect('Second Filter by Criteria', [criterion['criteria_name'] for criterion in criteria], key=second_filter_key(owner_id, 'criteria'))
        second_criteria_mode = st.radio('Second Filter criteria match mode', ['AND', 'OR', 'NOT matched by criteria'], horizontal=True, key=second_filter_key(owner_id, 'criteria_mode'))
        st.checkbox('Second Filter: Apply Distance Filter', key=second_filter_key(owner_id, 'enable_distance_filter'))
        second_filter_distance_from = _review_stable_numeric_filter_input(st.number_input, owner_id, 'Second Filter From Distance (meters)', min_value=0, max_value=5000, step=100, key=second_filter_key(owner_id, 'distance_from'), disabled=not st.session_state.get(second_filter_key(owner_id, 'enable_distance_filter'), False))
        second_filter_distance_to = _review_stable_numeric_filter_input(st.number_input, owner_id, 'Second Filter To Distance (meters)', min_value=0, max_value=5000, step=100, key=second_filter_key(owner_id, 'distance_to'), disabled=not st.session_state.get(second_filter_key(owner_id, 'enable_distance_filter'), False))
        st.checkbox('Second Filter: Apply Previous Distance Filter', key=second_filter_key(owner_id, 'enable_previous_distance_filter'))
        second_filter_previous_distance_from = _review_stable_numeric_filter_input(st.number_input, owner_id, 'Second Filter From Previous Distance (meters)', min_value=0, max_value=5000, step=100, key=second_filter_key(owner_id, 'previous_distance_from'), disabled=not st.session_state.get(second_filter_key(owner_id, 'enable_previous_distance_filter'), False))
        second_filter_previous_distance_to = _review_stable_numeric_filter_input(st.number_input, owner_id, 'Second Filter To Previous Distance (meters)', min_value=0, max_value=5000, step=100, key=second_filter_key(owner_id, 'previous_distance_to'), disabled=not st.session_state.get(second_filter_key(owner_id, 'enable_previous_distance_filter'), False))
        st.checkbox('Second Filter: Apply Days Since Last Race Filter', key=second_filter_key(owner_id, 'enable_interval_days_filter'))
        second_filter_interval_days_from = _review_stable_numeric_filter_input(st.number_input, owner_id, 'Second Filter From Days Since Last Race', min_value=0, max_value=9999, step=1, key=second_filter_key(owner_id, 'interval_days_from'), disabled=not st.session_state.get(second_filter_key(owner_id, 'enable_interval_days_filter'), False))
        second_filter_interval_days_to = _review_stable_numeric_filter_input(st.number_input, owner_id, 'Second Filter To Days Since Last Race', min_value=0, max_value=9999, step=1, key=second_filter_key(owner_id, 'interval_days_to'), disabled=not st.session_state.get(second_filter_key(owner_id, 'enable_interval_days_filter'), False))
        second_filter_enable_weight_change_filter = st.checkbox('Apply Second Weight Change Filter', key=second_filter_key(owner_id, 'enable_weight_change_filter'), help='Check to apply the From/To weight-change range. Unchecked means weight change is ignored.')
        second_filter_weight_change_from = _review_stable_numeric_filter_input(st.number_input, owner_id, 'Second Filter From Weight Change (kg)', min_value=-999.9, max_value=999.9, step=0.1, key=second_filter_key(owner_id, 'weight_change_from'), disabled=not second_filter_enable_weight_change_filter)
        second_filter_weight_change_to = _review_stable_numeric_filter_input(st.number_input, owner_id, 'Second Filter To Weight Change (kg)', min_value=-999.9, max_value=999.9, step=0.1, key=second_filter_key(owner_id, 'weight_change_to'), disabled=not second_filter_enable_weight_change_filter)
        second_filter_date_from = st.date_input('Second Filter From Date', key=second_filter_key(owner_id, 'date_from'))
        second_filter_date_to = st.date_input('Second Filter To Date', key=second_filter_key(owner_id, 'date_to'))
        second_filter_places = st.multiselect('Second Filter by Finished Place (着順)', [str(i) for i in range(1, 19)], help='Example: Select 1, 2, 3 for top-three results.', key=second_filter_key(owner_id, 'places'))
        second_exclude_finished_places = st.multiselect('Second Filter Exclude Finished Place (着順)', [str(i) for i in range(1, 19)], help='Example: Select 1, 2, 3 to exclude first-, second-, and third-place results.', key=second_filter_key(owner_id, 'exclude_places'))
        second_enable_bracket_filter = st.checkbox('Enable Second Filter Bracket Number', key=second_filter_key(owner_id, 'enable_bracket_filter'))
        second_filter_bracket_from = _review_stable_numeric_filter_input(st.number_input, owner_id, 'Second Filter From Bracket Number (枠番)', min_value=1, max_value=8, step=1, key=second_filter_key(owner_id, 'bracket_from'))
        second_filter_bracket_to = _review_stable_numeric_filter_input(st.number_input, owner_id, 'Second Filter To Bracket Number (枠番)', min_value=1, max_value=8, step=1, key=second_filter_key(owner_id, 'bracket_to'))
        second_enable_horse_filter = st.checkbox('Enable Second Filter Horse Number', key=second_filter_key(owner_id, 'enable_horse_filter'))
        second_filter_horse_from = _review_stable_numeric_filter_input(st.number_input, owner_id, 'Second Filter From Horse Number (馬番)', min_value=1, max_value=18, step=1, key=second_filter_key(owner_id, 'horse_from'))
        second_filter_horse_to = _review_stable_numeric_filter_input(st.number_input, owner_id, 'Second Filter To Horse Number (馬番)', min_value=1, max_value=18, step=1, key=second_filter_key(owner_id, 'horse_to'))
        second_enable_weight_filter = st.checkbox('Enable Second Filter Horse Weight', key=second_filter_key(owner_id, 'enable_weight_filter'))
        second_filter_weight_from = _review_stable_numeric_filter_input(st.number_input, owner_id, 'Second Filter From Horse Weight (kg)', min_value=0.0, max_value=999.9, step=0.1, key=second_filter_key(owner_id, 'weight_from'))
        second_filter_weight_to = _review_stable_numeric_filter_input(st.number_input, owner_id, 'Second Filter To Horse Weight (kg)', min_value=0.0, max_value=999.9, step=0.1, key=second_filter_key(owner_id, 'weight_to'))
    second_selected_filters = {'horse_id': selected_horse_id, 'horse_owner_id': selected_horse_owner_id, 'jockey_id': selected_jockey_id, 'previous_jockey_id': selected_previous_jockey_id, 'trainer_id': selected_trainer_id, 'breeding_farm_id': selected_breeding_farm_id, 'stallion_id': selected_stallion_id, 'broodmare_sire_id': selected_broodmare_sire_id, 'previous_venue_id': selected_previous_venue_id, 'race_name_id': selected_race_name_id, 'race_class_id': rf_second_class_id}
    second_filtered_checklists = filter_checklists(checklists=first_filtered_checklists, selected_filters=second_selected_filters, selected_venue_ids=second_selected_venue_ids, criteria_filters=second_filter_criteria, criteria_mode=second_criteria_mode, distance_from=second_filter_distance_from, distance_to=second_filter_distance_to, previous_distance_from=second_filter_previous_distance_from, previous_distance_to=second_filter_previous_distance_to, interval_days_from=second_filter_interval_days_from, interval_days_to=second_filter_interval_days_to, enable_weight_change_filter=second_filter_enable_weight_change_filter, weight_change_from=second_filter_weight_change_from, weight_change_to=second_filter_weight_change_to, date_from=second_filter_date_from, date_to=second_filter_date_to, memo_keyword=second_filter_memo_keyword, program_number=second_filter_program_number, number_of_horses=second_filter_number_of_horses, finished_places=second_filter_places, exclude_finished_places=second_exclude_finished_places, odds_from=second_filter_odds_from, odds_to=second_filter_odds_to, prize_from=second_filter_prize_from, prize_to=second_filter_prize_to, enable_bracket_filter=second_enable_bracket_filter, bracket_from=second_filter_bracket_from, bracket_to=second_filter_bracket_to, enable_horse_filter=second_enable_horse_filter, horse_from=second_filter_horse_from, horse_to=second_filter_horse_to, enable_weight_filter=second_enable_weight_filter, weight_from=second_filter_weight_from, weight_to=second_filter_weight_to, enable_distance_filter=st.session_state.get(second_filter_key(owner_id, 'enable_distance_filter'), False), enable_previous_distance_filter=st.session_state.get(second_filter_key(owner_id, 'enable_previous_distance_filter'), False), enable_interval_days_filter=st.session_state.get(second_filter_key(owner_id, 'enable_interval_days_filter'), False))
    return (second_filtered_checklists, True)





